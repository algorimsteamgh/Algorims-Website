---
// Consent bootstrap, Google tag (GA4 and Google Ads) and Meta Pixel, on every page.
// Each tag renders only when its ID is set at build time, so local and preview
// builds send nothing. Event helpers live in src/scripts/tracking.ts.
//
// Nothing optional runs before the visitor chooses (src/components/CookieConsent.astro):
// Google tags start under Consent Mode v2 with every storage type denied, and
// the Meta Pixel script is not fetched until marketing consent is given.
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const adsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
const gtagIds = [ga4Id, adsId].filter(Boolean) as string[];
---
<script is:inline>
  // Mirrors readConsent() in src/scripts/consent.ts: keep key, version and max age in sync.
  (function () {
    var s = null;
    try { s = JSON.parse(localStorage.getItem("algorims-consent") || "null"); } catch (e) {}
    window.algorimsConsent = s && s.v === 1 && Date.now() - s.ts < 31536e6 ? s : null;
  })();
</script>
{gtagIds.length > 0 && (
  <script is:inline define:vars={{ gtagIds }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    var consent = window.algorimsConsent || {};
    var analytics = consent.analytics ? "granted" : "denied";
    var marketing = consent.marketing ? "granted" : "denied";
    gtag("consent", "default", {
      analytics_storage: analytics,
      ad_storage: marketing,
      ad_user_data: marketing,
      ad_personalization: marketing,
      wait_for_update: 500,
    });
    gtag("set", "ads_data_redaction", true);
    gtag("js", new Date());
    // allow_enhanced_conversions lets the lead form pass a hashed phone number.
    gtagIds.forEach((id) => gtag("config", id, id.startsWith("AW-") ? { allow_enhanced_conversions: true } : {}));
  </script>
)}
{gtagIds.length > 0 && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagIds[0]}`}></script>}
{pixelId && (
  <script is:inline define:vars={{ pixelId }}>
    window.algorimsLoadPixel = function () {
      if (window.fbq) return;
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version="2.0";n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,"script","https://connect.facebook.net/en_US/fbevents.js");
      fbq("init", pixelId);
      fbq("track", "PageView");
    };
    if (window.algorimsConsent && window.algorimsConsent.marketing) window.algorimsLoadPixel();
  </script>
)}
