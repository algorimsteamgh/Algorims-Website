---
const { iconClass = "h-4 w-4" } = Astro.props;
---
<section class="cta">
  <div class="container-x">
    <div class="cta-card">
      <div class="cta-copy">
        <p class="cta-kicker">Ready when you are</p>
        <h2>Let's architect your <span>Agentic Enterprise.</span></h2>
        <p>Talk to our team about your AI, cloud, or platform engineering goals. We'll design a plan that scales with your business.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-hero btn-lg rounded-full">Book a consultation <i data-lucide="arrow-right" class={iconClass}></i></a>
        <a href="/services" class="btn btn-outline btn-lg rounded-full">Explore services</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding: 48px 0; }
  .cta-card { display: flex; align-items: center; justify-content: space-between; gap: 32px; max-width: 1112px; margin: 0 auto; padding: clamp(28px, 4vw, 44px) clamp(24px, 4vw, 48px); border: 1px solid hsl(var(--primary) / .12); border-radius: 1.5rem; background: radial-gradient(120% 140% at 100% 0%, hsl(var(--primary-glow) / .16), transparent 55%), linear-gradient(120deg, hsl(var(--primary) / .03), hsl(var(--primary) / .1)); }
  .cta-copy { max-width: 620px; }
  .cta-kicker { margin: 0 0 10px; color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .cta h2 { margin: 0; font-size: clamp(1.6rem, 2.6vw, 2.25rem); font-weight: 600; line-height: 1.12; letter-spacing: -.04em; text-wrap: balance; }
  .cta h2 span { color: hsl(var(--primary)); }
  .cta-copy > p:last-child { margin: 12px 0 0; color: hsl(var(--muted-foreground)); font-size: .95rem; line-height: 1.6; }
  .cta-actions { display: flex; flex: none; flex-wrap: wrap; gap: 10px; }

  @media (max-width: 860px) {
    .cta-card { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 600px) {
    .cta { padding: 32px 0; }
    .cta-card { border-radius: 1.25rem; }
    .cta-actions { width: 100%; }
    .cta-actions a { flex: 1 1 100%; justify-content: center; }
  }
</style>
