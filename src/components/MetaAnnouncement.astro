---
// Timed announcement toast: Algorims is now a Meta Tech Provider.
// Behaviour: appears after a short delay (so it doesn't fight first paint),
// auto-hides after ~10s with a visible countdown bar, pauses on hover/focus,
// is dismissible, and shows once per browser session. Skipped on /partners.
---
<aside id="meta-announce" class="meta-announce" role="complementary" aria-label="Announcement" hidden>
  <a class="ma-card" href="/partners#meta">
    <span class="ma-message"><strong>Algorims is now a Meta Tech Provider</strong><span>WhatsApp Business onboarding, messaging and templates</span></span>
    <span class="ma-cta">Explore our WhatsApp services <span aria-hidden="true">→</span></span>
    <span class="ma-timer" aria-hidden="true"></span>
  </a>
  <button type="button" class="ma-close" aria-label="Dismiss announcement">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
  </button>
</aside>

<style is:global>
  .meta-announce { position: fixed; z-index: 60; left: 16px; bottom: 16px; width: min(360px, calc(100vw - 32px)); opacity: 0; transform: translateY(16px) scale(.98); pointer-events: none; transition: opacity .4s ease, transform .4s cubic-bezier(.2,.8,.2,1); }
  .meta-announce[hidden] { display: none; }
  .meta-announce.is-open { opacity: 1; transform: none; pointer-events: auto; }
  .ma-card { position: relative; display: block; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--card)); box-shadow: 0 24px 60px -18px rgba(76, 29, 149, .35); }
  .ma-message { display: block; padding: 24px 20px 8px; }
  .ma-message strong { display: block; max-width: 270px; color: hsl(var(--foreground)); font-size: 1.35rem; line-height: 1.2; }
  .ma-message span { display: block; margin-top: 10px; color: hsl(var(--muted-foreground)); font-size: .9rem; line-height: 1.4; }
  .ma-cta { display: block; padding: 10px 14px 14px; color: hsl(var(--primary)); font-size: .82rem; font-weight: 600; line-height: 1.35; }
  .ma-card:hover .ma-cta { text-decoration: underline; text-underline-offset: 3px; }
  .ma-card:focus-visible, .ma-close:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 2px; }
  .ma-timer { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: hsl(var(--primary)); transform-origin: left; transform: scaleX(1); }
  .meta-announce.is-open .ma-timer { animation: ma-countdown var(--ma-duration, 10s) linear forwards; }
  .meta-announce.is-paused .ma-timer { animation-play-state: paused; }
  .ma-close { position: absolute; top: 8px; right: 8px; display: grid; place-items: center; width: 28px; height: 28px; border: 0; border-radius: 50%; background: rgba(255,255,255,.9); color: #1f1f2e; cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.18); }
  .ma-close:hover { background: #fff; }
  @keyframes ma-countdown { to { transform: scaleX(0); } }
  @media (max-width: 600px) { .meta-announce { left: 50%; width: min(260px, calc(100vw - 32px)); margin-left: min(-130px, calc(-50vw + 16px)); bottom: 12px; } }
  @media (prefers-reduced-motion: reduce) { .meta-announce { transition: opacity .2s ease; transform: none; } .meta-announce.is-open .ma-timer { animation: none; display: none; } }
</style>

<script>
  const KEY = "algorims-meta-announce-v1";
  const SHOW_AFTER = 3000;
  const VISIBLE_FOR = 10000;
  const el = document.getElementById("meta-announce");
  const seen = () => { try { return sessionStorage.getItem(KEY) === "1"; } catch { return false; } };
  const mark = () => { try { sessionStorage.setItem(KEY, "1"); } catch {} };

  if (el && !seen() && !location.pathname.startsWith("/partners")) {
    let hideTimer: number | undefined;
    let remaining = VISIBLE_FOR;
    let startedAt = 0;
    el.style.setProperty("--ma-duration", `${VISIBLE_FOR}ms`);

    const close = () => {
      window.clearTimeout(hideTimer);
      el.classList.remove("is-open");
      window.setTimeout(() => { el.hidden = true; window.dispatchEvent(new Event("meta-announce:closed")); }, 450);
    };
    const run = () => { startedAt = Date.now(); hideTimer = window.setTimeout(close, remaining); el.classList.remove("is-paused"); };
    const pause = () => { window.clearTimeout(hideTimer); remaining -= Date.now() - startedAt; el.classList.add("is-paused"); };

    window.setTimeout(() => {
      el.hidden = false;
      requestAnimationFrame(() => { el.classList.add("is-open"); run(); });
      mark();
    }, SHOW_AFTER);

    el.addEventListener("mouseenter", pause);
    el.addEventListener("mouseleave", () => { if (!el.matches(":focus-within")) run(); });
    el.addEventListener("focusin", pause);
    el.addEventListener("focusout", () => { if (!el.matches(":hover")) run(); });
    el.querySelector(".ma-close")?.addEventListener("click", close);
    el.addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Escape") close(); });
  }
</script>
