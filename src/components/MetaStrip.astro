<div id="meta-strip" class="meta-strip" hidden>
  <div class="ms-inner">
    <a class="ms-link" href="/partners#aws-ai">
      <span class="ms-badge">New</span>
      <span class="ms-text">Algorims is now an <strong>AWS AI Services Competency Partner</strong></span>
      <span class="ms-more">Learn more <span aria-hidden="true">→</span></span>
    </a>
    <a class="ms-link" href="/partners#meta" hidden>
      <span class="ms-badge">New</span>
      <span class="ms-text">Algorims is a <strong>Meta Tech Provider</strong> for the WhatsApp Business Platform</span>
      <span class="ms-more">Learn more <span aria-hidden="true">→</span></span>
    </a>
    <button type="button" class="ms-close" aria-label="Dismiss announcement">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </div>
</div>

<style is:global>
  .meta-strip { width: calc(100% - 60px); max-width: 1600px; margin-inline: auto; overflow: hidden; background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); animation: ms-in .4s ease both; }
  .meta-strip[hidden], .ms-link[hidden] { display: none; }
  .ms-inner { position: relative; display: flex; align-items: center; justify-content: center; padding: 9px 44px; }
  .ms-link { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 10px; font-size: .86rem; line-height: 1.4; text-align: center; color: inherit; }
  .ms-badge { padding: 1px 8px; border-radius: 999px; background: rgba(255,255,255,.22); font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .ms-more { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .ms-link:focus-visible, .ms-close:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 4px; }
  .ms-close { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); display: grid; place-items: center; width: 26px; height: 26px; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; }
  .ms-close:hover { background: rgba(255,255,255,.2); }
  @keyframes ms-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @media (max-width: 800px) { .meta-strip { width: calc(100% - 24px); } }
  @media (max-width: 600px) { .ms-more { display: none; } .ms-link { font-size: .8rem; } }
  @media (prefers-reduced-motion: reduce) { .meta-strip { animation: none; } }
</style>

<script>
  const SEEN = "algorims-aws-ai-announce-v1";
  const NEXT = "algorims-partner-banner-v1";
  const strip = document.getElementById("meta-strip");
  const read = (key: string) => { try { return sessionStorage.getItem(key); } catch { return null; } };
  if (strip) {
    const [aws, meta] = strip.querySelectorAll<HTMLAnchorElement>(".ms-link");
    let next = read(NEXT) ?? "aws";
    let popupFinished = read(SEEN) === "1";
    const render = () => {
      aws.hidden = next !== "aws";
      meta.hidden = next !== "meta";
      strip.hidden = next === "done" || (next === "aws" && (!popupFinished || location.pathname.startsWith("/partners")));
    };
    const advance = (value: "meta" | "done") => {
      next = value;
      try { sessionStorage.setItem(NEXT, next); } catch {}
      render();
    };
    aws.addEventListener("click", () => advance("meta"));
    meta.addEventListener("click", () => advance("done"));
    strip.querySelector(".ms-close")?.addEventListener("click", () => advance(next === "aws" ? "meta" : "done"));
    window.addEventListener("aws-ai-announce:acknowledged", () => advance("meta"), { once: true });
    window.addEventListener("aws-ai-announce:closed", () => { popupFinished = true; render(); }, { once: true });
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) { next = read(NEXT) ?? next; render(); }
    });
    render();
  }
</script>
