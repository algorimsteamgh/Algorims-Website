---
const partners = [
  { id: "aws", name: "AWS Partner Network", tier: "Advanced Tier Services", logo: "/assets/aws-partner-badge.webp", alt: "AWS Partner — Advanced Tier Services" },
  { id: "aws-ai", name: "AWS AI Services", tier: "Competency Partner", logo: "/assets/partners/aws-ai-services-competency-badge.png", alt: "AWS Partner — AI Services Competency" },
  { id: "claude", name: "Anthropic", tier: "Claude Certified Services Partner", logo: "/assets/partners/claude-certified-services-partner.svg", alt: "Claude Partner Network — Certified Services Partner" },
  { id: "meta", name: "WhatsApp Business", tier: "Meta Tech Provider", logo: "/assets/partners/whatsapp-glyph-green-2026.svg", alt: "WhatsApp" },
  { id: "xero", name: "Xero", tier: "Certified Solutions Partner", logo: "/assets/partners/xero-blue-partner-badge.svg", alt: "Xero Solutions Partner" },
  { id: "invoicenow", name: "InvoiceNow", tier: "IRSP Reseller", logo: "/assets/partners/invoicenow-logo.png", alt: "InvoiceNow" },
];
---

<section class="partner-grid-section" aria-labelledby="partner-grid-title">
  <ul class="partner-grid" role="list">
    <li class="partner-grid-title">
      <h2 id="partner-grid-title">
        <span>We partner</span>
        <span class="accent">with leading AI, cloud</span>
        <span class="accent">and finance platforms</span>
      </h2>
      <a href="/partners">See all partnerships <span aria-hidden="true">→</span></a>
    </li>
    {partners.map((p) => (
      <li>
        <a class="partner-card" href={`/partners#${p.id}`}>
          <img src={p.logo} alt={p.alt} loading="lazy" decoding="async" />
          <span class="partner-meta">
            <span class="partner-name">{p.name}</span>
            <span class="partner-tier">{p.tier}</span>
          </span>
          <span class="partner-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .partner-grid-section { padding: 90px clamp(24px, 5vw, 74px); border-top: 1px solid hsl(var(--border)); }
  .partner-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; max-width: 1060px; margin: 0 auto; padding: 0; list-style: none; }

  .partner-grid-title { grid-column: span 2; display: flex; flex-direction: column; justify-content: center; gap: 18px; padding: 24px 32px 24px 8px; }
  .partner-grid-title h2 { display: flex; flex-wrap: wrap; gap: .1em .3em; margin: 0; font-size: clamp(1.35rem, 2.1vw, 1.75rem); font-weight: 600; line-height: 1.2; letter-spacing: -.03em; }
  .partner-grid-title .accent { color: hsl(var(--primary)); }
  .partner-grid-title > a { width: max-content; color: hsl(var(--primary)); font-size: .9rem; font-weight: 600; text-underline-offset: 4px; }
  .partner-grid-title > a:hover { text-decoration: underline; }

  .partner-card { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; height: 11rem; padding: 22px 16px 18px; border: 1px solid transparent; border-radius: 2rem; background: hsl(var(--muted)); text-align: center; transition: border-color .4s, background-color .4s; }
  .partner-card img { width: auto; max-width: 70%; height: 72px; object-fit: contain; transition: transform .4s ease; }
  .partner-meta { display: grid; gap: 2px; }
  .partner-name { color: hsl(var(--foreground)); font-size: .82rem; font-weight: 600; }
  .partner-tier { color: hsl(var(--muted-foreground)); font-size: .72rem; line-height: 1.3; }
  .partner-arrow { position: absolute; top: 16px; right: 20px; color: hsl(var(--primary)); font-size: .9rem; opacity: 0; transform: translate(-3px, 3px); transition: opacity .3s, transform .3s; }

  .partner-card:is(:hover, :focus-visible) { border-color: hsl(var(--primary) / .18); background: hsl(var(--primary) / .04); }
  .partner-card:is(:hover, :focus-visible) img { transform: scale(1.04); }
  .partner-card:is(:hover, :focus-visible) .partner-arrow { opacity: 1; transform: none; }
  .partner-card:focus-visible, .partner-grid-title > a:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 3px; }

  /* Logos are designed for light grounds — keep cards light in dark mode */
  :global(.dark) .partner-card { background: hsl(240 8% 94%); }
  :global(.dark) .partner-card:is(:hover, :focus-visible) { background: hsl(0 0% 98%); }
  :global(.dark) .partner-name { color: hsl(225 10% 9%); }
  :global(.dark) .partner-tier { color: hsl(224 7% 34%); }

  /* Touch: no hover, so show logos in colour */
  @media (hover: none) { .partner-card img { opacity: 1; filter: none; } }

  @media (max-width: 991px) {
    .partner-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .partner-grid-title { grid-column: span 3; align-items: center; padding: 8px 8px 20px; text-align: center; }
    .partner-grid-title h2 { justify-content: center; }
  }
  @media (max-width: 600px) {
    .partner-grid-section { padding: 62px 20px; }
    .partner-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .partner-grid-title { grid-column: span 2; }
    .partner-card { height: 9rem; border-radius: 1.5rem; gap: 8px; padding: 16px 10px 14px; }
    .partner-card img { height: 52px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .partner-card, .partner-card img, .partner-arrow { transition: none; }
  }
</style>
