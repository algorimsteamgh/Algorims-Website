---
interface Props {
  outcomes: { title: string; desc: string }[];
}
const { outcomes } = Astro.props;
---
<h3 class="sr-only">What we deliver</h3>
<ul class="outcomes">
  {outcomes.map((outcome) => (
    <li>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
      <div>
        <strong>{outcome.title}</strong>
        <span>{outcome.desc}</span>
      </div>
    </li>
  ))}
</ul>

<style>
  .outcomes { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; margin: 18px 0 0; padding: 16px 0 0; border-top: 1px solid hsl(var(--border) / .8); list-style: none; }
  .outcomes li { display: flex; gap: 7px; }
  .outcomes svg { flex-shrink: 0; width: 14px; height: 14px; margin-top: 2px; color: hsl(var(--primary)); }
  .outcomes strong { display: block; color: hsl(var(--foreground)); font-size: .88rem; font-weight: 600; line-height: 1.3; }
  .outcomes span { display: block; margin-top: 4px; color: hsl(var(--muted-foreground)); font-size: .81rem; line-height: 1.4; }
  .outcomes li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (max-width: 345px) {
    .outcomes { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
