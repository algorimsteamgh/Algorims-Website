---
// Each reason is backed by a claim already published elsewhere on the site
// (solutions, partners and services pages). Keep it that way.
const reasons = [
  { lead: "Runs in your own AWS account,", rest: "with your data under your controls" },
  { lead: "AWS Advanced Tier", rest: "and Claude Partner Network certified" },
  { lead: "Human in the loop:", rest: "anything that touches money goes to your team" },
  { lead: "Works with your stack:", rest: "Xero, Microsoft 365, Google Drive, WhatsApp" },
  { lead: "Senior, certified engineers", rest: "design, build and run your system" },
  { lead: "24/7 support", rest: "and tuning after launch" },
];
---

<section class="why section" aria-labelledby="why-title">
  <header>
    <p class="why-kicker">Why Algorims</p>
    <h2 id="why-title">A few more reasons <span>to talk to us.</span></h2>
    <p>What clients tell us mattered most when they chose a partner to put AI into production.</p>
  </header>
  <ul class="why-pills" role="list">
    {reasons.map((r) => (
      <li><strong>{r.lead}</strong> {r.rest}</li>
    ))}
  </ul>
</section>

<style>
  .why { padding: 64px clamp(24px, 5vw, 74px); border-top: 1px solid hsl(var(--border)); }
  .why > header { max-width: 720px; margin: 0 auto 32px; text-align: center; }
  .why-kicker { margin: 0 0 10px; color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .why h2 { margin: 0; font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.08; letter-spacing: -.045em; }
  .why h2 span { color: hsl(var(--primary)); }
  .why > header > p:last-child { margin: 12px 0 0; color: hsl(var(--muted-foreground)); font-size: .95rem; line-height: 1.55; }

  .why-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 1080px; margin: 0 auto; padding: 0; list-style: none; }
  .why-pills li { padding: 14px 26px; border: 1px solid hsl(var(--border)); border-radius: 999px; background: hsl(var(--background)); color: hsl(var(--muted-foreground)); font-size: 1rem; line-height: 1.4; transition: border-color .3s, background-color .3s; }
  .why-pills li:hover { border-color: hsl(var(--primary) / .25); background: hsl(var(--primary) / .03); }
  .why-pills strong { color: hsl(var(--primary)); font-weight: 500; }

  @media (max-width: 600px) {
    .why { padding: 48px 20px; }
    .why-pills { gap: 8px; }
    .why-pills li { padding: 12px 18px; border-radius: 1.25rem; font-size: .9rem; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) { .why-pills li { transition: none; } }
</style>
