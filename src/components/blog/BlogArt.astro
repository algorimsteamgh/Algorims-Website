---
const art = {
  agent: ["Data · Documents · Tools", "Enterprise AI agent", "Secure actions · Measurable outcomes"],
  ai: ["Models · Enterprise data", "Production AI system", "Business growth"],
  aws: ["Applications · Data", "AWS cloud", "Performance · Scale"],
  azure: ["Infrastructure · Data", "Microsoft Azure", "Security · Scale"],
  code: ["Application · Cloud · Infrastructure", "Typed platform", "Safe, reliable changes"],
  devops: ["Source code", "CI/CD pipeline", "Fast, verified releases"],
  migration: ["Legacy infrastructure", "Cloud migration", "Lower cost · Better performance"],
  platform: ["Code · Tools · Infrastructure", "Internal developer platform", "Faster delivery"],
  rag: ["Documents · Knowledge stores", "Retrieval & reasoning", "Trusted, connected answers"],
} as const;

const { kind, labeled = false } = Astro.props as { kind: string; labeled?: boolean };
const labels = art[kind as keyof typeof art] ?? ["Source systems", "Enterprise platform", "Business outcomes"];
const alt = labeled ? `${labels[0]} connect through ${labels[1]} to produce ${labels[2]}.` : "";
---
<figure class:list={["blog-art", { labeled }]}>
  <img
    class="blog-art-light"
    src={`/assets/illustrations/blog-${kind}.webp`}
    alt={alt}
    aria-hidden={labeled ? undefined : "true"}
    width="1672"
    height="941"
    loading="lazy"
  />
  <img
    class="blog-art-dark"
    src={`/assets/illustrations/blog-${kind}-dark.webp`}
    alt=""
    aria-hidden="true"
    width="1672"
    height="941"
    loading="lazy"
  />
  {labeled && <figcaption>
    {[["Inputs", labels[0]], ["Core", labels[1]], ["Outcome", labels[2]]].map(([label, value]) => (
      <span><b>{label}</b>{value}</span>
    ))}
  </figcaption>}
</figure>

<style>
  figure { display: grid; width: 100%; height: 100%; margin: 0; }
  img { grid-area: 1 / 1; display: block; width: 100%; height: 100%; object-fit: contain; }
  .labeled { height: auto; }
  .labeled img { height: auto; }
  .blog-art-dark { display: none; }
  :global(.dark) .blog-art-light { display: none; }
  :global(.dark) .blog-art-dark { display: block; }
  figcaption {
    grid-area: 2 / 1;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 16px;
    padding: 14px 20px;
    border-top: 1px solid hsl(var(--border));
    background: hsl(var(--secondary) / 0.3);
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    line-height: 1.35;
  }
  figcaption span { display: grid; gap: 2px; }
  figcaption b {
    color: hsl(var(--foreground));
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (max-width: 520px) {
    figcaption { gap: 7px; padding: 10px 12px; font-size: 0.54rem; }
    figcaption b { font-size: 0.48rem; }
  }
</style>
