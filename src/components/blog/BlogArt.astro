---
const { kind } = Astro.props as { kind: string };
---
<img
  class="blog-art-light"
  src={`/assets/illustrations/blog-${kind}.png`}
  alt=""
  aria-hidden="true"
  width="1672"
  height="941"
  loading="lazy"
/>
<img
  class="blog-art-dark"
  src={`/assets/illustrations/blog-${kind}-dark.png`}
  alt=""
  aria-hidden="true"
  width="1672"
  height="941"
  loading="lazy"
/>

<style>
  img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .blog-art-dark { display: none; }
  :global(.dark) .blog-art-light { display: none; }
  :global(.dark) .blog-art-dark { display: block; }
</style>
