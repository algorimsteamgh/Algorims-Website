---
import type { CollectionEntry } from "astro:content";
import BlogArt from "./BlogArt.astro";

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
---
<a href={`/blog/${post.id}`} class="group flex flex-col rounded-3xl border border-border bg-card overflow-hidden transition-all hover:-translate-y-1 hover:border-primary/30 hover:shadow-md">
  <div class="aspect-[16/10] overflow-hidden"><BlogArt kind={post.data.art} /></div>
  <div class="p-7 flex flex-col flex-1">
    <div class="flex items-center gap-3 text-xs">
      <span class="rounded-full bg-primary/10 px-2.5 py-1 font-medium text-primary">{post.data.category}</span>
      <span class="text-muted-foreground">{post.data.read}</span>
    </div>
    <h3 class="mt-3 text-xl font-semibold tracking-tight">{post.data.title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{post.data.excerpt}</p>
    <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-primary">Read article <i data-lucide="arrow-up-right" class="!w-4 !h-4"></i></span>
  </div>
</a>
