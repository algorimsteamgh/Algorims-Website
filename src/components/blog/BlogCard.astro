---
import type { CollectionEntry } from "astro:content";
import BlogArt from "./BlogArt.astro";

const { post, index } = Astro.props as { post: CollectionEntry<"blog">; index: number };
---
<a href={`/blog/${post.id}`} class="blog-card">
  <div class="blog-card-art"><BlogArt kind={post.data.art} /></div>
  <div class="blog-card-copy">
    <div>
      <span class="blog-card-read"><b>{String(index).padStart(2, "0")}</b>{post.data.read}</span>
      <h3>{post.data.title}</h3>
    </div>
    <i data-lucide="arrow-up-right" aria-hidden="true"></i>
  </div>
</a>

<style>
  .blog-card { position: relative; display: flex; min-width: 0; height: 100%; flex-direction: column; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; color: inherit; transition: border-color .2s, transform .2s; }
  .blog-card::before { position: absolute; z-index: 2; inset: 0 0 auto; height: 3px; background: hsl(var(--primary)); transform: scaleX(0); transform-origin: left; transition: transform .22s ease; content: ""; }
  .blog-card:hover { transform: translateY(-4px); border-color: hsl(var(--primary) / .45); }
  .blog-card:hover::before { transform: scaleX(1); }
  .blog-card-art { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid hsl(var(--border)); }
  .blog-card-art > :global(*) { transition: transform .3s ease; }
  .blog-card:hover .blog-card-art > :global(*) { transform: scale(1.025); }
  .blog-card-copy { display: flex; flex: 1; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.5rem; }
  .blog-card-read { display: flex; align-items: center; gap: 10px; color: hsl(var(--muted-foreground)); font-size: .72rem; }
  .blog-card-read b { color: hsl(var(--primary)); font-size: .68rem; letter-spacing: .14em; }
  .blog-card h3 { margin: .55rem 0 0; font-size: 1.2rem; font-weight: 600; line-height: 1.2; letter-spacing: -.035em; text-wrap: balance; }
  .blog-card-copy :global(svg) { width: 1.15rem; height: 1.15rem; flex: 0 0 auto; color: hsl(var(--primary)); transition: transform .2s ease; }
  .blog-card:hover .blog-card-copy :global(svg) { transform: translate(3px, -3px); }
  @media (prefers-reduced-motion: reduce) { .blog-card, .blog-card::before, .blog-card-art > :global(*), .blog-card-copy :global(svg) { transition: none; } .blog-card:hover, .blog-card:hover .blog-card-art > :global(*) { transform: none; } }
</style>
