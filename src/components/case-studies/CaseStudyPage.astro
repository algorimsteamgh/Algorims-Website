---
import { getCollection, type CollectionEntry } from "astro:content";
import caseScenes from "../../data/caseScenes.json";

interface Props { entry: CollectionEntry<"case-studies"> }
const { entry } = Astro.props;
const data = entry.data;
const artwork = caseScenes[entry.id as keyof typeof caseScenes];
const collections = await Promise.all([getCollection("case-studies"), getCollection("solutions"), getCollection("products")]);
const paths = ["case-studies", "solutions", "products"];
const related = data.related.flatMap((slug) => {
  for (const [index, collection] of collections.entries()) {
    const found = collection.find((item) => item.id === slug);
    if (found) return [{ href: `/${paths[index]}/${slug}`, kind: found.data.kind, title: found.data.title, tag: found.data.tag }];
  }
  return [];
});
---
<article class="case-study-detail">
  <div class="breadcrumb"><a href="/case-studies"><i data-lucide="arrow-left" aria-hidden="true" /> All case studies</a></div>

  <header class="case-hero">
    <div class="hero-copy">
      <p class="kicker">{data.kind} / {data.tag}</p>
      {data.clientLogo && <div class="client"><img src={data.clientLogo.src} alt={data.clientLogo.alt} /><span><small>Deployed for</small>{data.clientLogo.name}</span></div>}
      <h1>{data.title}</h1>
      <p class="hero-lead">{data.subtitle}</p>
      <div class="hero-actions"><a class="primary-action" href="/contact">Talk to an architect <i data-lucide="arrow-right" aria-hidden="true" /></a><a href="#overview">Read the case study <i data-lucide="arrow-down" aria-hidden="true" /></a></div>
    </div>
    <figure class="hero-screen">
      <img src={artwork.src} srcset={`${artwork.src.replace(".webp", "-600.webp")} 600w, ${artwork.src} 1200w`} sizes="(min-width: 900px) 860px, 100vw" width="1200" height="675" alt={artwork.alt} fetchpriority="high" />
      <figcaption>{artwork.caption}</figcaption>
    </figure>
  </header>

  <dl class="engagement-facts" aria-label="Engagement details">
    {data.meta.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
  </dl>

  <section class="impact-strip" aria-labelledby="impact-title">
    <h2 id="impact-title">Measured impact</h2>
    <div>
      {data.metrics.map((metric) => <article>{metric.value === "✓" ? <i data-lucide="check" aria-hidden="true" /> : <strong>{metric.value}</strong>}<p>{metric.label}</p></article>)}
    </div>
  </section>

  <nav class="study-nav" aria-label="Case study sections">
    <span>On this page</span>
    <a href="#overview">Overview</a><a href="#challenge">Challenge</a><a href="#solution">Solution</a>{data.architecture && <a href="#architecture">Architecture</a>}<a href="#results">Results</a>
  </nav>

  <section class="case-section overview" id="overview">
    <header><p class="kicker">01 / Overview</p><h2>The operating context.</h2></header>
    <div class="prose">{data.intro.map((paragraph) => <p set:html={paragraph} />)}</div>
  </section>

  <section class="case-section challenge" id="challenge">
    <header><p class="kicker">02 / Challenge</p><h2>What stood in the way.</h2><p>{data.challenge.lead}</p></header>
    <ol>{data.challenge.items.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p set:html={item} /></li>)}</ol>
  </section>

  <section class="case-section solution" id="solution">
    <header><p class="kicker">03 / Solution</p><h2>{data.solutionTitle ?? "What Algorims built"}</h2><p>{data.solutionLead}</p></header>
    <div class="solution-grid">{data.solution.map((step, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{step.h}</h3><p set:html={step.p} /></article>)}</div>
  </section>

  {data.architecture && <section class="case-section architecture" id="architecture">
    <header><p class="kicker">04 / Architecture</p><h2>The system behind the outcome.</h2><p>{data.architecture.caption}</p></header>
    <figure><img src={data.architecture.src} alt={data.architecture.alt} loading="lazy" /></figure>
  </section>}

  {data.tech && data.tech.length > 0 && <section class="case-section stack" aria-labelledby="stack-title"><header><p class="kicker">System stack</p><h2 id="stack-title">Production foundations.</h2></header><ul>{data.tech.map((item) => <li>{item}</li>)}</ul></section>}

  <section class="case-section results" id="results">
    <header><p class="kicker">{data.architecture ? "05" : "04"} / Results</p><h2>What changed after delivery.</h2></header>
    <div>{data.results.map((result, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><p set:html={result} /></article>)}</div>
  </section>

  {related.length > 0 && <section class="case-section related" aria-labelledby="related-title"><header><p class="kicker">Continue exploring</p><h2 id="related-title">Related work.</h2></header><div>{related.map((item) => <a href={item.href}><p>{item.kind} / {item.tag}</p><h3>{item.title}</h3><span>Explore <i data-lucide="arrow-up-right" aria-hidden="true" /></span></a>)}</div></section>}

</article>

<style>
  .case-study-detail { background: hsl(var(--background)); }
  .breadcrumb { padding: 24px clamp(20px, 5vw, 70px); border-bottom: 1px solid hsl(var(--border)); }
  .breadcrumb a { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; color: hsl(var(--muted-foreground)); font-size: .88rem; font-weight: 600; transition: color .2s ease; }
  .breadcrumb a:hover { color: hsl(var(--primary)); }
  .case-hero { padding: clamp(54px, 7vw, 96px) clamp(20px, 6vw, 80px) 0; }
  .hero-copy { max-width: 1040px; margin: 0 auto; text-align: center; animation: hero-in .7s both cubic-bezier(.22, 1, .36, 1); }
  .kicker { margin: 0; color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  .client { display: inline-flex; align-items: center; gap: 12px; margin: 22px 0 0; text-align: left; }
  .client img { width: auto; max-width: 130px; height: 34px; object-fit: contain; }
  .client span { display: grid; gap: 2px; font-size: .9rem; font-weight: 600; }
  .client small { color: hsl(var(--muted-foreground)); font-size: .65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 22px auto 0; font-size: clamp(2.6rem, 5.6vw, 5.3rem); font-weight: 600; line-height: 1.01; letter-spacing: -.06em; text-wrap: balance; }
  .hero-lead { max-width: 790px; margin: 26px auto 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.5vw, 1.18rem); line-height: 1.72; text-wrap: balance; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 30px; }
  .hero-actions a { display: inline-flex; min-height: 48px; align-items: center; gap: 9px; padding: 0 22px; border: 1px solid hsl(var(--foreground)); border-radius: 999px; font-size: .9rem; font-weight: 600; transition: color .2s ease, background .2s ease, border-color .2s ease; }
  .hero-actions .primary-action { border-color: hsl(var(--primary)); background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); }
  .hero-actions a:hover { border-color: hsl(var(--primary)); }
  .hero-actions a:not(.primary-action):hover { color: hsl(var(--primary)); }
  .hero-screen { max-width: 880px; margin: clamp(36px, 5vw, 56px) auto 0; padding: 10px 10px 0; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 22px 22px 0 0; background: hsl(var(--background)); animation: screen-in .8s .12s both cubic-bezier(.22, 1, .36, 1); }
  .hero-screen img { display: block; width: 100%; height: auto; border: 1px solid hsl(var(--border)); border-radius: 18px; }
  .hero-screen figcaption { padding: 11px 8px 13px; color: hsl(var(--muted-foreground)); font-size: .76rem; line-height: 1.45; text-align: left; }
  .engagement-facts { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 880px; margin: 0 auto clamp(64px, 8vw, 104px); overflow: hidden; border: 1px solid hsl(var(--border)); border-top: 0; border-radius: 0 0 22px 22px; }
  .engagement-facts div { min-width: 0; padding: 22px; }
  .engagement-facts div + div { border-left: 1px solid hsl(var(--border)); }
  .engagement-facts dt { color: hsl(var(--muted-foreground)); font-size: .66rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .engagement-facts dd { margin: 7px 0 0; font-size: .9rem; font-weight: 600; line-height: 1.45; }
  .impact-strip { margin: 0 clamp(20px, 5vw, 64px); overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 24px; }
  .impact-strip > h2 { padding: 22px clamp(20px, 6vw, 80px); border-bottom: 1px solid hsl(var(--border)); font-size: .72rem; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  .impact-strip > div { display: grid; grid-template-columns: repeat(3, 1fr); }
  .impact-strip article { min-height: 156px; padding: 30px clamp(20px, 3vw, 38px); }
  .impact-strip article + article { border-left: 1px solid hsl(var(--border)); }
  .impact-strip strong { color: hsl(var(--primary)); font-size: clamp(2rem, 3.8vw, 3.3rem); letter-spacing: -.05em; }
  .impact-strip article :global(svg) { width: 42px; height: 42px; padding: 10px; border: 1px solid hsl(var(--primary)); color: hsl(var(--primary)); }
  .impact-strip p { max-width: 310px; margin: 10px 0 0; color: hsl(var(--muted-foreground)); font-size: .86rem; line-height: 1.5; }
  .study-nav { position: sticky; top: 12px; z-index: 20; display: flex; min-height: 58px; align-items: center; gap: 28px; width: calc(100% - clamp(40px, 10vw, 128px)); margin: 28px auto 0; overflow-x: auto; padding: 0 22px; border: 1px solid hsl(var(--border)); border-radius: 999px; background: hsl(var(--background) / .94); backdrop-filter: blur(14px); }
  .study-nav span { margin-right: auto; color: hsl(var(--muted-foreground)); font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .study-nav a { display: grid; min-height: 44px; place-items: center; color: hsl(var(--muted-foreground)); font-size: .8rem; font-weight: 600; white-space: nowrap; transition: color .2s ease; }
  .study-nav a:hover { color: hsl(var(--primary)); }
  .case-section { padding: clamp(72px, 9vw, 116px) clamp(20px, 6vw, 80px); border-bottom: 1px solid hsl(var(--border)); scroll-margin-top: 58px; }
  .case-section > header { max-width: 820px; }
  .case-section h2 { margin: 15px 0 0; font-size: clamp(2.15rem, 4.2vw, 4rem); font-weight: 600; line-height: 1.04; letter-spacing: -.055em; text-wrap: balance; }
  .case-section header > p:not(.kicker) { max-width: 760px; margin: 22px 0 0; color: hsl(var(--muted-foreground)); line-height: 1.72; }
  .overview { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(44px, 9vw, 140px); }
  .prose { max-width: 760px; }
  .prose p { margin: 0; color: hsl(var(--foreground) / .84); font-size: 1.04rem; line-height: 1.82; }
  .prose p + p { margin-top: 22px; }
  .challenge > header, .solution > header, .architecture > header, .results > header, .stack > header, .related > header { margin-bottom: 44px; }
  .challenge ol, .solution-grid, .results > div, .related > div { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; padding: 0; overflow: hidden; border-top: 1px solid hsl(var(--border)); border-left: 1px solid hsl(var(--border)); border-radius: 24px; list-style: none; }
  .challenge li, .solution-grid article, .results article, .related a { padding: clamp(24px, 3.5vw, 40px); border-right: 1px solid hsl(var(--border)); border-bottom: 1px solid hsl(var(--border)); }
  .challenge li > span, .solution-grid article > span, .results article > span { color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .14em; }
  .challenge li p, .solution-grid article p, .results article p { margin: 20px 0 0; color: hsl(var(--muted-foreground)); line-height: 1.72; }
  .solution { background: hsl(var(--secondary)); }
  .solution-grid article { background: hsl(var(--background)); transition: background-color .2s ease; }
  .solution-grid article:hover { background: hsl(var(--muted)); }
  .solution-grid h3 { margin: 18px 0 0; font-size: 1.3rem; font-weight: 600; letter-spacing: -.025em; }
  .architecture figure { margin: 0; padding: clamp(14px, 3vw, 34px); overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 24px; background: #fff; }
  .architecture img { display: block; width: 100%; max-width: 1050px; height: auto; margin: auto; border-radius: 16px; }
  .stack { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(40px, 8vw, 120px); }
  .stack ul { display: flex; flex-wrap: wrap; align-content: start; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .stack li { padding: 10px 14px; border: 1px solid hsl(var(--border)); border-radius: 999px; color: hsl(var(--muted-foreground)); font-size: .85rem; font-weight: 600; transition: color .2s ease, border-color .2s ease; }
  .stack li:hover { border-color: hsl(var(--primary)); color: hsl(var(--primary)); }
  .results article { min-height: 160px; }
  .results article p { margin-top: 14px; color: hsl(var(--foreground) / .84); }
  .results article p :global(strong) { color: hsl(var(--foreground)); }
  .related a { display: flex; min-height: 235px; flex-direction: column; transition: background-color .2s ease; }
  .related a:hover { background: hsl(var(--secondary)); }
  .related a > p { margin: 0; color: hsl(var(--primary)); font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .related h3 { max-width: 480px; margin: 18px 0 28px; font-size: clamp(1.25rem, 2.3vw, 1.8rem); font-weight: 600; line-height: 1.2; }
  .related a > span { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; color: hsl(var(--primary)); font-size: .85rem; font-weight: 700; }
  .related a :global(svg) { transition: transform .2s ease; }
  .related a:hover :global(svg) { transform: translate(4px, -4px); }
  @keyframes hero-in { from { opacity: 0; transform: translateY(18px); } }
  @keyframes screen-in { from { opacity: 0; transform: translateY(24px) scale(.99); } }
  @supports (animation-timeline: view()) { .case-section { animation: section-in linear both; animation-timeline: view(); animation-range: entry 0 entry 24%; } @keyframes section-in { from { opacity: .35; transform: translateY(20px); } to { opacity: 1; transform: none; } } }
  @media (max-width: 900px) {
    .engagement-facts { grid-template-columns: repeat(2, 1fr); }
    .engagement-facts div:nth-child(odd) { border-left: 0; }
    .engagement-facts div:nth-child(n + 3) { border-top: 1px solid hsl(var(--border)); }
    .overview, .stack { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .impact-strip > div, .challenge ol, .solution-grid, .results > div, .related > div { grid-template-columns: 1fr; }
    .impact-strip article + article { border-top: 1px solid hsl(var(--border)); border-left: 0; }
    .study-nav { gap: 22px; }
    .study-nav span { display: none; }
  }
  @media (max-width: 520px) {
    .engagement-facts { grid-template-columns: 1fr; }
    .engagement-facts div + div { border-top: 1px solid hsl(var(--border)); border-left: 0; }
    .hero-actions { align-items: stretch; flex-direction: column; }
    .hero-actions a { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-copy, .hero-screen, .case-section { animation: none !important; transform: none !important; }
    .hero-actions a, .breadcrumb a, .solution-grid article, .stack li, .related a, .related a :global(svg) { transition: none; }
    .related a:hover :global(svg) { transform: none; }
  }
</style>
