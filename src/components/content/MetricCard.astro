---
// Renders one entry of `metrics[]` (case-studies / solutions / products).
// Matches the `metricCard()` helper inside `renderDetailPage()` in
// assets/js/site.js: a checkmark tile when value === "✓", otherwise a
// large gradient number/stat.
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---
<div class="rounded-2xl border border-border bg-card p-5 transition-all hover:border-primary/30 hover:shadow-md">
  {value === "✓" ? (
    <div class="grid h-10 w-10 place-items-center rounded-xl bg-primary/10 text-primary">
      <i data-lucide="check" class="!w-5 !h-5" />
    </div>
  ) : (
    <p class="text-3xl font-semibold tracking-tight text-gradient md:text-4xl">{value}</p>
  )}
  <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{label}</p>
</div>
