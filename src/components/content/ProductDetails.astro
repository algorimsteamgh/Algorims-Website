---
interface Props { slug: string; part: "feed" | "more" | "cta" }
const { slug, part } = Astro.props;

const details: Record<string, {
  feed: string;
  rows: { label: string; detail: string; status: string; held?: boolean }[];
  warning: string;
  heading: string;
  lead: string;
  cards: { title: string; text: string }[];
  capabilities: string[];
  cta: { title: string; text: string };
  pipeline: string[];
  markets?: { name: string; region: string; compliance: string; currency: string; description: string }[];
  economics?: { columns: string[]; rows: string[][]; note: string };
}> = {
  cxiq: {
    feed: "Conversation feed",
    rows: [
      { label: '"What time does the clinic open Saturday?"', detail: "CHT-88201", status: "Answered" },
      { label: '"Can you confirm my RSVP for the annual dinner?"', detail: "CHT-88207", status: "Confirmed" },
      { label: '"Can I get a refund on my membership fee?"', detail: "CHT-88213", status: "Awaiting approval", held: true },
      { label: '"Where\'s my order #4521?"', detail: "CHT-88219", status: "Answered" },
    ],
    warning: "Money actions are approval-gated by default, regardless of intent confidence.",
    heading: "Two stacks, one product",
    lead: "Most deployments need the core build. Enterprise contact centers can add managed NLU, multi-step agents, and voice escalation without changing the trust rules.",
    cards: [
      { title: "Core · community and SME", text: "A 2–4 week build using Bedrock Claude, per-intent confidence scores, and editable rules over existing WhatsApp and email. The community and association track has a proven 10–15 hours per week recovered." },
      { title: "SME commerce and service", text: "Order status, appointments, FAQ deflection, and payment reminders for clinics, salons, F&B, and commerce teams. This track is modeled and currently validating with design partners." },
      { title: "Enterprise contact center", text: "A scoped engagement for teams with an existing CRM and 5,000+ contacts per month. Optional Lex v2, Bedrock Agents, and Amazon Connect carry full context into voice escalation. This track is in validation." },
    ],
    capabilities: [
      "Repeated low-confidence extraction from the same person escalates to a human rather than looping or guessing.",
      "An unrecognized phone number follows a defined identity-resolution flow; automated RSVPs, reminders, and bookings have a human-visible undo path.",
      "English plus Mandarin, Malay, Tamil, or Hindi is scoped upfront. Consent and opt-out are explicit and designed for PDPA/DPDP compliance.",
      "Every automated reply and human decision enters an append-only audit trail. Idempotency prevents duplicate RSVPs or double-sent reminders.",
    ],
    cta: { title: "Let AI handle the routine. Let your team handle what matters.", text: "Tell us which channels you run and what a typical week of conversations looks like — we'll show you exactly what CXIQ would automate, and what it would always leave to a human." },
    pipeline: ["Receive", "Understand", "Ground", "Gate money actions", "Respond or escalate"],
  },
  dociq: {
    feed: "Processing feed",
    rows: [
      { label: "Invoice · Singapore · Tier 1", detail: "JOB-9F21A4 · 0.98", status: "Auto-approved" },
      { label: "Contract · ANZ · Tier 2", detail: "JOB-9F21A5 · 0.91", status: "Auto-approved" },
      { label: "Claim · India · Tier 3", detail: "JOB-9F21A6 · 0.68", status: "HIL Review", held: true },
      { label: "Invoice · Singapore · Tier 1", detail: "JOB-9F21A7 · 0.96", status: "Auto-approved" },
    ],
    warning: "Fields below the signed-off threshold after Bedrock escalation go to a reviewer, never to silent approval.",
    heading: "The economics, from a reference deployment",
    lead: "Measured at 50,000 documents per month. Textract handles the first pass; Bedrock runs when confidence falls short.",
    cards: [
      { title: "Reviewers own exceptions", text: "The business owner signs off confidence thresholds before go-live. Reviewers receive the document image and a pre-filled extraction overlay, with an agreed response time." },
      { title: "In-region and reversible", text: "Documents and extracted data stay in the client's AWS account and region. Every production cutover has a parallel run and rollback path." },
    ],
    capabilities: [
      "PDFs, scans, photos, rotated originals, forms, and tables are supported; each field carries a confidence score.",
      "Results return in under 2 seconds across a searchable archive of more than 1 million documents.",
      "The reviewer response time is agreed at onboarding. Modeled AI spend and CloudWatch alarms make processing costs predictable.",
    ],
    cta: { title: "Stop paying manual document-keying prices.", text: "Tell us your document mix and volume — we'll model your numbers before you commit to anything." },
    pipeline: ["Receive", "Textract", "Bedrock if needed", "Human review if needed", "ERP delivery"],
    markets: [
      { name: "Singapore / SEA", region: "ap-southeast-1", compliance: "PDPA (SG, MY)", currency: "SGD", description: "Reference architecture already in-region. Dense SME and regional-HQ market with an English-first sales motion." },
      { name: "ANZ", region: "ap-southeast-2", compliance: "Privacy Act 1988, APRA CPS 234/230", currency: "AUD", description: "Highest labor cost of the three markets — the biggest per-FTE savings story — with strong AWS adoption and a regulated FSI opportunity." },
      { name: "India", region: "ap-south-1", compliance: "DPDP Act 2023, RBI outsourcing norms", currency: "INR / USD", description: "Massive finance-ops, GBS, and BPO document volume, with a strong cost-out culture and shared-services buyers." },
    ],
    economics: {
      columns: ["Metric", "Manual + shadow ChatGPT", "DocIQ", "Delta"],
      rows: [
        ["Monthly cost", "SGD $39,350", "SGD $212.78", "−99.5%"],
        ["Cost per document", "SGD $0.787", "SGD $0.00426", "−99.5%"],
        ["12-month TCO", "SGD $472,200", "SGD $12,053", "−97.4%"],
        ["Payback on one-time fee", "—", "1–2 weeks of run-rate savings", "—"],
      ],
      note: "Reference deployment: 50,000 documents/month. Results vary by document mix and volume.",
    },
  },
  opsiq: {
    feed: "Ticket feed",
    rows: [
      { label: "Password reset — user locked out", detail: "TCK-88412 · T1", status: "Auto-resolved" },
      { label: "VPN access request — new hire", detail: "TCK-88417 · T2", status: "Auto-resolved" },
      { label: "Bulk mailbox permission change — Finance", detail: "TCK-88423 · T3", status: "Approval gate", held: true },
      { label: "Software install request — Slack", detail: "TCK-88429 · T2", status: "Auto-resolved" },
    ],
    warning: "Tier 3 bulk-impact and domain changes always pause at a Systems Manager approval gate.",
    heading: "The economics, from a live service desk",
    lead: "Measured over six months at a 200-employee IT and BPO firm. The IT manager signs off each ticket category's automation tier before go-live.",
    cards: [
      { title: "Scoped execution", text: "AWS Systems Manager runs remediation with rollback. Active Directory uses a service account limited to specific cmdlets, federated via SAML; no domain-admin login is shared." },
      { title: "Grounded and private", text: "Classification is checked against retrieved playbooks before execution. Bedrock Guardrails redact PII before logging, and VPC PrivateLink keeps traffic off the public internet." },
    ],
    capabilities: [
      "The reference deployment scored 47 ticket categories; its top 10 categories covered 82% of volume.",
      "Tier 1 is autonomous and reversible, Tier 2 notifies the IT lead, and Tier 3 pauses for approval. The IT manager signs off the tiering category by category.",
      "Every run's inputs, outputs, and status go to an immutable DynamoDB and CloudTrail log. Monthly ticket reviews, including all low-confidence tickets, drive tuning.",
    ],
    cta: { title: "Let AI close the routine tickets. Let your team own what's risky.", text: "Tell us your ticket mix and which ITSM you run — we'll walk through exactly which categories would be Tier 1, 2, or 3 for your desk." },
    pipeline: ["Classify", "Retrieve playbook", "Execute runbook", "Validate tier gate", "Close or escalate"],
    markets: [
      { name: "Singapore / SEA", region: "ap-southeast-1", compliance: "PDPA (SG, MY)", currency: "SGD", description: "Portfolio-consistent beachhead. Dense mid-market IT and regional shared-services-desk buyers, English-first sales motion." },
      { name: "ANZ", region: "ap-southeast-2", compliance: "Privacy Act 1988 / APPs", currency: "AUD", description: "Highest labor cost in APJ for L1 support headcount — the biggest per-FTE savings story — with strong AWS and ServiceNow penetration." },
      { name: "India", region: "ap-south-1", compliance: "DPDP Act 2023", currency: "INR / USD", description: "Reference market — the anchor case is India-native. Dense IT/BPO/GBS service-desk supply and a strong cost-out culture." },
    ],
    economics: {
      columns: ["Metric", "Manual L1 desk", "OpsIQ", "Delta"],
      rows: [
        ["Monthly run-rate", "SGD $11,825", "SGD $1,790", "−85%"],
        ["Auto-resolution", "0%", "78% at month 6", "↑ from 71%"],
        ["Classification accuracy", "—", "91% after tuning", "↑ from 86%"],
        ["Tier-3 false positives", "—", "1.8% at month 6", "↓ from 12%"],
      ],
      note: "Reference deployment: IT & BPO firm, 200 employees, India, ap-south-1, 6 months live. Measured in INR (₹7,45,000 → ₹1,12,650/month) and converted at an indicative SGD→INR rate of ~63. Submitted as an AWS AI Competency case study — reproduced as submitted, not a projection.",
    },
  },
  payiq: {
    feed: "Posting feed",
    rows: [
      { label: "Straits Logistics Pte Ltd", detail: "INV-22841 · SGD 1,240.00", status: "Posted" },
      { label: "Golden Harvest Traders", detail: "INV-22842 · SGD 386.50", status: "Posted" },
      { label: "Meridian Supplies Co.", detail: "INV-22843 · SGD 2,910.00", status: "Held", held: true },
      { label: "Pacific Rim Distributors", detail: "INV-22844 · SGD 764.20", status: "Posted" },
    ],
    warning: "Changed vendor bank details trigger a human review, regardless of confidence score.",
    heading: "Built around the ledger you already run",
    lead: "The connector and market angle change. The fraud stop does not.",
    cards: [
      { title: "ANZ · Xero", text: "Highest labor cost of the three markets means the strongest per-invoice time savings — and business email compromise is front-page news here, so the fraud stop leads the conversation." },
      { title: "Singapore / SEA · Xero + Zoho", text: "Xero for Singapore entities, Zoho across the wider region. Built for lean finance teams who need to grow headcount-free, hosted and compliant in-region." },
      { title: "India · Zoho Books", text: "Zoho's home turf — and the connector's deepest integration, taking invoices all the way from capture through posting to bank reconciliation." },
    ],
    capabilities: [
      "Line items, taxes, and PO references are extracted and matched; new or unrecognized vendors always enter an onboarding review.",
      "Reviewer response time is agreed at onboarding so approvals do not sit past an invoice due date.",
      "PayIQ runs inside your AWS account. AI spend is capped in the stack, invoices queue if AI is unavailable, and wrongly posted invoices have a reversal workflow.",
      "A bank-detail change is verified out of band and the guard cannot be configured off.",
    ],
    cta: { title: "Let your team review exceptions, not type invoices.", text: "Tell us which ERP you run and what your invoice volume looks like — we'll walk you through exactly how PayIQ would handle it." },
    pipeline: ["Ingest", "Extract and score", "Guard vendor details", "Post and reconcile"],
  },
};

const detail = details[slug];
const feedIcon = slug === "cxiq" ? "message-square" : slug === "opsiq" ? "ticket-check" : slug === "payiq" ? "receipt" : "file-check-2";
const detailHeadings: Record<string, [string, string]> = {
  cxiq: ["Two stacks,", "one product"],
  dociq: ["The economics,", "from a reference deployment"],
  opsiq: ["The economics,", "from a live service desk"],
  payiq: ["Built around", "the ledger you already run"],
};
const ctaHeadings: Record<string, [string, string]> = {
  cxiq: ["Let AI handle the routine.", "Let your team handle what matters."],
  dociq: ["Stop paying", "manual document-keying prices."],
  opsiq: ["Let AI close the routine tickets.", "Let your team own what's risky."],
  payiq: ["Let your team review exceptions,", "not type invoices."],
};
---

{detail && part === "feed" && <div class="product-feed">
  <div class="feed-head"><h2>{detail.feed}</h2><span><i data-lucide="circle" aria-hidden="true" /> Live example</span></div>
  <ul>{detail.rows.map((row) => <Fragment><li class:list={["feed-row", { held: row.held }]}><span class="feed-icon" aria-hidden="true"><i data-lucide={row.held ? "shield-alert" : feedIcon} /></span><div class="feed-body"><p>{row.label}</p><small>{row.detail}</small></div><strong><i data-lucide={row.held ? "pause" : "check"} aria-hidden="true" />{row.status}</strong></li>{row.held && <li class="feed-note"><i data-lucide="lock-keyhole" aria-hidden="true" /><span>{detail.warning}</span></li>}</Fragment>)}</ul>
</div>}
{detail && part === "more" && <>
  <section class="detail-section fit-section"><div class="container-x"><header class="detail-heading"><p class="detail-eyebrow">Where it fits</p><h2>{detailHeadings[slug]?.[0] ?? detail.heading} <span>{detailHeadings[slug]?.[1]}</span></h2><p>{detail.lead}</p></header><div class="fit-grid">{detail.cards.map((card, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{card.title}</h3><p>{card.text}</p></article>)}</div></div></section>
  <section class="detail-section commitments-section"><div class="container-x commitments-layout"><header class="detail-heading"><p class="detail-eyebrow">Built-in controls</p><h2>Deployment <span>commitments</span></h2></header><ul>{detail.capabilities.map((capability) => <li><i data-lucide="check" aria-hidden="true" /><span>{capability}</span></li>)}</ul></div></section>
  {detail.markets && <section class="detail-section markets-section"><div class="container-x"><header class="detail-heading"><p class="detail-eyebrow">Regional by design</p><h2>Built region first, <span>market by market.</span></h2></header><div class="market-grid">{detail.markets.map((market) => <article><h3>{market.name}</h3><p>{market.description}</p><dl><div><dt>AWS region</dt><dd>{market.region}</dd></div><div><dt>Compliance</dt><dd>{market.compliance}</dd></div><div><dt>Currency</dt><dd>{market.currency}</dd></div></dl></article>)}</div></div></section>}
  {detail.economics && <section class="detail-section economics-section"><div class="container-x"><header class="detail-heading"><p class="detail-eyebrow">Evidence</p><h2>Measured <span>results</span></h2></header><div class="table-wrap"><table><thead><tr>{detail.economics.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead><tbody>{detail.economics.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table></div><p class="table-note">{detail.economics.note}</p></div></section>}
  <section class="detail-section pipeline-section"><div class="container-x"><header class="detail-heading centered"><p class="detail-eyebrow">Operating sequence</p><h2>A defined path from <span>intake to decision.</span></h2></header><ol>{detail.pipeline.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{step}</p></li>)}</ol></div></section>
</>}
{detail && part === "cta" && <section class="product-cta"><div class="container-x"><p class="detail-eyebrow">Ready when you are</p><h2>{ctaHeadings[slug]?.[0] ?? detail.cta.title} <span>{ctaHeadings[slug]?.[1]}</span></h2><p>{detail.cta.text}</p><a href="/contact" class="btn btn-hero btn-xl">Start a conversation <i data-lucide="arrow-right" aria-hidden="true" /></a></div></section>}

<style>
  .product-feed { background: transparent; }
  .feed-head { display: flex; align-items: center; justify-content: space-between; padding: 0 2px 16px; }
  .feed-head h2 { margin: 0; color: hsl(var(--foreground)); font-size: .7rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .feed-head span { display: inline-flex; align-items: center; gap: 6px; color: hsl(var(--muted-foreground)); font-size: .66rem; font-weight: 600; text-transform: uppercase; }
  .feed-head span :global(svg) { width: 7px; height: 7px; fill: hsl(var(--primary)); color: hsl(var(--primary)); }
  .product-feed ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .feed-row { display: flex; align-items: center; gap: 14px; padding: 14px 18px; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--background)); }
  .feed-row.held { background: hsl(var(--primary) / .07); }
  .feed-icon { display: grid; flex: 0 0 34px; width: 34px; height: 34px; place-items: center; border: 1px solid hsl(var(--border)); border-radius: .75rem; color: hsl(var(--primary)); }
  .feed-icon :global(svg) { width: 16px; height: 16px; stroke-width: 1.8; }
  .feed-body { flex: 1; min-width: 0; }
  .feed-body p { margin: 0; color: hsl(var(--foreground)); font-size: .82rem; font-weight: 600; line-height: 1.4; }
  .feed-body small { display: block; margin-top: 4px; color: hsl(var(--muted-foreground)); font-size: .66rem; }
  .feed-row strong { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 6px; color: hsl(var(--muted-foreground)); font-size: .61rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .feed-row strong :global(svg) { width: 12px; height: 12px; color: hsl(var(--primary)); }
  .feed-row.held strong { color: hsl(var(--primary)); }
  .feed-note { display: flex; gap: 10px; align-items: center; padding: 13px 18px; border: 1px solid hsl(var(--primary) / .2); border-radius: 1rem; background: hsl(var(--primary) / .04); color: hsl(var(--muted-foreground)); font-size: .72rem; line-height: 1.5; }
  .feed-note :global(svg) { flex: 0 0 auto; width: 15px; height: 15px; color: hsl(var(--primary)); }

  .detail-section { padding: clamp(64px, 7vw, 96px) 0; border-top: 1px solid hsl(var(--border)); background: hsl(var(--background)); }
  .detail-eyebrow { margin: 0; color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .18em; line-height: 1.4; text-transform: uppercase; }
  .detail-heading { max-width: 760px; }
  .detail-heading.centered { margin-inline: auto; text-align: center; }
  .detail-heading h2, .product-cta h2 { margin: 16px 0 0; font-size: clamp(2.15rem, 4vw, 3.8rem); font-weight: 600; letter-spacing: -.055em; line-height: 1.04; text-wrap: balance; }
  .detail-heading h2 span, .product-cta h2 span { color: hsl(var(--primary)); }
  .detail-heading > p:last-child:not(.detail-eyebrow) { margin: 19px 0 0; color: hsl(var(--muted-foreground)); font-size: 1.04rem; line-height: 1.7; }

  .fit-grid, .market-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 44px; }
  .fit-grid article, .market-grid article { position: relative; min-width: 0; padding: 28px; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.25rem; background: hsl(var(--background)); transition: border-color .2s ease, transform .2s ease; }
  .fit-grid article::before, .market-grid article::before { position: absolute; inset: 0 0 auto; height: 3px; background: hsl(var(--primary)); transform: scaleX(0); transform-origin: left; transition: transform .22s ease; content: ""; }
  .fit-grid article:hover, .market-grid article:hover { border-color: hsl(var(--primary) / .45); transform: translateY(-4px); }
  .fit-grid article:hover::before, .market-grid article:hover::before { transform: scaleX(1); }
  .fit-grid article > span { color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .16em; }
  .fit-grid h3, .market-grid h3 { margin: 18px 0 0; font-size: 1.18rem; font-weight: 600; letter-spacing: -.025em; }
  .fit-grid p, .market-grid > article > p { margin: 12px 0 0; color: hsl(var(--muted-foreground)); font-size: .9rem; line-height: 1.65; }

  .commitments-section { background: hsl(var(--muted) / .3); }
  .commitments-layout { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(40px, 8vw, 112px); }
  .commitments-layout ul { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .commitments-layout li { display: grid; grid-template-columns: 22px 1fr; gap: 14px; padding: 20px; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--background)); color: hsl(var(--muted-foreground)); font-size: .92rem; line-height: 1.6; transition: border-color .2s ease, transform .2s ease; }
  .commitments-layout li:hover { border-color: hsl(var(--primary) / .45); transform: translateX(4px); }
  .commitments-layout li :global(svg) { width: 16px; height: 16px; margin-top: 4px; color: hsl(var(--primary)); }

  .markets-section + .economics-section { padding-top: 0; border-top: 0; }
  .market-grid dl { margin: 24px 0 0; border-top: 1px solid hsl(var(--border)); }
  .market-grid dl div { display: flex; justify-content: space-between; gap: 18px; padding: 10px 0; border-bottom: 1px solid hsl(var(--border)); font-size: .75rem; line-height: 1.4; }
  .market-grid dt { color: hsl(var(--muted-foreground)); }
  .market-grid dd { margin: 0; font-weight: 600; text-align: right; }
  .table-wrap { margin-top: 36px; overflow-x: auto; border: 1px solid hsl(var(--border)); border-radius: 1.25rem; }
  table { width: 100%; min-width: 660px; border-collapse: collapse; text-align: left; }
  th, td { padding: 15px 18px; border-bottom: 1px solid hsl(var(--border)); font-size: .82rem; }
  th { background: hsl(var(--muted) / .45); color: hsl(var(--foreground)); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  td { color: hsl(var(--muted-foreground)); }
  tbody tr:last-child td { border-bottom: 0; }
  .table-note { margin: 14px 0 0; color: hsl(var(--muted-foreground)); font-size: .72rem; line-height: 1.55; }

  .pipeline-section { background: hsl(var(--muted) / .3); }
  .pipeline-section ol { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin: 44px 0 0; padding: 0; list-style: none; }
  .pipeline-section li { min-width: 0; padding: 24px; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--background)); }
  .pipeline-section li > span { color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .16em; }
  .pipeline-section li p { margin: 24px 0 0; font-size: .92rem; font-weight: 600; line-height: 1.45; }

  .product-cta { padding: clamp(78px, 9vw, 124px) 0; border-top: 1px solid hsl(var(--border)); background: hsl(var(--background)); text-align: center; }
  .product-cta .container-x { max-width: 900px; }
  .product-cta > div > p:not(.detail-eyebrow) { max-width: 660px; margin: 22px auto 0; color: hsl(var(--muted-foreground)); font-size: 1.03rem; line-height: 1.7; }
  .product-cta .btn { margin-top: 28px; }

  @media (max-width: 900px) {
    .fit-grid, .market-grid { grid-template-columns: 1fr; }
    .commitments-layout { grid-template-columns: 1fr; }
    .pipeline-section ol { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .feed-row { flex-wrap: wrap; padding: 12px; }
    .feed-row strong { margin-left: 48px; }
    .feed-note { align-items: flex-start; padding: 12px; }
    .detail-section { padding: 64px 0; }
    .fit-grid article, .market-grid article { padding: 24px 20px; }
    .pipeline-section ol { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fit-grid article, .market-grid article, .fit-grid article::before, .market-grid article::before, .commitments-layout li { transition: none; }
    .fit-grid article:hover, .market-grid article:hover, .commitments-layout li:hover { transform: none; }
  }
</style>
