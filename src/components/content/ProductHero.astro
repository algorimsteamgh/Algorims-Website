---
import type { CollectionEntry } from "astro:content";
import ProductDetails from "./ProductDetails.astro";

interface Props { entry: CollectionEntry<"products"> }
const { entry } = Astro.props;
const productNames: Record<string, string> = {
  cxiq: "CXIQ",
  dociq: "DocIQ",
  opsiq: "OpsIQ",
  payiq: "PayIQ",
};
const heroTitles: Record<string, [string, string]> = {
  cxiq: ["Every conversation handled.", "Every dollar approved."],
  dociq: ["Documents in.", "Decisions out."],
  opsiq: ["Tickets in.", "Resolutions out."],
  payiq: ["Your invoices post themselves.", "Safely."],
};
const [heroTitle, heroAccent] = heroTitles[entry.id] ?? [entry.data.title, ""];
---

<header class="product-hero" aria-labelledby="product-title">
  <div class="container-x">
    <a class="back-link" href="/products"><i data-lucide="arrow-left" aria-hidden="true" /> All products</a>
    <div class="hero-copy">
      <p class="product-kicker"><i data-lucide={entry.data.glyph} aria-hidden="true" /> Algorims {productNames[entry.id]}</p>
      <h1 id="product-title">{heroTitle} {heroAccent && <span>{heroAccent}</span>}</h1>
      <p class="product-subtitle">{entry.data.subtitle}</p>
      <div class="product-actions">
        <a href="/contact" class="btn btn-hero btn-lg">Talk to our team <i data-lucide="arrow-right" aria-hidden="true" /></a>
        <a href="#workflow" class="btn btn-outline btn-lg">See how it works</a>
      </div>
    </div>
    <div class="hero-demonstration">
      <ProductDetails slug={entry.id} part="feed" />
    </div>
    <dl class="product-proof" aria-label={`${productNames[entry.id]} key outcomes`}>
      {entry.data.metrics.map((metric) => (
        <div><dt>{metric.value}</dt><dd>{metric.label}</dd></div>
      ))}
    </dl>
  </div>
</header>

<style>
  .product-hero { position: relative; padding: 18px 0 0; overflow: hidden; border-bottom: 1px solid hsl(var(--border)); background: hsl(var(--background)); }
  .product-hero::before { position: absolute; inset: 0; background-image: linear-gradient(45deg, transparent 49.5%, hsl(var(--grid-line) / .45) 50%, transparent 50.5%); background-size: 42px 42px; opacity: .35; mask-image: linear-gradient(to bottom, black, transparent 52%); pointer-events: none; content: ""; }
  .product-hero > .container-x { position: relative; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; color: hsl(var(--muted-foreground)); font-size: .84rem; font-weight: 600; text-decoration: none; }
  .back-link:hover { color: hsl(var(--primary)); }
  .back-link :global(svg) { width: 15px; height: 15px; }
  .hero-copy { max-width: 970px; margin: 24px auto 30px; text-align: center; }
  .product-kicker { display: inline-flex; align-items: center; gap: 9px; margin: 0 0 20px; color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  .product-kicker :global(svg) { width: 17px; height: 17px; stroke-width: 1.8; }
  h1 { margin: 0; font-size: clamp(2.75rem, 5.8vw, 5.15rem); font-weight: 600; letter-spacing: -.065em; line-height: .98; text-wrap: balance; }
  h1 span { color: hsl(var(--primary)); }
  .product-subtitle { max-width: 760px; margin: 20px auto 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.3vw, 1.13rem); line-height: 1.65; text-wrap: balance; }
  .product-actions { display: flex; justify-content: center; gap: 12px; margin-top: 22px; }
  .hero-demonstration { position: relative; max-width: 1060px; margin: 0 auto; padding: 20px; border: 1px solid hsl(var(--border)); border-radius: 1.25rem; background: hsl(var(--background)); }
  .product-proof { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1060px; margin: 14px auto 30px; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.25rem; background: hsl(var(--background)); }
  .product-proof div { min-width: 0; padding: 22px 20px; text-align: center; transition: background .2s ease; }
  .product-proof div + div { border-left: 1px solid hsl(var(--border)); }
  .product-proof div:hover { background: hsl(var(--primary) / .045); }
  .product-proof dt { color: hsl(var(--primary)); font-size: clamp(1.45rem, 2.4vw, 2.15rem); font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -.035em; line-height: 1.1; }
  .product-proof dd { max-width: 190px; margin: 8px auto 0; color: hsl(var(--muted-foreground)); font-size: .76rem; line-height: 1.45; }
  @media (max-width: 800px) {
    .hero-copy { margin-top: 36px; }
    .hero-demonstration { padding: 18px; }
    .product-proof { grid-template-columns: repeat(2, 1fr); }
    .product-proof div:nth-child(3) { border-left: 0; border-top: 1px solid hsl(var(--border)); }
    .product-proof div:nth-child(4) { border-top: 1px solid hsl(var(--border)); }
  }
  @media (max-width: 600px) {
    .product-hero { padding-top: 18px; }
    .hero-copy { margin: 30px auto 38px; }
    h1 { font-size: 2.65rem; }
    .product-actions { flex-direction: column; }
    .hero-demonstration { padding: 12px; }
    .product-proof { margin-bottom: 28px; }
    .product-proof div { padding: 20px 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .product-proof div { transition: none; } }
</style>
