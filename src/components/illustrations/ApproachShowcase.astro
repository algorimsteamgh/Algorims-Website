---
import VisualShowcase from "../VisualShowcase.astro";

const steps = [
  {
    name: "Discover",
    image: "discover",
    title: "Find the bottleneck.",
    description: "We trace how work moves through your teams, systems, and data to see where it slows down and which changes would matter most.",
    alt: "Business goals, existing systems, and operating data converge into a roadmap.",
    outcome: "A prioritised roadmap",
  },
  {
    name: "Design",
    image: "design",
    title: "Build around the workflow.",
    description: "We design the architecture, connect the services it needs, and build around the constraints your teams face every day.",
    alt: "Workflows, AI agents, and cloud services connect into a system design.",
    outcome: "A system built for your workflows",
  },
  {
    name: "Deploy",
    image: "deploy",
    title: "Ship it. Then measure it.",
    description: "We release to production, track performance against your goals, and use live data to decide what to improve next.",
    alt: "Deployment, monitoring, and security controls support a measurable production system.",
    outcome: "A live system with measurable results",
  },
];
---
<VisualShowcase
  id="approach"
  label="How we work"
  items={steps.map(({ image, ...step }) => ({
    ...step,
    lightImage: `/assets/illustrations/approach-${image}.webp`,
    darkImage: `/assets/illustrations/approach-${image}-dark.webp`,
  }))}
  imageSize={{ light: [1536, 1024], dark: [1536, 1024] }}
/>
