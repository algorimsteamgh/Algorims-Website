---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Algorims" description="The page you requested could not be found. Browse Algorims services or get in touch." robots="noindex, follow">
  <section class="container-x py-24 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">404 · Page not found</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">We couldn't find that page.</h1>
    <p class="mx-auto mt-4 max-w-lg text-muted-foreground">The address may have changed, or the page may no longer be available.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-hero btn-lg">Go home <i data-lucide="arrow-right" class="!h-4 !w-4"></i></a>
      <a href="/services" class="btn btn-outline btn-lg">Explore services</a>
      <a href="/contact" class="btn btn-outline btn-lg">Contact us</a>
    </div>
  </section>
</BaseLayout>
