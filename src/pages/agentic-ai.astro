<script>
  const viewer = document.getElementById('hero-spline');
  const loader = document.getElementById('spline-loader');
  if (viewer && loader) {
    const hideLoader = () => {
      loader.style.opacity = '0';
      setTimeout(() => loader.remove(), 700);
    };
    const stripWatermark = () => {
      const root = viewer.shadowRoot;
      if (!root) return;
      root.querySelectorAll("#logo, a[href*='spline'], #spline-logo, .spline-logo").forEach(item => item.remove());
    };
    const onLoad = () => { hideLoader(); stripWatermark(); };
    viewer.addEventListener('load', onLoad, { once: true });
    viewer.addEventListener('load-complete', onLoad, { once: true });
    const poll = setInterval(stripWatermark, 200);
    setTimeout(() => clearInterval(poll), 12000);
    setTimeout(hideLoader, 8000);
  }
</script>
