---
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentUseCaseArt from "../components/illustrations/AgentUseCaseArt.astro";

const problems = [
  ["Knowledge is buried", "Critical insights locked inside siloed systems and disconnected data sources — invisible to the people who need them most."],
  ["Operations are expensive", "Manual workflows and repetitive tasks consuming time, budget, and talent that should be focused on higher-value work."],
  ["Decisions are delayed", "Without real-time intelligence, leaders make critical decisions on outdated information — slowing growth and increasing risk."],
];
const capabilities = [
  ["Reason", "Mines your enterprise knowledge, decomposes complex operational problems, and plans multi-step actions — all without human prompting."],
  ["Act", "Connects to your APIs, tools, and enterprise systems to execute tasks, reduce manual workload, and deliver outcomes autonomously."],
  ["Remember", "Retains organisational knowledge, learned behaviours, and operational context across every session — getting smarter with every interaction."],
  ["Govern", "Enterprise-grade guardrails, cost controls, evaluation frameworks, and full observability — built in from day one."],
];
const useCases = [
  ["Autonomous customer operations", "Agents that triage, resolve, and escalate across channels with full auditability.", "/solutions/autonomous-customer-operations"],
  ["Intelligent document processing", "Reasoning agents that extract, validate, and act on enterprise documents end-to-end.", "/solutions/intelligent-document-processing"],
  ["Sales & revenue copilots", "Research accounts, draft tailored outreach, update CRM records, and schedule follow-ups.", null, "An agent can bring account context and recent interactions into one workflow, prepare a draft for review, then record approved activity in the CRM so the next step stays visible."],
  ["DevOps & SRE agents", "Detect incidents, diagnose failures, restore service, and record what happened.", null, "Connect alerts, deployment history, and runbooks so an agent can investigate the likely cause, take approved recovery steps, and leave an incident record for the team."],
  ["Knowledge agents", "Retrieve relevant records and answer questions with links to the source passages.", null, "Search across approved internal sources, surface the passages behind each answer, and make it easier for people to check the evidence before acting."],
  ["Supply chain orchestration", "Forecast demand from stock signals, plan replenishment, and coordinate delivery.", null, "Combine demand and inventory signals to flag gaps early, propose replenishment, and pass approved plans to the systems that coordinate suppliers and delivery."],
];
const caseArt = [
  ["sales", "Account research and a CRM contact record feed an agent that drafts tailored outreach and updates the CRM."],
  ["devops", "Server alerts and deployment warnings feed an agent that diagnoses the issue, repairs it, and records the incident."],
  ["knowledge", "A question and internal records feed an agent that retrieves source passages and returns an answer with citations."],
  ["supply", "Demand trends and supplier stock feed an agent that plans replenishment and coordinates deliveries."],
] as const;
const caseLabels = [
  [["Inputs", "Voice · Chat"], ["Agent", "Customer operations"], ["Outcome", "Resolved interactions"]],
  [["Inputs", "Business documents"], ["Agent", "Document processing"], ["Outcome", "Validated information"]],
  [["Inputs", "Accounts · CRM"], ["Agent", "Revenue copilot"], ["Outcome", "Prepared outreach"]],
  [["Inputs", "Alerts · Deployments"], ["Agent", "SRE operations"], ["Outcome", "Restored service"]],
  [["Inputs", "Questions · Records"], ["Agent", "Knowledge retrieval"], ["Outcome", "Cited answers"]],
  [["Inputs", "Demand · Stock"], ["Agent", "Supply planning"], ["Outcome", "Coordinated delivery"]],
];
const services = [
  ["Amazon Nova", "Foundation model family", "Frontier multimodal reasoning — purpose-built for fast, cost-effective agentic workloads at enterprise scale."],
  ["Amazon Kendra", "Intelligent enterprise search", "Natural-language retrieval across every system of record — turning siloed documents into instant, governed answers."],
  ["Amazon S3 Vectors", "Native vector storage", "Massive-scale embeddings on durable S3 storage — semantic memory for agents without the cost of a separate database."],
  ["AWS Bedrock", "Managed model platform", "Model-agnostic by design. Anthropic, Nova, Llama, Mistral and more — orchestrated through a single, secure API."],
  ["Amazon SageMaker", "Custom ML & fine-tuning", "Train, tune, and host domain-specific models — closing the gap between generic intelligence and your unique data."],
  ["Amazon Textract", "Document AI", "Extract structured signal from contracts, forms and scans — the connective tissue between paperwork and autonomous workflows."],
];
const steps = [
  ["Discover", "Week 1", "We immerse in your business — understanding goals, challenges, and where AI can create the most value."],
  ["Architect", "Week 2", "We design your agentic AI blueprint — selecting the right AWS services, agents, and workflows for your needs."],
  ["Build & Deploy", "Weeks 3–8", "Our engineers build, test, and deploy production-grade AI agents — fast, precise, and built to last."],
  ["Optimise", "Ongoing", "We continuously monitor and improve your systems — ensuring they get smarter and more valuable over time."],
];
const outcomes = [
  ["40–80%", "Reduction in handling time"],
  ["3–10×", "Throughput on knowledge work"],
  ["24/7", "Always-on operations"],
  ["100%", "Auditable decision trails"],
];
const architecture = [
  ["Model & vendor agnostic", "Bedrock, OpenAI, Anthropic, open-source — composable by design."],
  ["Safety & governance", "Policy guardrails, evaluation, and red-teaming workflows."],
  ["Tool & API orchestration", "Plug agents into your existing systems of record and APIs."],
];
---

<BaseLayout title="Agentic AI — Algorims" description="Beyond automation: Algorims builds agentic AI systems that reason, decide, and act autonomously on Amazon Nova, Kendra and S3 Vectors.">
  <div class="agentic-page">
    <section class="hero" aria-labelledby="agentic-title"><div class="container-x">
      <p class="eyebrow">Agentic AI Practice</p>
      <h1 id="agentic-title">Beyond automation. Towards<br /><span>Intelligent autonomy.</span></h1>
      <p class="hero-copy">We build AI agents that connect enterprise knowledge to action. They reason across your data, use your tools, and automate operational work with clear controls.</p>
      <div class="actions"><a class="btn btn-hero btn-lg" href="/contact">Talk to our AI team</a><a class="btn btn-outline btn-lg" href="/case-studies">See agentic case studies</a></div>
    </div></section>

    <section class="section" aria-labelledby="problem-title"><div class="container-x problem-layout">
      <div class="problem-intro"><p class="eyebrow">The challenge</p><h2 id="problem-title">Enterprise knowledge is <span>hard to use.</span></h2><p>Data, documents, and operational workflows sit across disconnected systems. Teams spend time finding information, processing documents, and repeating tasks before they can act.</p></div>
      <div class="problem-rows">{problems.map(([title, description]) => <article><h3>{title}</h3><p>{description}</p></article>)}</div>
    </div></section>

    <section class="section" id="how-it-works" aria-labelledby="capabilities-title"><div class="container-x">
      <div class="section-heading"><p class="eyebrow">What is Agentic AI</p><h2 id="capabilities-title">Solution that <span>mines, decides, and acts for your business</span></h2><p>Agentic AI pairs a powerful reasoning engine with your enterprise knowledge — continuously mining insights, reducing operational workload, and taking autonomous action to drive measurable business outcomes.</p></div>
      <div class="capability-grid">{capabilities.map(([title, description]) => <article><div><h3>{title}</h3><p>{description}</p></div><span class="capability-mark" aria-hidden="true">↗</span></article>)}</div>
    </div></section>

    <section class="section use-cases" aria-labelledby="use-cases-title"><div class="container-x">
      <div class="section-heading"><p class="eyebrow">Use cases</p><h2 id="use-cases-title">Where agents <span>help teams act.</span></h2><p>Six ways connected agents can put enterprise knowledge to work across operations.</p></div>
      <div class="case-showcase">
      <div class="case-picker" role="tablist" aria-label="Choose a use case">{useCases.map(([title], index) =>
        <button type="button" role="tab" id={`case-tab-${index}`} aria-controls={`case-panel-${index}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>{title}</button>)}</div>
      <div class="featured-cases">{useCases.map(([title, description, href, more], index) =>
        <article class="featured-case" id={`case-panel-${index}`} role="tabpanel" aria-labelledby={`case-tab-${index}`} data-index={index}>
          <div class="featured-copy"><h3>{title.slice(0, title.lastIndexOf(" "))} <span>{title.slice(title.lastIndexOf(" ") + 1)}</span></h3><p>{description}</p>{href ? <a href={href}>Read more <i data-lucide="arrow-right" class="!h-4 !w-4" /></a> : <details><summary><span class="when-closed">Read more</span><span class="when-open">Read less</span><i data-lucide="arrow-right" class="!h-4 !w-4" /></summary><p>{more}</p></details>}</div>
          {index < 2 ?
            <figure>
              <img class="case-art-light" src={index === 0 ? "/assets/illustrations/solution-autonomous-customer-operations.webp" : "/assets/illustrations/solution-intelligent-document-processing.webp"} alt={index === 0 ? "Voice and chat inputs connect through an autonomous customer operations system to resolved interactions." : "Business documents flow through an intelligent processing system to validated information."} width="1254" height="1254" loading="lazy" />
              <img class="case-art-dark" src={index === 0 ? "/assets/illustrations/solution-autonomous-customer-operations-dark.webp" : "/assets/illustrations/solution-intelligent-document-processing-dark.webp"} alt="" aria-hidden="true" width="1254" height="1254" loading="lazy" />
              <figcaption>{caseLabels[index].map(([label, value]) => <span><b>{label}</b>{value}</span>)}</figcaption>
            </figure> :
            <figure class="generated-art"><AgentUseCaseArt kind={caseArt[index - 2][0]} description={caseArt[index - 2][1]} /><figcaption>{caseLabels[index].map(([label, value]) => <span><b>{label}</b>{value}</span>)}</figcaption></figure>}
        </article>)}</div></div>
    </div></section>

    <section class="section" aria-labelledby="stack-title"><div class="container-x">
      <div class="stack-layout"><div class="stack-intro"><p class="eyebrow">Our AWS AI stack</p><h2 id="stack-title">AWS services for <span>production agents.</span></h2><p>We select the services each system needs for search, reasoning, storage, and document processing.</p></div>
      <div class="stack-list">{services.map(([title, category, description]) => <article><p class="service-category">{category}</p><h3>{title}</h3><p>{description}</p></article>)}</div></div>
    </div></section>

    <section class="section delivery" aria-labelledby="delivery-title"><div class="container-x">
      <div class="section-heading"><p class="eyebrow">How We Deliver It</p><h2 id="delivery-title">From first conversation to <span>autonomous operation</span>.</h2><p>A senior, hands-on delivery model — measured in weeks, not quarters — purpose-built to take agentic AI from blueprint to production with minimal disruption to your teams.</p></div>
      <ol>{steps.map(([title, period, description], index) => <li><span class="item-number">0{index + 1}</span><h3>{title}</h3><span class="period">{period}</span><p>{description}</p></li>)}</ol>
    </div></section>

    <section class="section" aria-labelledby="value-title"><div class="container-x value-grid">
      <div><p class="eyebrow">Enterprise value</p><h2 id="value-title">More capacity for <span>higher-value work.</span></h2><p>Connected agents can reduce repetitive work, improve response times, and make decisions easier to trace.</p></div>
      <div class="outcome-grid">{outcomes.map(([figure, label]) => <div><strong data-counter>{figure}</strong><p>{label}</p></div>)}</div>
    </div></section>

    <section class="section architecture-section" aria-labelledby="architecture-title"><div class="container-x"><div class="architecture-grid">
      <div><p class="eyebrow">Future-ready architecture</p><h2 id="architecture-title">Built on a reference architecture for <span>production agents</span>.</h2><p>Model-agnostic. Tool-rich. Observable by default. Our reference architecture brings together planning, memory, evaluation, and governance — so you ship agents you can trust.</p></div>
      <div class="architecture-layers">{architecture.map(([title, description]) => <div><strong>{title}</strong><p>{description}</p></div>)}</div>
    </div>
    </div></section>
  </div>
</BaseLayout>


<style>
.agentic-page { background: hsl(var(--background)); color: hsl(var(--foreground)); }
.agentic-page h1, .agentic-page h2, .agentic-page h3 { margin: 0; font-weight: 600; letter-spacing: -.05em; }
.agentic-page h1 { font-size: clamp(2.7rem, 5.2vw, 4.8rem); line-height: 1; letter-spacing: -.06em; }
.agentic-page h2 { max-width: 850px; font-size: clamp(2.2rem, 3.7vw, 3.7rem); line-height: 1.06; text-wrap: balance; }
.agentic-page h3 { font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.2; }
.agentic-page p { line-height: 1.65; }
.agentic-page h1 span, .agentic-page h2 span { color: hsl(var(--primary)); }
.eyebrow, .item-number { color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .18em; line-height: 1.4; text-transform: uppercase; }
.eyebrow { margin: 0 0 18px; }
.section { padding: clamp(64px, 7vw, 96px) 0; border-top: 1px solid hsl(var(--border)); }
.section-heading, .problem-intro, .stack-intro, .value-grid > div:first-child { max-width: 850px; margin: 0 auto 46px; text-align: center; }
.section-heading h2, .problem-intro h2, .stack-intro h2, .value-grid h2, .architecture-grid h2 { margin-inline: auto; }
.section-heading > p:last-child, .problem-intro > p:last-child, .stack-intro > p:last-child, .value-grid > div:first-child > p:last-child, .architecture-grid > div:first-child > p:last-child { max-width: 720px; margin: 22px auto 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.4vw, 1.15rem); }

.hero { padding: 48px 0; text-align: center; }
.hero + .section { padding-top: 48px; }
.hero h1 { max-width: 1050px; margin: 0 auto; }
.hero-copy { max-width: 790px; margin: 25px auto 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.4vw, 1.15rem); text-wrap: balance; }
.actions { display: flex; justify-content: center; gap: 14px; margin-top: 28px; }
.hero .btn-outline { color: hsl(var(--foreground)); }

.problem-rows { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; border-top: 1px solid hsl(var(--border)); counter-reset: problem; }
.problem-rows article { position: relative; padding: 58px 18px 20px 0; counter-increment: problem; transition: transform .2s ease; }
.problem-rows article::before { position: absolute; top: 22px; left: 0; color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .16em; content: "0" counter(problem); }
.problem-rows article:hover { transform: translateY(-4px); }
.problem-rows h3 { font-size: 1.25rem; }
.problem-rows p, .capability-grid p, .stack-list article p:last-child, .delivery li p, .architecture-layers p { margin: 9px 0 0; color: hsl(var(--muted-foreground)); font-size: 1rem; line-height: 1.65; }

.capability-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid hsl(var(--border)); border-radius: 1.25rem; counter-reset: capability; overflow: hidden; }
.capability-grid article { position: relative; display: flex; flex-direction: column; min-height: 250px; padding: 25px 26px 22px; counter-increment: capability; transition: background .2s ease; }
.capability-grid article + article { padding-left: 26px; border-left: 1px solid hsl(var(--border)); }
.capability-grid article::before { color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .16em; content: "0" counter(capability); }
.capability-grid article:hover { background: hsl(var(--primary) / .045); }
.capability-grid article > div { margin-top: auto; }
.capability-grid h3 { margin-top: 0; }
.capability-grid p { max-width: 260px; }
.capability-mark { position: absolute; top: 24px; right: 24px; color: hsl(var(--primary) / .5); font-size: 1.1rem; }

.use-cases { background: hsl(var(--secondary) / .28); }
.case-picker { display: none; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 26px; }
.is-enhanced .case-picker { display: grid; }
.case-picker button { position: relative; min-height: 56px; padding: 12px 16px; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: .9rem; background: hsl(var(--background)); color: hsl(var(--muted-foreground)); font: inherit; font-size: .95rem; font-weight: 600; text-align: left; cursor: pointer; transition: color .2s ease, border-color .2s ease, background .2s ease; }
.case-picker button:is(:hover, [aria-selected="true"]) { border-color: hsl(var(--primary) / .6); background: hsl(var(--primary) / .06); color: hsl(var(--primary)); }
.is-cycling .case-picker button[aria-selected="true"]::after { position: absolute; inset: 0; padding: 2px; border-radius: inherit; background: conic-gradient(from -90deg, hsl(var(--primary)) var(--case-progress), transparent 0); content: ""; pointer-events: none; -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; animation: case-ticker 4s linear forwards; }
@property --case-progress { syntax: "<angle>"; initial-value: 0deg; inherits: false; }
@keyframes case-ticker { to { --case-progress: 360deg; } }
.case-picker button:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 3px; }
.featured-cases { display: grid; gap: 22px; }
.is-enhanced .featured-cases { display: grid; grid-template-columns: minmax(0, 1fr); padding-top: 34px; }
.featured-case { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: clamp(28px, 3vw, 48px); min-height: 290px; padding: clamp(24px, 3vw, 38px); border: 1px solid hsl(var(--border)); border-radius: 1.5rem; background: hsl(var(--background)); transition: border-color .25s ease, transform .25s ease; }
.case-showcase:not(.is-enhanced) .featured-case:hover { border-color: hsl(var(--primary) / .4); transform: translateY(-3px); }
.is-enhanced .featured-case { grid-area: 1 / 1; min-height: 350px; transition: transform .6s cubic-bezier(.22, 1, .36, 1), opacity .4s ease, border-color .25s ease, visibility .4s; }
.is-enhanced .featured-case[data-slot="0"] { z-index: 3; opacity: 1; transform: translate(0, 0) scale(1); }
.is-enhanced .featured-case[data-slot="1"] { z-index: 2; opacity: .65; transform: translateY(-17px) scale(.97); }
.is-enhanced .featured-case[data-slot="2"] { z-index: 1; opacity: .35; transform: translateY(-34px) scale(.94); }
.is-enhanced .featured-case[data-slot="hidden"] { visibility: hidden; opacity: 0; transform: translateY(-42px) scale(.92); }
.is-enhanced .featured-case[data-slot="0"]:hover { border-color: hsl(var(--primary) / .4); }
.featured-case:nth-child(even) .featured-copy { order: 2; }
.featured-case:nth-child(even) figure { order: 1; }
.featured-copy { width: min(100%, 460px); margin: 0 auto; }
.featured-case h3 { max-width: 450px; font-size: clamp(1.7rem, 3vw, 2.5rem); }
.featured-case h3 span { color: hsl(var(--primary)); }
.featured-case p { max-width: 440px; margin: 18px 0 0; color: hsl(var(--muted-foreground)); font-size: 1.05rem; }
.featured-case a, .featured-case summary { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-top: 16px; color: hsl(var(--primary)); font-weight: 600; text-decoration: none; cursor: pointer; }
.featured-case summary { list-style: none; }
.featured-case summary::-webkit-details-marker { display: none; }
.featured-case a:hover, .featured-case summary:hover { text-decoration: underline; text-underline-offset: 4px; }
.featured-case :is(a, summary) :global(svg) { transition: transform .2s ease; }
.featured-case :is(a:hover, summary:hover) :global(svg), .featured-case details[open] :global(svg) { transform: translateX(4px); }
.featured-case .when-open, .featured-case details[open] .when-closed { display: none; }
.featured-case details[open] .when-open { display: inline; }
.featured-case details p { margin-top: 4px; font-size: .98rem; }
.featured-case figure { display: grid; grid-template-rows: 230px auto; gap: 12px; place-items: center; width: min(100%, 460px); margin: 0 auto; }
.featured-case img { display: block; grid-row: 1; width: min(100%, 340px); height: 230px; object-fit: contain; }
.featured-case figcaption { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; width: 100%; }
.featured-case figcaption span { min-width: 0; padding: 8px 10px; border: 1px solid hsl(var(--border)); border-radius: .65rem; color: hsl(var(--muted-foreground)); font-size: .66rem; line-height: 1.35; }
.featured-case figcaption b { display: block; margin-bottom: 3px; color: hsl(var(--primary)); font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; }
.featured-case .case-art-dark { display: none; }
:global(:root.dark) .featured-case .case-art-light { display: none; }
:global(:root.dark) .featured-case .case-art-dark { display: block; }

.stack-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 42px; border-top: 1px solid hsl(var(--border)); }
.stack-list article { padding: 22px 0 24px; border-bottom: 1px solid hsl(var(--border)); }
.stack-list h3 { margin-top: 3px; font-size: 1.4rem; }
.stack-list .service-category { margin: 0; color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.stack-list article p:last-child { max-width: 520px; margin-top: 9px; }

.delivery { background: hsl(var(--secondary) / .28); }
.delivery ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 26px; margin: 0; padding: 0; list-style: none; }
.delivery li { position: relative; padding: 32px 15px 0 0; border-top: 1px solid hsl(var(--border)); }
.delivery li::before { position: absolute; top: -5px; left: 0; width: 9px; height: 9px; background: hsl(var(--primary)); content: ""; }
.delivery h3 { margin-top: 23px; font-size: 1.4rem; }
.period { display: inline-block; margin-top: 8px; color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.delivery li p { margin-top: 16px; }

.outcome-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 42px; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
.outcome-grid div { min-height: 160px; padding: 30px 26px; transition: background .2s ease; }
.outcome-grid div:hover { background: hsl(var(--primary) / .045); }
.outcome-grid div + div { border-left: 1px solid hsl(var(--border)); }
.outcome-grid strong { color: hsl(var(--primary)); font-size: clamp(1.9rem, 3vw, 2.5rem); font-weight: 600; font-variant-numeric: tabular-nums; }
.outcome-grid p { max-width: 190px; margin: 8px 0 0; color: hsl(var(--muted-foreground)); font-size: .9rem; }

.architecture-grid > div:first-child { max-width: 850px; margin: 0 auto 42px; text-align: center; }
.architecture-grid > div:first-child > p:last-child { color: hsl(var(--muted-foreground)); }
.architecture-layers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; border-top: 1px solid hsl(var(--border)); }
.architecture-layers > div { padding: 24px 0; border-bottom: 1px solid hsl(var(--border)); }
.architecture-layers strong { font-size: 1.05rem; font-weight: 600; }
.architecture-layers p { margin: 9px 0 0; color: hsl(var(--muted-foreground)); font-size: .92rem; }

.agentic-page :is(a, summary):focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 4px; }

@media (prefers-reduced-motion: reduce) {
  .featured-case, .case-picker button, .featured-case :is(a, summary) :global(svg), .problem-rows article, .capability-grid article, .outcome-grid div { transition: none; }
  .featured-case:hover, .problem-rows article:hover, .featured-case :is(a:hover, summary:hover) :global(svg), .featured-case details[open] :global(svg) { transform: none; }
  .is-cycling .case-picker button[aria-selected="true"]::after { animation: none; }
}

@media (max-width: 950px) {
  .problem-rows, .architecture-layers { grid-template-columns: 1fr; gap: 0; }
  .problem-rows article { padding: 54px 0 22px; border-bottom: 1px solid hsl(var(--border)); }
  .capability-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .capability-grid article:nth-child(3) { padding-left: 0; border-left: 0; border-top: 1px solid hsl(var(--border)); }
  .capability-grid article:nth-child(4) { border-top: 1px solid hsl(var(--border)); }
  .outcome-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .outcome-grid div:nth-child(3) { border-left: 0; }
