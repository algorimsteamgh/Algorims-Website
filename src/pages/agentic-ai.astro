<script>
  function setupCaseShowcase() {
    const showcase = document.querySelector<HTMLElement>('.case-showcase');
    if (!showcase || showcase.dataset.ready) return;
    showcase.dataset.ready = 'true';

    const tabs = [...showcase.querySelectorAll<HTMLButtonElement>('.case-picker button')];
    const cards = [...showcase.querySelectorAll<HTMLElement>('.featured-case')];
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let visible = false;
    let timer: number | undefined;

    const stop = () => { clearInterval(timer); timer = undefined; showcase.classList.remove('is-cycling'); };
    const select = (index: number) => {
      active = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      cards.forEach((card, i) => {
        const slot = (i - index + cards.length) % cards.length;
        card.dataset.slot = slot < 3 ? String(slot) : 'hidden';
        card.inert = slot !== 0;
        card.setAttribute('aria-hidden', String(slot !== 0));
      });
    };
    const start = () => {
      stop();
      if (visible && !reducedMotion.matches && document.visibilityState === 'visible' && !showcase.matches(':hover') && !showcase.contains(document.activeElement) && !showcase.querySelector('.featured-case[data-slot="0"] details[open]')) {
        showcase.classList.add('is-cycling');
        timer = window.setInterval(() => select((active + 1) % cards.length), 4000);
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => { select(i); start(); });
      tab.addEventListener('keydown', (event) => {
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : event.key === 'ArrowRight' || event.key === 'ArrowDown' ? (active + 1) % tabs.length : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? (active - 1 + tabs.length) % tabs.length : -1;
        if (next < 0) return;
        event.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });
    showcase.addEventListener('mouseenter', stop);
    showcase.addEventListener('mouseleave', start);
    showcase.addEventListener('focusin', stop);
    showcase.addEventListener('focusout', () => requestAnimationFrame(start));
    showcase.addEventListener('toggle', start, true);
    reducedMotion.addEventListener('change', start);
    document.addEventListener('visibilitychange', start);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; start(); }, { threshold: .2 }).observe(showcase);

    select(0);
    showcase.classList.add('is-enhanced');
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupCaseShowcase);
  else setupCaseShowcase();
  document.addEventListener('astro:page-load', setupCaseShowcase);
</script>
