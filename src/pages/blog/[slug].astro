---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogArt from "../../components/blog/BlogArt.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import BlogBody from "../../components/content/BlogBody.astro";
import { getBlogPosts } from "../../components/blog/posts";

export const getStaticPaths = (async () => {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: posts.filter((other) => other.id !== post.id).slice(0, 3) },
  }));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props as {
  post: CollectionEntry<"blog">;
  related: CollectionEntry<"blog">[];
};
const titleWords = post.data.title.split(" ");
const titleAccent = titleWords.splice(-2).join(" ");
---
<BaseLayout title={`${post.data.title} — Algorims`} description={post.data.excerpt}>
  <section class="pt-8 pb-4">
    <div class="container-x">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-primary transition-colors">
        <i data-lucide="arrow-left" class="!w-4 !h-4"></i> All articles
      </a>
    </div>
  </section>

  <section class="pt-6 pb-10">
    <div class="container-x max-w-3xl">
      <div class="flex items-center gap-3 text-xs flex-wrap">
        <span class="rounded-full bg-primary/10 px-3 py-1 font-medium text-primary">{post.data.category}</span>
        <span class="flex items-center gap-1 text-muted-foreground"><i data-lucide="clock" class="!w-3 !h-3"></i> {post.data.read}</span>
      </div>
      <h1 class="mt-5 text-balance text-4xl font-semibold leading-[1.08] tracking-tight md:text-5xl">{titleWords.join(" ")} <span class="text-primary">{titleAccent}</span></h1>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground text-pretty">{post.data.excerpt}</p>
      <div class="mt-7 flex items-center gap-3 border-t border-b border-border py-4">
        <div class="grid h-10 w-10 place-items-center rounded-full bg-gradient-primary text-white text-xs font-bold">A</div>
        <div>
          <p class="text-sm font-semibold">{post.data.author}</p>
          <p class="text-xs text-muted-foreground">Algorims · Field notes</p>
        </div>
        <div class="ml-auto flex items-center gap-2">
          <button type="button" id="copy-blog-link" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted-foreground hover:text-primary hover:border-primary/40 transition-colors" aria-label="Copy link"><i data-lucide="link" class="!w-4 !h-4"></i></button>
          <a href="https://www.linkedin.com/company/algorims/" target="_blank" rel="noopener noreferrer" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted-foreground hover:text-primary hover:border-primary/40 transition-colors" aria-label="LinkedIn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43A2.06 2.06 0 1 1 5.34 3.3a2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.28V1.72C24 .77 23.2 0 22.22 0z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-10">
    <div class="container-x max-w-3xl">
      <div class="overflow-hidden rounded-3xl border border-border"><BlogArt kind={post.data.art} labeled /></div>
    </div>
  </section>

  <section class="pb-16">
    <div class="container-x max-w-3xl">
      <BlogBody body={post.data.body} />
      <div class="mt-14 rounded-3xl border border-border bg-secondary/30 p-8 md:p-10">
        <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-primary">Work with us</p>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight">Have a problem that looks like this one?</h3>
            <p class="mt-2 text-sm text-muted-foreground max-w-xl">Most of our engagements start with a 30-minute conversation. No slideware, no obligation.</p>
          </div>
          <a href="/contact" class="btn btn-primary btn-lg shrink-0">Get in touch <i data-lucide="arrow-right" class="!w-4 !h-4"></i></a>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-20 lg:pb-28">
    <div class="container-x">
      <div class="mb-8 flex items-end justify-between gap-4">
        <h3 class="text-2xl font-semibold tracking-tight">Keep reading</h3>
        <a href="/blog" class="text-sm font-medium text-primary inline-flex items-center gap-1">All articles <i data-lucide="arrow-right" class="!w-4 !h-4"></i></a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {related.map((other) => <BlogCard post={other} />)}
      </div>
    </div>
  </section>
  <script>
    document.getElementById("copy-blog-link")?.addEventListener("click", () => {
      void navigator.clipboard?.writeText(location.href);
    });
  </script>
</BaseLayout>
