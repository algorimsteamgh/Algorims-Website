---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyPage from "../../components/case-studies/CaseStudyPage.astro";

export async function getStaticPaths() {
  const entries = await getCollection("case-studies");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"case-studies"> };
---
<BaseLayout title={`${entry.data.title} — Algorims`} description={entry.data.subtitle}>
  <CaseStudyPage entry={entry} />
</BaseLayout>
