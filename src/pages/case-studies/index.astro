---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import caseScenes from "../../data/caseScenes.json";

const order = ["qsr-conversational-analytics", "ai-school-scheduler", "cicd-release-automation", "enterprise-knowledge-mining", "finance-document-automation", "syslatech-intelligent-document-processing", "smac-tech-labs-ai-support"];
const studies = (await getCollection("case-studies")).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---
<BaseLayout title="Case Studies — Algorims" description="Real-world results from Algorims — agentic AI, cloud, and data engineering case studies with measured business impact.">
  <section class="studies-hero" aria-labelledby="studies-title">
    <div class="container-x">
      <p class="studies-kicker">Case studies</p>
      <h1 id="studies-title">Complex operations. <span>Measurable outcomes.</span></h1>
      <p class="studies-intro">Explore the systems we have designed and delivered across agentic AI, data, cloud, and platform engineering.</p>
      <div class="studies-actions">
        <a class="btn btn-hero btn-lg" href="#selected-work">See the work</a>
        <a class="btn btn-outline btn-lg" href="/contact">Let's build together</a>
      </div>
      <dl class="studies-stats" aria-label="Case study overview">
        <div><dt data-counter>{studies.length}</dt><dd>Engagements documented</dd></div>
        <div><dt data-counter>4 weeks</dt><dd>Fastest path to production</dd></div>
        <div><dt data-counter>99.6%</dt><dd>Largest modelled cost reduction</dd></div>
      </dl>
    </div>
  </section>

  <div id="selected-work">
    {studies.map((study, index) => {
      const artwork = caseScenes[study.id as keyof typeof caseScenes];
      const highlights = study.data.metrics.filter(({ value }) => value !== "✓").slice(0, 4);
      const facts = highlights.length > 0 ? highlights.map(({ value, label }) => ({ value, label })) : study.data.meta.slice(0, 4).map(({ label, value }) => ({ value, label }));
      return <section class:list={["study-section", { alternate: index % 2 === 1 }]}>
        <div class="container-x">
          <div class="study-layout">
            <div class="study-copy">
              <p class="studies-kicker">Case study {String(index + 1).padStart(2, "0")} / {study.data.tag}</p>
              <div class="study-heading">
                <span class="study-icon" aria-hidden="true"><i data-lucide={study.data.glyph} /></span>
                <h2>{study.data.title}</h2>
              </div>
              <p class="study-description">{study.data.subtitle}</p>
              <dl class="study-highlights">
                {facts.map(({ value, label }) => <div><dt>{value}</dt><dd>{label}</dd></div>)}
              </dl>
              <a href={`/case-studies/${study.id}`} class="study-link">Read case study <i data-lucide="arrow-right" aria-hidden="true" /></a>
            </div>

            <aside class="study-figure-wrap">
              <a href={`/case-studies/${study.id}`} aria-label={`Read ${study.data.title}`}>
                <figure class="study-figure">
                  <img src={artwork.src} srcset={`${artwork.src.replace(".webp", "-600.webp")} 600w, ${artwork.src} 1200w`} sizes="(min-width: 1024px) 400px, 100vw" width="1200" height="675" alt={artwork.alt} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : undefined} />
                  <figcaption>{artwork.caption}</figcaption>
                </figure>
              </a>
            </aside>
          </div>
        </div>
      </section>;
    })}
  </div>
</BaseLayout>

<style>
  .studies-hero { padding: 46px 0 24px; text-align: center; }
  .studies-hero h1 { max-width: 1050px; margin: 0 auto; font-size: clamp(2.7rem, 5.2vw, 4.8rem); font-weight: 600; line-height: 1; letter-spacing: -.06em; text-wrap: balance; }
  .studies-hero h1 span { color: hsl(var(--primary)); }
  .studies-kicker { margin: 0 0 18px; color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .18em; line-height: 1.4; text-transform: uppercase; }
  .studies-intro { max-width: 720px; margin: 24px auto 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.65; text-wrap: balance; }
  .studies-actions { display: flex; justify-content: center; gap: 14px; margin-top: 26px; }
  .studies-stats { display: grid; grid-template-columns: repeat(3, 1fr); max-width: 960px; margin: 42px auto 0; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
  .studies-stats div { padding: 20px 12px; }
  .studies-stats div + div { border-left: 1px solid hsl(var(--border)); }
  .studies-stats dt { color: hsl(var(--foreground)); font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .studies-stats dd { margin-top: 6px; color: hsl(var(--muted-foreground)); font-size: .85rem; }
  .study-section { padding: 40px 0 56px; border-top: 1px solid hsl(var(--border)); }
  .study-section.alternate { background: hsl(var(--secondary) / .4); }
  .study-layout { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: 40px; }
  .study-section.alternate .study-figure-wrap { order: -1; }
  .study-heading { display: flex; align-items: flex-start; gap: 16px; }
  .study-icon { display: grid; width: 48px; height: 48px; flex: none; place-items: center; border-radius: 1rem; background: hsl(var(--primary) / .1); color: hsl(var(--primary)); }
  .study-icon :global(svg) { width: 24px; height: 24px; }
  .study-heading h2 { max-width: 820px; margin: 0; font-size: clamp(2rem, 3.2vw, 3.2rem); font-weight: 600; line-height: 1.08; letter-spacing: -.05em; text-wrap: balance; }
  .study-description { max-width: 760px; margin: 22px 0 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.25vw, 1.1rem); line-height: 1.65; }
  .study-highlights { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 28px; max-width: 760px; margin: 26px 0 0; }
  .study-highlights div { padding-top: 14px; border-top: 1px solid hsl(var(--border)); }
  .study-highlights dt { color: hsl(var(--primary)); font-size: 1rem; font-weight: 700; }
  .study-highlights dd { margin: 5px 0 0; color: hsl(var(--muted-foreground)); font-size: .82rem; line-height: 1.45; }
  .study-link { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; margin-top: 22px; color: hsl(var(--primary)); font-weight: 600; transition: gap .2s ease; }
  .study-link:hover { gap: 12px; }
  .study-link :global(svg) { width: 16px; height: 16px; }
  .study-figure-wrap { width: 100%; justify-self: end; }
  .study-section.alternate .study-figure-wrap { justify-self: start; }
  .study-figure { margin: 0; padding: 10px; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.25rem; background: hsl(var(--background)); }
  .study-figure img { display: block; width: 100%; height: auto; border-radius: 1rem; transition: transform .25s ease; }
  .study-figure figcaption { padding: 10px 4px 2px; color: hsl(var(--muted-foreground)); font-size: .72rem; line-height: 1.45; }
  .study-figure-wrap a:hover img { transform: scale(1.015); }
  @media (max-width: 1023px) {
    .study-layout { grid-template-columns: 1fr; }
    .study-section.alternate .study-figure-wrap { order: initial; }
    .study-figure-wrap, .study-section.alternate .study-figure-wrap { max-width: 620px; justify-self: start; }
  }
  @media (max-width: 600px) {
    .studies-hero { padding-top: 44px; }
    .studies-hero h1 { font-size: 2.4rem; }
    .studies-actions { flex-direction: column; }
    .studies-stats { grid-template-columns: 1fr; margin-top: 32px; }
    .studies-stats div + div { border-top: 1px solid hsl(var(--border)); border-left: 0; }
    .study-section { padding: 48px 0; }
    .study-heading { display: block; }
    .study-heading h2 { margin-top: 16px; font-size: 2rem; }
    .study-highlights { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .study-link, .study-figure img { transition: none; }
    .study-figure-wrap a:hover img { transform: none; }
  }
</style>
