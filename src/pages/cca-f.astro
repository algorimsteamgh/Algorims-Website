<script>
  const notice = document.querySelector<HTMLElement>('[data-ccaf-notice]');
  try {
    if (localStorage.getItem('algorims-ccaf-notice-dismissed') === '1') notice?.remove();
  } catch { /* Storage may be unavailable. */ }

  function toggleDomain(index: string, openOnly = false) {
    const panel = document.querySelector<HTMLElement>(`[data-ccaf-panel="${index}"]`);
    if (!panel) return;
    const wasOpen = !panel.classList.contains('hidden');
    document.querySelectorAll<HTMLElement>('[data-ccaf-panel]').forEach(item => item.classList.add('hidden'));
    document.querySelectorAll<HTMLElement>('[data-ccaf-chevron]').forEach(item => item.style.transform = '');
    document.querySelectorAll<HTMLElement>('[data-toggle-domain]').forEach(item => item.setAttribute('aria-expanded', 'false'));
    if (!wasOpen || openOnly) {
      panel.classList.remove('hidden');
      document.querySelector<HTMLElement>(`[data-ccaf-chevron="${index}"]`)?.style.setProperty('transform', 'rotate(180deg)');
      document.querySelector<HTMLElement>(`[data-toggle-domain="${index}"]`)?.setAttribute('aria-expanded', 'true');
    }
  }

  function activate(target: HTMLElement) {
    if (target.matches('[data-dismiss-notice]')) {
      try { localStorage.setItem('algorims-ccaf-notice-dismissed', '1'); } catch { /* Storage may be unavailable. */ }
      notice?.remove();
    } else if (target.matches('[data-toggle-domain]')) {
      toggleDomain(target.dataset.toggleDomain!);
    } else if (target.matches('[data-open-domain]')) {
      const index = target.dataset.openDomain!;
      toggleDomain(index, true);
      const button = document.querySelector<HTMLElement>(`[data-toggle-domain="${index}"]`);
      if (button) {
        button.style.scrollMarginTop = '7rem';
        button.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    } else if (target.matches('[data-scroll-scenario]')) {
      document.getElementById(`scenario-${target.dataset.scrollScenario}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  const controls = '[data-dismiss-notice], [data-toggle-domain], [data-open-domain], [data-scroll-scenario]';
  document.addEventListener('click', event => {
    const target = (event.target as Element).closest<HTMLElement>(controls);
    if (target) activate(target);
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const target = (event.target as Element).closest<HTMLElement>('[data-open-domain], [data-scroll-scenario]');
    if (target) {
      event.preventDefault();
      activate(target);
    }
  });
</script>
