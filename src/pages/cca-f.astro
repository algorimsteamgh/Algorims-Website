---
import BaseLayout from "../layouts/BaseLayout.astro";

const domains = [
  {
    name: "Agentic Architecture & Orchestration", weight: 27,
    summary: "Agentic loops, coordinator and subagent patterns, task decomposition, and session state.",
    tasks: ["Design and implement agentic loops", "Orchestrate multi-agent systems", "Configure subagent invocation and context passing", "Implement multi-step workflows with enforcement", "Apply Agent SDK hooks", "Design task decomposition strategies", "Manage session state, resumption, and forking"],
  },
  {
    name: "Tool Design & MCP Integration", weight: 18,
    summary: "Tool interfaces, structured errors, MCP servers, and tool access across agents.",
    tasks: ["Design effective tool interfaces", "Implement structured error responses for MCP tools", "Distribute tools across agents and configure tool choice", "Integrate MCP servers into Claude Code and agent workflows", "Select and apply built-in tools effectively"],
  },
  {
    name: "Claude Code Configuration & Workflows", weight: 20,
    summary: "CLAUDE.md, reusable commands and skills, plan mode, and CI/CD workflows.",
    tasks: ["Configure CLAUDE.md files with hierarchy and modular organisation", "Create and configure custom slash commands and skills", "Apply path-specific rules for conditional convention loading", "Determine when to use plan mode vs direct execution", "Apply iterative refinement techniques", "Integrate Claude Code into CI/CD pipelines"],
  },
  {
    name: "Prompt Engineering & Structured Output", weight: 20,
    summary: "Clear criteria, few-shot prompts, JSON schemas, validation, and review passes.",
    tasks: ["Design prompts with explicit criteria to reduce false positives", "Apply few-shot prompting for consistency and quality", "Enforce structured output using tool use and JSON schemas", "Implement validation, retry, and feedback loops", "Design efficient batch processing strategies", "Design multi-instance and multi-pass review architectures"],
  },
  {
    name: "Context Management & Reliability", weight: 15,
    summary: "Long-running context, escalation, error propagation, and uncertainty.",
    tasks: ["Manage conversation context across long interactions", "Design escalation and ambiguity resolution patterns", "Implement error propagation strategies across multi-agent systems", "Manage context in large codebase exploration"],
  },
];

const splitTitle = (title: string) => {
  const words = title.split(" ");
  let cut = words.length - 2;
  if (words[cut] === "&") cut--;
  return [words.slice(0, cut).join(" "), words.slice(cut).join(" ")];
};

const scenarios = [
  ["Support automation", "Design an agent that resolves requests, calls tools, and escalates when confidence is low.", "1 · 2 · 5"],
  ["Developer workflow", "Configure Claude Code, team conventions, and context management for codebase work.", "3 · 5"],
  ["Research orchestration", "Coordinate specialist agents, tool access, source handling, and synthesis.", "1 · 2 · 5"],
  ["Productivity automation", "Choose tool boundaries, prompts, and workflows for repeated knowledge work.", "1 · 2 · 3"],
  ["CI/CD assistance", "Use structured output, review criteria, and non-interactive execution in pipelines.", "3 · 4"],
  ["Document extraction", "Design schemas, validation, retries, and reliable context use for messy inputs.", "4 · 5"],
];

const registration = [
  ["Request certification access", "https://anthropic-partners.skilljar.com/claude-certified-architect-foundations-access-request"],
  ["Take the certification", "https://anthropic-partners.skilljar.com/claude-certified-architect-foundations-certification"],
  ["Schedule with Pearson VUE", "https://pearsonvue.com/us/en/anthropic"],
];
const foundations = [
  ["Anthropic Academy", "https://www.anthropic.com/learn"],
  ["AI Fluency: Framework & Foundations", "https://anthropic.skilljar.com/ai-fluency-framework-foundations"],
  ["Claude 101", "https://anthropic.skilljar.com/claude-101"],
  ["Building with the Claude API", "https://anthropic.skilljar.com/claude-with-the-anthropic-api"],
  ["Claude with Amazon Bedrock", "https://anthropic.skilljar.com/claude-in-amazon-bedrock"],
  ["Claude with Google Cloud Vertex AI", "https://anthropic.skilljar.com/claude-with-google-vertex"],
];
const advanced = [
  ["Introduction to Model Context Protocol", "https://anthropic.skilljar.com/introduction-to-model-context-protocol"],
  ["Model Context Protocol: Advanced Topics", "https://anthropic.skilljar.com/model-context-protocol-advanced-topics"],
  ["Claude Code in Action", "https://anthropic.skilljar.com/claude-code-in-action"],
  ["Claude API documentation", "https://docs.anthropic.com"],
  ["Claude Code documentation", "https://docs.anthropic.com/en/docs/claude-code"],
  ["MCP specification", "https://modelcontextprotocol.io"],
  ["Claude Agent SDK", "https://docs.anthropic.com/en/docs/claude-code/sdk"],
];
---

<BaseLayout title="CCA-F — Algorims" description="An independent guide to the Claude Certified Architect Foundations exam: domains, practice scenarios, and official study resources.">
  <div class="ccaf">
    <section class="ccaf-hero" aria-labelledby="ccaf-title">
      <p class="ccaf-kicker">Claude Certified Architect Foundations / CCA-F</p>
      <h1 id="ccaf-title">A clearer path to <span class="ccaf-accent">Claude architecture.</span></h1>
      <p class="ccaf-lede">The exam covers the decisions behind production Claude systems. See what it assesses, where to focus, and which official resources to use.</p>
      <div class="ccaf-actions">
        <a class="ccaf-action primary" href="#domains">Explore the domains →</a>
        <a class="ccaf-action" href="#resources">Find study resources</a>
      </div>
      <p class="ccaf-note">Independent study overview. Algorims is not affiliated with or endorsed by Anthropic; trademarks belong to their owners.</p>
    </section>

    <section class="ccaf-facts" aria-label="Exam at a glance">
      <div><strong data-counter>60</strong><span>multiple-choice questions</span></div>
      <div><strong data-counter>120 min</strong><span>exam duration</span></div>
      <div><strong data-counter>5</strong><span>weighted domains</span></div>
      <div><strong>$<span data-counter>125</span></strong><span>per attempt</span></div>
    </section>

    <section class="ccaf-section ccaf-intro" aria-labelledby="ccaf-overview">
      <div>
        <p class="ccaf-kicker">01 / The overview</p>
        <h2 id="ccaf-overview">Know the exam before <span class="ccaf-accent">you study.</span></h2>
      </div>
      <div class="ccaf-prose">
        <p>CCA-F is for practitioners at <strong>Anthropic Partner companies</strong> who already have hands-on experience with Claude. It assesses architectural judgment across agents, tools, prompts, workflows, and reliability.</p>
        <p>The exam is delivered through Pearson VUE, online or at a test center. The published pass score is 720 on a scaled 100–1,000 range. You should be comfortable reading Python or TypeScript and working with JSON.</p>
        <p>New to Claude? Start with <a href="https://www.anthropic.com/learn" target="_blank" rel="noopener noreferrer">Anthropic Academy ↗</a> before working through the domains below.</p>
      </div>
    </section>

    <section id="domains" class="ccaf-section" aria-labelledby="ccaf-domains-title">
      <header class="ccaf-section-heading">
        <p class="ccaf-kicker">02 / Exam domains</p>
        <h2 id="ccaf-domains-title">Focus where <span class="ccaf-accent">it counts.</span></h2>
        <p>Published exam weights. Open a domain to see its task statements.</p>
      </header>
      <div class="ccaf-domain-list">
        {domains.map((domain, index) => {
          const [lead, accent] = splitTitle(domain.name);
          return (
          <details class="ccaf-domain">
            <summary>
              <span class="ccaf-index">0{index + 1}</span>
              <span class="ccaf-domain-main"><strong>{lead} <span class="ccaf-accent">{accent}</span></strong><small>{domain.summary}</small></span>
              <span class="ccaf-weight">{domain.weight}%</span>
              <span class="ccaf-plus" aria-hidden="true">+</span>
            </summary>
            <ol class="ccaf-tasks">{domain.tasks.map(task => <li>{task}</li>)}</ol>
          </details>
          );
        })}
      </div>
    </section>

    <section class="ccaf-section" aria-labelledby="ccaf-practice-title">
      <header class="ccaf-section-heading">
        <p class="ccaf-kicker">03 / Practice</p>
        <h2 id="ccaf-practice-title">Study through <span class="ccaf-accent">real scenarios.</span></h2>
        <p>Use these as prompts to test how the domains work together. They are study examples, not official exam questions.</p>
      </header>
      <div class="ccaf-scenarios">
        {scenarios.map(([title, description, domainNumbers], index) => {
          const [lead, accent] = splitTitle(title);
          return (
          <article>
            <span class="ccaf-index">0{index + 1}</span>
            <div><h3>{lead && `${lead} `}<span class="ccaf-accent">{accent}</span></h3><p>{description}</p></div>
            <span class="ccaf-scenario-domains">Domains {domainNumbers}</span>
          </article>
          );
        })}
      </div>
    </section>

    <section id="resources" class="ccaf-section" aria-labelledby="ccaf-resources-title">
      <header class="ccaf-section-heading">
        <p class="ccaf-kicker">04 / Resources</p>
        <h2 id="ccaf-resources-title">Start with <span class="ccaf-accent">the source.</span></h2>
        <p>Official registration, courses, and documentation, grouped by what you need next.</p>
      </header>
      <div class="ccaf-resources">
        <div><h3><span class="ccaf-accent">Register</span></h3><ul>{registration.map(([title, href]) => <li><a href={href} target="_blank" rel="noopener noreferrer">{title}<span aria-hidden="true">↗</span></a></li>)}</ul></div>
        <div><h3><span class="ccaf-accent">Build foundations</span></h3><ul>{foundations.map(([title, href]) => <li><a href={href} target="_blank" rel="noopener noreferrer">{title}<span aria-hidden="true">↗</span></a></li>)}</ul></div>
        <div><h3><span class="ccaf-accent">Go deeper</span></h3><ul>{advanced.map(([title, href]) => <li><a href={href} target="_blank" rel="noopener noreferrer">{title}<span aria-hidden="true">↗</span></a></li>)}</ul></div>
      </div>
      <p class="ccaf-resource-note">The Anthropic Skilljar courses for Bedrock, Vertex AI, and the Claude API include foundation and advanced material. Check the official certification page for current access, pricing, and exam details.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .ccaf { background: hsl(var(--background)); }
  .ccaf-hero { padding: 46px 1.5rem 5rem; text-align: center; }
  .ccaf-kicker { color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .ccaf-hero h1 { max-width: 880px; margin: 1.35rem auto 1.5rem; font-size: clamp(3rem, 6.7vw, 6rem); font-weight: 600; line-height: 1.04; letter-spacing: -.055em; text-wrap: balance; }
  .ccaf-accent { color: hsl(var(--primary)); }
  .ccaf-lede { max-width: 620px; margin: 0 auto; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.65; }
  .ccaf-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin: 26px 0; }
  .ccaf-action { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 25px; border: 1px solid hsl(var(--foreground)); border-radius: 9999px; font-weight: 600; }
  .ccaf-action:not(.primary):hover { border-color: hsl(var(--primary)); }
  .ccaf-action.primary { border-color: hsl(var(--primary)); background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); }
  .ccaf a:not(.ccaf-action):hover { color: hsl(var(--primary)); }
  .ccaf-note { max-width: 650px; margin: 3.5rem auto 0; color: hsl(var(--muted-foreground)); font-size: .75rem; line-height: 1.5; }
  .ccaf-facts { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 clamp(1.5rem, 5vw, 5rem); overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
  .ccaf-facts div { display: flex; flex-direction: column; gap: .35rem; padding: 2rem 1.5rem; text-align: center; }
  .ccaf-facts div + div { border-left: 1px solid hsl(var(--border)); }
  .ccaf-facts strong { font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1; font-weight: 600; letter-spacing: -.04em; }
  .ccaf-facts div > span { color: hsl(var(--muted-foreground)); font-size: .78rem; }
  .ccaf-section { padding: clamp(4rem, 7vw, 7rem) clamp(1.5rem, 5vw, 5rem); border-bottom: 1px solid hsl(var(--border)); scroll-margin-top: 5rem; }
  .ccaf-section:last-child { border-bottom: 0; }
  .ccaf-section h2 { max-width: 650px; margin: .8rem 0 0; font-size: clamp(2.25rem, 4.2vw, 4rem); font-weight: 600; line-height: 1.12; letter-spacing: -.045em; text-wrap: balance; }
  .ccaf-section-heading { max-width: 720px; margin: 0 auto 3rem; text-align: center; }
  .ccaf-section-heading h2 { margin-left: auto; margin-right: auto; }
  .ccaf-section-heading > p:last-child { margin-top: 1rem; color: hsl(var(--muted-foreground)); line-height: 1.6; }
  .ccaf-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; }
  .ccaf-prose { max-width: 600px; color: hsl(var(--muted-foreground)); line-height: 1.75; }
  .ccaf-prose p + p { margin-top: 1rem; }
  .ccaf-prose strong { color: hsl(var(--foreground)); }
  .ccaf-prose a { color: hsl(var(--foreground)); text-decoration: underline; text-underline-offset: 3px; }
  .ccaf-domain-list { border-top: 1px solid hsl(var(--border)); }
  .ccaf-domain { border-bottom: 1px solid hsl(var(--border)); }
  .ccaf-domain summary { display: grid; grid-template-columns: 2.5rem 1fr auto 1.5rem; align-items: start; gap: 1.25rem; padding: 1.5rem 0; cursor: pointer; list-style: none; }
  .ccaf-domain summary::-webkit-details-marker { display: none; }
  .ccaf-domain summary:hover .ccaf-domain-main strong { color: hsl(var(--primary)); }
  .ccaf-index { color: hsl(var(--primary)); font-size: .76rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .ccaf-domain-main { display: flex; flex-direction: column; gap: .4rem; }
  .ccaf-domain-main strong { font-size: clamp(1.05rem, 1.8vw, 1.4rem); font-weight: 600; line-height: 1.3; }
  .ccaf-domain-main small { color: hsl(var(--muted-foreground)); font-size: .88rem; line-height: 1.55; }
  .ccaf-weight { font-size: 1.15rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .ccaf-plus { font-size: 1.4rem; line-height: 1; text-align: right; }
  .ccaf-domain[open] .ccaf-plus { transform: rotate(45deg); }
  .ccaf-tasks { margin: 0 2.7rem 1.8rem 3.75rem; padding-left: 1.3rem; color: hsl(var(--muted-foreground)); font-size: .9rem; line-height: 1.65; }
  .ccaf-tasks li + li { margin-top: .45rem; }
  .ccaf-scenarios { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .ccaf-scenarios article { display: grid; grid-template-columns: 2rem 1fr; column-gap: 1rem; padding: 1.5rem; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
  .ccaf-scenarios h3 { font-size: 1.1rem; font-weight: 600; }
  .ccaf-scenarios p { margin-top: .4rem; color: hsl(var(--muted-foreground)); font-size: .88rem; line-height: 1.6; }
  .ccaf-scenario-domains { grid-column: 2; margin-top: .8rem; color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .ccaf-resources { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; }
  .ccaf-resources > div { padding: 1.5rem; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
  .ccaf-resources h3 { padding-bottom: 1rem; border-bottom: 1px solid hsl(var(--border)); font-size: 1.05rem; font-weight: 600; }
  .ccaf-resources ul { list-style: none; margin: 0; padding: 0; }
  .ccaf-resources li + li { border-top: 1px solid hsl(var(--border)); }
  .ccaf-resources a { display: flex; justify-content: space-between; gap: 1rem; padding: .9rem 0; font-size: .85rem; line-height: 1.45; }
  .ccaf-resources a span { color: hsl(var(--primary)); }
  .ccaf-resource-note { max-width: 730px; margin-top: 2.5rem; color: hsl(var(--muted-foreground)); font-size: .8rem; line-height: 1.6; }
  @media (max-width: 760px) {
    .ccaf-hero { padding: 44px 18px 4rem; }
    .ccaf-facts { grid-template-columns: repeat(2, 1fr); }
    .ccaf-facts div:nth-child(3) { border-left: 0; }
    .ccaf-facts div:nth-child(n+3) { border-top: 1px solid hsl(var(--border)); }
    .ccaf-intro, .ccaf-scenarios, .ccaf-resources { grid-template-columns: 1fr; }
    .ccaf-intro, .ccaf-resources { gap: 2rem; }
    .ccaf-domain summary { grid-template-columns: 1.5rem 1fr auto 1rem; gap: .7rem; }
    .ccaf-domain-main small { font-size: .8rem; }
    .ccaf-tasks { margin-left: 2.2rem; margin-right: 0; }
  }
</style>
