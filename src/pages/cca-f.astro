---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CCA-F — Algorims" description="Claude Certified Architect Foundations exam prep resources, syllabus, prerequisites, and study material.">
<!-- ========== INDEPENDENCE NOTICE ========== -->
  <section data-ccaf-notice class="sticky top-16 z-30 border-y border-primary/20 bg-primary/10 backdrop-blur-md">
    <div class="container-x">
      <div class="flex items-start justify-between gap-4 py-3 text-sm leading-relaxed text-foreground">
        <div class="flex items-start gap-3">
        <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-primary/15 text-primary"><i data-lucide="info" class="!w-3.5 !h-3.5"></i></span>
        <p><strong>Independent study overview.</strong> Algorims is not affiliated with or endorsed by Anthropic; trademarks belong to their owners.</p>
        </div>
        <button type="button" data-dismiss-notice class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-muted-foreground transition-colors hover:bg-background/70 hover:text-foreground" aria-label="Dismiss notice">
          <i data-lucide="x" class="!w-4 !h-4"></i>
        </button>
      </div>
    </div>
  </section>


  <!-- ========== HERO ========== -->
  <section class="relative  overflow-hidden pt-24 pb-16 lg:pt-28 lg:pb-24" style="background:radial-gradient(ellipse at 70% 0%, hsl(265 85% 58% / 0.10) 0%, transparent 55%), radial-gradient(ellipse at 20% 100%, hsl(280 95% 70% / 0.08) 0%, transparent 50%)">
    <div class="pointer-events-none absolute inset-0 grid-bg opacity-40"></div>
    <div class="container-x relative">
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_auto]">
        <div class="max-w-2xl space-y-6 pt-6">

  <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
    <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>CCA-F · Claude Certified Architect Foundations
  </div>
          <h1 class="text-balance text-5xl font-semibold leading-[1.05] tracking-tight md:text-6xl">
            Your <span class="text-gradient">passport</span> to building production AI with Claude.
          </h1>
          <p class="text-pretty text-lg leading-relaxed text-muted-foreground">
            CCA-F is designed to assess foundational Claude architecture knowledge for practitioners at Anthropic Partner companies. This overview summarizes the public study areas and points you to official Anthropic resources.
          </p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a href="#domains" class="btn btn-hero btn-xl">
              Explore the syllabus <i data-lucide="arrow-down" class="!w-4 !h-4"></i>
            </a>
            <a href="#resources" class="btn btn-outline btn-xl">
              Study resources <i data-lucide="arrow-right" class="!w-4 !h-4"></i>
            </a>
          </div>
        </div>
        <!-- Exam card visual -->
        <div class="hidden lg:block">
          <div class="relative w-96 rounded-3xl border border-border bg-card p-6 shadow-lg" style="box-shadow:0 0 60px hsl(265 85% 58% / 0.12)">
            <div class="flex items-center gap-3">
              <div class="grid h-10 w-10 place-items-center rounded-xl text-white" style="background:#d97757">
                <i data-lucide="award" class="!w-5 !h-5"></i>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Study overview</p>
                <p class="text-sm font-bold">CCA-F resources</p>
              </div>
            </div>
            <div class="my-5 h-px bg-border"></div>
            <div class="space-y-3">

                <div class="flex items-center justify-between text-sm">
                  <span class="flex items-center gap-2 text-muted-foreground"><i data-lucide="list-checks" class="!w-3.5 !h-3.5"></i> Format</span>
                  <span class="font-semibold">60 MCQ</span>
                </div>

                <div class="flex items-center justify-between text-sm">
                  <span class="flex items-center gap-2 text-muted-foreground"><i data-lucide="clock" class="!w-3.5 !h-3.5"></i> Duration</span>
                  <span class="font-semibold">120 minutes</span>
                </div>

                <div class="flex items-center justify-between text-sm">
                  <span class="flex items-center gap-2 text-muted-foreground"><i data-lucide="shield-check" class="!w-3.5 !h-3.5"></i> Delivery</span>
                  <span class="font-semibold">Pearson VUE — online or test center</span>
                </div>

                <div class="flex items-center justify-between text-sm">
                  <span class="flex items-center gap-2 text-muted-foreground"><i data-lucide="trophy" class="!w-3.5 !h-3.5"></i> Pass score</span>
                  <span class="font-semibold">720 (scaled 100–1,000)</span>
                </div>

                <div class="flex items-center justify-between text-sm">
                  <span class="flex items-center gap-2 text-muted-foreground"><i data-lucide="dollar-sign" class="!w-3.5 !h-3.5"></i> Price</span>
                  <span class="font-semibold">$125 / attempt</span>
                </div>

                <div class="flex items-center justify-between text-sm">
                  <span class="flex items-center gap-2 text-muted-foreground"><i data-lucide="layers" class="!w-3.5 !h-3.5"></i> Domains</span>
                  <span class="font-semibold">5 domains</span>
                </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== DOMAINS + SCENARIOS BOXES ========== -->
  <section class="pb-4 lg:pb-6">
    <div class="container-x">
      <div class="grid gap-5 md:grid-cols-2 items-stretch">
        <!-- Certification Domains box -->
        <div class="rounded-3xl border border-border bg-card p-5 flex flex-col">
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-foreground">Certification domains</p>
          <div class="flex flex-col flex-1 justify-between gap-2">

              <div class="group/dcard rounded-xl px-3 py-4 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md"
                style="background:hsl(265 85% 58% / 0.06);border:1px solid hsl(265 85% 58% / 0.15)"
                data-open-domain="0" role="button" tabindex="0">
                <div class="mb-1.5 flex items-center justify-between">
                  <span class="text-xs font-semibold">Agentic Architecture & Orchestration</span>
                  <span class="text-xs font-bold opacity-0 group-hover/dcard:opacity-100 transition-opacity duration-200" style="color:hsl(265 85% 58%)">27%</span>
                </div>
                <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-secondary">
                  <div class="h-full rounded-full transition-all duration-500" style="width:27%;background:hsl(265 85% 58%)"></div>
                </div>
              </div>

              <div class="group/dcard rounded-xl px-3 py-4 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md"
                style="background:hsl(210 85% 52% / 0.06);border:1px solid hsl(210 85% 52% / 0.15)"
                data-open-domain="1" role="button" tabindex="0">
                <div class="mb-1.5 flex items-center justify-between">
                  <span class="text-xs font-semibold">Tool Design & MCP Integration</span>
                  <span class="text-xs font-bold opacity-0 group-hover/dcard:opacity-100 transition-opacity duration-200" style="color:hsl(210 85% 52%)">18%</span>
                </div>
                <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-secondary">
                  <div class="h-full rounded-full transition-all duration-500" style="width:18%;background:hsl(210 85% 52%)"></div>
                </div>
              </div>

              <div class="group/dcard rounded-xl px-3 py-4 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md"
                style="background:hsl(155 65% 40% / 0.06);border:1px solid hsl(155 65% 40% / 0.15)"
                data-open-domain="2" role="button" tabindex="0">
                <div class="mb-1.5 flex items-center justify-between">
                  <span class="text-xs font-semibold">Claude Code Configuration & Workflows</span>
                  <span class="text-xs font-bold opacity-0 group-hover/dcard:opacity-100 transition-opacity duration-200" style="color:hsl(155 65% 40%)">20%</span>
                </div>
                <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-secondary">
                  <div class="h-full rounded-full transition-all duration-500" style="width:20%;background:hsl(155 65% 40%)"></div>
                </div>
              </div>

              <div class="group/dcard rounded-xl px-3 py-4 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md"
                style="background:hsl(38 90% 50% / 0.06);border:1px solid hsl(38 90% 50% / 0.15)"
                data-open-domain="3" role="button" tabindex="0">
                <div class="mb-1.5 flex items-center justify-between">
                  <span class="text-xs font-semibold">Prompt Engineering & Structured Output</span>
                  <span class="text-xs font-bold opacity-0 group-hover/dcard:opacity-100 transition-opacity duration-200" style="color:hsl(38 90% 50%)">20%</span>
                </div>
                <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-secondary">
                  <div class="h-full rounded-full transition-all duration-500" style="width:20%;background:hsl(38 90% 50%)"></div>
                </div>
              </div>

              <div class="group/dcard rounded-xl px-3 py-4 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md"
                style="background:hsl(320 65% 52% / 0.06);border:1px solid hsl(320 65% 52% / 0.15)"
                data-open-domain="4" role="button" tabindex="0">
                <div class="mb-1.5 flex items-center justify-between">
                  <span class="text-xs font-semibold">Context Management & Reliability</span>
                  <span class="text-xs font-bold opacity-0 group-hover/dcard:opacity-100 transition-opacity duration-200" style="color:hsl(320 65% 52%)">15%</span>
                </div>
                <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-secondary">
                  <div class="h-full rounded-full transition-all duration-500" style="width:15%;background:hsl(320 65% 52%)"></div>
                </div>
              </div>

          </div>
        </div>
        <!-- Scenarios box -->
        <div class="rounded-3xl border border-border bg-card p-5 flex flex-col">
          <div class="mb-3 flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-widest text-foreground">Scenarios</p>
            <span class="rounded-full bg-secondary px-2 py-0.5 text-xs text-muted-foreground">Practice prompts</span>
          </div>
          <div class="flex flex-col flex-1 justify-between gap-2">

              <div class="group/scard flex flex-col gap-1.5 rounded-xl px-3 py-2.5 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md border border-border bg-secondary/50"
                data-scroll-scenario="0" role="button" tabindex="0">
                <div class="flex items-center gap-2">
                  <span class="shrink-0 text-xs font-bold tabular-nums" style="color:hsl(265 85% 58%)">01</span>
                  <p class="text-xs font-semibold leading-snug">Support automation</p>
                </div>
                <div class="flex flex-wrap gap-1 pl-5"><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(265 85% 58% / 0.12);color:hsl(265 85% 58%);border:1px solid hsl(265 85% 58% / 0.25)"
                  data-open-domain="0" role="button" tabindex="0"
                >Agentic Architecture</span><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(210 85% 52% / 0.12);color:hsl(210 85% 52%);border:1px solid hsl(210 85% 52% / 0.25)"
                  data-open-domain="1" role="button" tabindex="0"
                >Tool Design</span><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(320 65% 52% / 0.12);color:hsl(320 65% 52%);border:1px solid hsl(320 65% 52% / 0.25)"
                  data-open-domain="4" role="button" tabindex="0"
                >Context Management</span></div>
              </div>
              <div class="group/scard flex flex-col gap-1.5 rounded-xl px-3 py-2.5 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md border border-border bg-secondary/50"
                data-scroll-scenario="1" role="button" tabindex="0">
                <div class="flex items-center gap-2">
                  <span class="shrink-0 text-xs font-bold tabular-nums" style="color:hsl(210 85% 52%)">02</span>
                  <p class="text-xs font-semibold leading-snug">Developer workflow</p>
                </div>
                <div class="flex flex-wrap gap-1 pl-5"><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(155 65% 40% / 0.12);color:hsl(155 65% 40%);border:1px solid hsl(155 65% 40% / 0.25)"
                  data-open-domain="2" role="button" tabindex="0"
                >Claude Code</span><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(320 65% 52% / 0.12);color:hsl(320 65% 52%);border:1px solid hsl(320 65% 52% / 0.25)"
                  data-open-domain="4" role="button" tabindex="0"
                >Context Management</span></div>
              </div>
              <div class="group/scard flex flex-col gap-1.5 rounded-xl px-3 py-2.5 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md border border-border bg-secondary/50"
                data-scroll-scenario="2" role="button" tabindex="0">
                <div class="flex items-center gap-2">
                  <span class="shrink-0 text-xs font-bold tabular-nums" style="color:hsl(155 65% 40%)">03</span>
                  <p class="text-xs font-semibold leading-snug">Research orchestration</p>
                </div>
                <div class="flex flex-wrap gap-1 pl-5"><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(265 85% 58% / 0.12);color:hsl(265 85% 58%);border:1px solid hsl(265 85% 58% / 0.25)"
                  data-open-domain="0" role="button" tabindex="0"
                >Agentic Architecture</span><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(210 85% 52% / 0.12);color:hsl(210 85% 52%);border:1px solid hsl(210 85% 52% / 0.25)"
                  data-open-domain="1" role="button" tabindex="0"
                >Tool Design</span><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(320 65% 52% / 0.12);color:hsl(320 65% 52%);border:1px solid hsl(320 65% 52% / 0.25)"
                  data-open-domain="4" role="button" tabindex="0"
                >Context Management</span></div>
              </div>
              <div class="group/scard flex flex-col gap-1.5 rounded-xl px-3 py-2.5 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md border border-border bg-secondary/50"
                data-scroll-scenario="3" role="button" tabindex="0">
                <div class="flex items-center gap-2">
                  <span class="shrink-0 text-xs font-bold tabular-nums" style="color:hsl(38 90% 50%)">04</span>
                  <p class="text-xs font-semibold leading-snug">Productivity automation</p>
                </div>
                <div class="flex flex-wrap gap-1 pl-5"><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(210 85% 52% / 0.12);color:hsl(210 85% 52%);border:1px solid hsl(210 85% 52% / 0.25)"
                  data-open-domain="1" role="button" tabindex="0"
                >Tool Design</span><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(155 65% 40% / 0.12);color:hsl(155 65% 40%);border:1px solid hsl(155 65% 40% / 0.25)"
                  data-open-domain="2" role="button" tabindex="0"
                >Claude Code</span><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(265 85% 58% / 0.12);color:hsl(265 85% 58%);border:1px solid hsl(265 85% 58% / 0.25)"
                  data-open-domain="0" role="button" tabindex="0"
                >Agentic Architecture</span></div>
              </div>
              <div class="group/scard flex flex-col gap-1.5 rounded-xl px-3 py-2.5 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md border border-border bg-secondary/50"
                data-scroll-scenario="4" role="button" tabindex="0">
                <div class="flex items-center gap-2">
                  <span class="shrink-0 text-xs font-bold tabular-nums" style="color:hsl(320 65% 52%)">05</span>
                  <p class="text-xs font-semibold leading-snug">CI/CD assistance</p>
                </div>
                <div class="flex flex-wrap gap-1 pl-5"><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(155 65% 40% / 0.12);color:hsl(155 65% 40%);border:1px solid hsl(155 65% 40% / 0.25)"
                  data-open-domain="2" role="button" tabindex="0"
                >Claude Code</span><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(38 90% 50% / 0.12);color:hsl(38 90% 50%);border:1px solid hsl(38 90% 50% / 0.25)"
                  data-open-domain="3" role="button" tabindex="0"
                >Prompt Engineering</span></div>
              </div>
              <div class="group/scard flex flex-col gap-1.5 rounded-xl px-3 py-2.5 cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md border border-border bg-secondary/50"
                data-scroll-scenario="5" role="button" tabindex="0">
                <div class="flex items-center gap-2">
                  <span class="shrink-0 text-xs font-bold tabular-nums" style="color:hsl(265 85% 58%)">06</span>
                  <p class="text-xs font-semibold leading-snug">Document extraction</p>
                </div>
                <div class="flex flex-wrap gap-1 pl-5"><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(38 90% 50% / 0.12);color:hsl(38 90% 50%);border:1px solid hsl(38 90% 50% / 0.25)"
                  data-open-domain="3" role="button" tabindex="0"
                >Prompt Engineering</span><span class="rounded-full px-2 py-0.5 text-[10px] font-semibold whitespace-nowrap cursor-pointer transition-all duration-150 hover:scale-105 hover:shadow-sm"
                  style="background:hsl(320 65% 52% / 0.12);color:hsl(320 65% 52%);border:1px solid hsl(320 65% 52% / 0.25)"
                  data-open-domain="4" role="button" tabindex="0"
                >Context Management</span></div>
              </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PLAIN ENGLISH ========== -->
  <section class="py-12 lg:py-16">
    <div class="container-x">

  <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
    <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>In plain English
  </div>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">What is the CCA-F certification, really?</h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">No jargon. If you're new to AI certifications, start here.</p>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <div class="rounded-3xl border border-border bg-card p-7">
          <div class="flex items-center gap-3 mb-4">
            <div class="shrink-0 grid h-12 w-12 place-items-center rounded-2xl bg-primary/10 text-primary"><i data-lucide="award" class="!w-6 !h-6"></i></div>
            <h3 class="text-lg font-semibold">What is Claude?</h3>
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">Claude is Anthropic's AI model — similar to ChatGPT but built for developers who want to embed AI into real products. Think of it as a very capable digital brain you can program to do complex tasks.</p>
        </div>
        <div class="rounded-3xl border border-border bg-card p-7">
          <div class="flex items-center gap-3 mb-4">
            <div class="shrink-0 grid h-12 w-12 place-items-center rounded-2xl bg-primary/10 text-primary"><i data-lucide="shield-check" class="!w-6 !h-6"></i></div>
            <h3 class="text-lg font-semibold">What does this certification assess?</h3>
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">It focuses on the systems <em>behind</em> an AI product — not just day-to-day chatbot use. Think: agent workflows, tool boundaries, structured output, and reliability tradeoffs.</p>
        </div>
        <div class="rounded-3xl border border-border bg-card p-7">
          <div class="flex items-center gap-3 mb-4">
            <div class="shrink-0 grid h-12 w-12 place-items-center rounded-2xl bg-primary/10 text-primary"><i data-lucide="building-2" class="!w-6 !h-6"></i></div>
            <h3 class="text-lg font-semibold">Who is this for?</h3>
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">Practitioners at <strong>Anthropic Partner companies</strong> ready to demonstrate applied expertise. Think developers, architects, and technical leads — ~301 level, hands-on Claude experience required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== EXAM AT A GLANCE ========== -->

  <!-- ========== DOMAIN WEIGHT MAP ========== -->
  <section id="domains" class="py-12 lg:py-16">
    <div class="container-x">

  <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
    <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>5 certification domains
  </div>
      <div class="mt-3 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Where your study time should go.</h2>
        <p class="text-sm text-muted-foreground">Weightages published by Anthropic</p>
      </div>
      <!-- Weight bars -->
      <div class="mt-10 space-y-4">

          <button
            data-ccaf-domain="0"
            data-toggle-domain="0" aria-expanded="false" aria-controls="ccaf-panel-0"
            class="group w-full rounded-2xl border border-border bg-card p-5 text-left transition-all hover:border-primary/30 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary/30"
            style="--dc:hsl(265 85% 58%)"
          >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-center gap-4 min-w-0">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl text-sm font-bold text-white" style="background:hsl(265 85% 58%)">01</span>
                <div class="min-w-0">
                  <p class="truncate font-semibold">Agentic Architecture & Orchestration</p>
                  <p class="text-xs text-muted-foreground mt-0.5">7 task statements</p>
                </div>
