---
import BaseLayout from "../layouts/BaseLayout.astro";
import BranchGlobe from "../components/illustrations/BranchGlobe.astro";
import { offices } from "../data/offices";
---

<BaseLayout title="Contact — Algorims" description="Get in touch with Algorims to scope your AI, cloud, or DevOps initiative. Most engagements start with a 30-minute conversation.">
<section class="contact-hero container-x" aria-labelledby="contact-title">
  <p class="contact-kicker">Contact us</p>
  <h1 id="contact-title">Let's build <span>what's next.</span></h1>
  <p>Tell us about your goals. We'll get back within one business day with next steps and a recommended consultation.</p>
</section>

<section class="container-x pb-16 lg:pb-24" aria-label="Contact details and enquiry form">
  <div class="contact-grid">
    <aside class="contact-details" aria-labelledby="contact-details-title">
      <div class="contact-intro">
        <p class="contact-label">Let’s talk possibilities</p>
        <h2 id="contact-details-title">Your next chapter.<br/>Our shared ambition.</h2>
        <p>Have a challenge to solve or an idea to explore? Let’s find the right way forward, together.</p>
      </div>
      <div class="contact-direct">
        <h3 class="contact-label">Direct contact</h3>
        <a href="mailto:contactus@algorims.com" class="contact-link">
          <span class="contact-icon"><i data-lucide="mail" aria-hidden="true"></i></span>
          <span><span class="contact-link-label">Email us</span><span class="contact-link-value">contactus@algorims.com</span></span>
          <i data-lucide="arrow-up-right" class="contact-link-arrow" aria-hidden="true"></i>
        </a>
        <a href="tel:+6583459599" class="contact-link">
          <span class="contact-icon"><i data-lucide="phone" aria-hidden="true"></i></span>
          <span><span class="contact-link-label">Call our Singapore team</span><span class="contact-link-value">+65 8345 9599</span></span>
          <i data-lucide="arrow-up-right" class="contact-link-arrow" aria-hidden="true"></i>
        </a>
      </div>
      <div class="contact-consultation">
        <span class="contact-icon"><i data-lucide="messages-square" aria-hidden="true"></i></span>
        <div>
          <h3>A little clarity goes a long way.</h3>
          <p>Start with a free 30-minute conversation with a principal engineer. Bring your questions. We’ll help scope the next step.</p>
        </div>
      </div>
    </aside>

    <div class="contact-form-wrap">
          <form id="contact-form" novalidate>
            <div id="contact-success" class="hidden py-10 text-center" role="status">
              <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-primary/10 text-primary"><i data-lucide="check" class="!w-7 !h-7"></i></div>
              <h3 class="mt-5 text-2xl font-semibold">Thanks — message received</h3>
              <p class="mt-2 text-muted-foreground">We'll reply within one business day.</p>
              <button type="button" id="contact-reset" class="btn btn-outline btn-default mt-6 rounded-full">Send another message</button>
            </div>
            <div id="contact-fields" class="space-y-5">
              <div class="contact-form-heading">
                <p class="contact-label">Start a conversation</p>
                <h2>Tell us what you have in mind.</h2>
                <p>A few details are all we need to get started.</p>
              </div>
              <div class="grid gap-5 md:grid-cols-2">
                <div class="space-y-2">
                  <label for="name" class="text-sm font-medium">Name</label>
                  <input id="name" name="name" class="field" placeholder="Your full name" autocomplete="name" required aria-describedby="name-error" maxlength="100" />
                  <p id="name-error" aria-live="polite" data-error="name" class="text-xs text-destructive hidden"></p>
                </div>
                <div class="space-y-2">
                  <label for="email" class="text-sm font-medium">Work email</label>
                  <input id="email" name="email" type="email" class="field" placeholder="you@company.com" autocomplete="email" required aria-describedby="email-error" maxlength="255" />
                  <p id="email-error" aria-live="polite" data-error="email" class="text-xs text-destructive hidden"></p>
                </div>
              </div>
              <div class="grid gap-5 md:grid-cols-2">
                <div class="space-y-2">
                  <label for="company" class="text-sm font-medium">Company (optional)</label>
                  <input id="company" name="company" class="field" placeholder="Company name" autocomplete="organization" maxlength="120" />
                </div>
                <div class="space-y-2">
                  <label for="service" class="text-sm font-medium">Service you're interested in</label>
                  <select id="service" name="service" class="field" required aria-describedby="service-error">
                    <option value="">Select a service…</option>
                    <option value="Cloud">Cloud</option>
                    <option value="DevOps">DevOps</option>
                    <option value="Development">Development</option>
                    <option value="AI">AI</option>
                    <option value="Data and ML">Data and ML</option>
                  </select>
                  <p id="service-error" aria-live="polite" data-error="service" class="text-xs text-destructive hidden"></p>
                </div>
              </div>
              <div class="space-y-2">
                <label for="message" class="text-sm font-medium">How can we help?</label>
                <textarea id="message" name="message" rows="5" required aria-describedby="message-error" maxlength="1000" class="field" placeholder="Tell us about your goals, timelines, and stack."></textarea>
                <p id="message-error" aria-live="polite" data-error="message" class="text-xs text-destructive hidden"></p>
              </div>
              <p id="contact-status" class="hidden text-sm text-destructive" role="alert"></p>
              <div class="contact-form-footer">
                <button type="submit" class="btn btn-hero btn-lg">Send message <i data-lucide="arrow-right" class="!w-4 !h-4" aria-hidden="true"></i></button>
                <p><i data-lucide="clock-3" aria-hidden="true"></i> A reply within one business day.</p>
              </div>
            </div>
          </form>
    </div>
  </div>
</section>

<section class="container-x pb-16 lg:pb-24" aria-labelledby="presence-title">
  <div class="presence-grid">
    <div class="presence-globe">
      <BranchGlobe />
    </div>
    <div class="presence-copy">
      <p class="contact-label">Where we work</p>
      <h2 id="presence-title">One team across three countries.</h2>
      <p class="presence-intro">Engineering runs from Singapore, India, and the United States, so your project has cover across time zones.</p>
      <ul class="presence-list">
        {offices.map((office) => (
          <li>
            <button type="button" class="presence-office" data-office={office.id}>
              <svg class="presence-marker" class:list={[office.role === "hq" && "is-hq"]} viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span>
                <span class="contact-place">{office.city}</span>
                <span class="presence-meta">{office.country} · {office.role === "hq" ? "Headquarters" : "Office"}</span>
                <span class="contact-address">{office.lines.join(", ")}</span>
                <span class="sr-only">Show on globe</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
</BaseLayout>

<style>
  .contact-hero { padding-top: clamp(48px, 6vw, 80px); padding-bottom: clamp(40px, 5vw, 64px); text-align: center; }
  .contact-kicker, .contact-label { color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .contact-hero h1 { max-width: 1050px; margin: 16px auto 0; font-size: clamp(2.7rem, 5.2vw, 4.8rem); font-weight: 600; line-height: 1.08; letter-spacing: -.06em; text-wrap: balance; }
  .contact-hero h1 span { color: hsl(var(--primary)); }
  .contact-hero > p:last-child { max-width: 600px; margin: 22px auto 0; color: hsl(var(--muted-foreground)); font-size: 1.0625rem; line-height: 1.65; text-wrap: balance; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.4fr); overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
  .contact-details { display: flex; flex-direction: column; gap: 36px; min-width: 0; padding: clamp(28px, 3.5vw, 48px); }
  .contact-label { margin: 0 0 16px; }
  .contact-intro h2 { margin: 0; font-size: clamp(1.65rem, 2.5vw, 2.15rem); font-weight: 500; line-height: 1.2; letter-spacing: -.045em; }
  .contact-intro > p:last-child { max-width: 340px; margin: 16px 0 0; color: hsl(var(--muted-foreground)); font-size: 1rem; line-height: 1.7; }
  .contact-direct .contact-label { color: hsl(var(--muted-foreground)); margin-bottom: 10px; }
  .contact-link { color: hsl(var(--foreground)); display: flex; align-items: center; gap: 14px; min-height: 78px; padding: 16px 0; border-bottom: 1px solid hsl(var(--border)); transition: color .2s; }
  .contact-link > span:nth-child(2) { display: grid; gap: 4px; min-width: 0; }
  .contact-icon { display: grid; flex: none; place-items: center; width: 40px; height: 40px; border: 1px solid hsl(var(--border)); border-radius: 9999px; color: hsl(var(--primary)); }
  .contact-icon :global(svg) { width: 18px; height: 18px; }
  .contact-link-label { color: hsl(var(--muted-foreground)); font-size: .8125rem; }
  .contact-link-value { font-size: .9375rem; font-weight: 500; overflow-wrap: anywhere; }
  .contact-link :global(.contact-link-arrow) { flex: none; width: 16px; height: 16px; margin-left: auto; color: hsl(var(--muted-foreground)); }
  .contact-link:hover { color: hsl(var(--primary)); }
  .contact-link:hover .contact-icon { border-color: hsl(var(--primary) / .5); }
  .contact-consultation { display: flex; gap: 14px; margin-top: auto; padding-top: 8px; }
  .contact-consultation .contact-icon { background: hsl(var(--primary) / .05); border-color: transparent; }
  .contact-consultation h3 { margin: 0; font-size: .9375rem; font-weight: 600; }
  .contact-consultation p { margin: 8px 0 0; color: hsl(var(--muted-foreground)); font-size: .875rem; line-height: 1.7; }
  .contact-place { margin: 0; font-weight: 600; }
  .contact-address { margin: 6px 0 0; color: hsl(var(--muted-foreground)); font-size: .875rem; line-height: 1.6; }
  .contact-form-wrap { min-width: 0; padding: clamp(28px, 3.5vw, 48px); border-left: 1px solid hsl(var(--border)); background: hsl(var(--muted) / .5); }
  .contact-form-heading { padding-bottom: 8px; }
  .contact-form-heading .contact-label { margin-bottom: 10px; }
  .contact-form-heading h2 { font-size: clamp(1.5rem, 2.2vw, 1.875rem); font-weight: 500; line-height: 1.2; letter-spacing: -.04em; }
  .contact-form-heading > p:last-child { margin-top: 10px; color: hsl(var(--muted-foreground)); font-size: .9375rem; line-height: 1.6; }
  .contact-form-wrap label { display: inline-block; }
  .contact-form-wrap .field { min-height: 48px; padding: .75rem .875rem; border-color: hsl(var(--input) / .7); border-radius: .75rem; font-size: 1rem; }
  .contact-form-wrap .field:focus { border-color: hsl(var(--primary)); }
  .contact-form-wrap .field::placeholder { color: hsl(var(--muted-foreground) / .85); }
  .contact-form-wrap textarea { display: block; resize: vertical; }
  .contact-form-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; padding-top: 4px; }
  .contact-form-footer .btn { min-height: 48px; border-radius: 9999px; padding-inline: 24px; }
  .contact-form-footer p { display: flex; align-items: center; gap: 6px; color: hsl(var(--muted-foreground)); font-size: .75rem; }
  .contact-form-footer p :global(svg) { flex: none; width: 14px; height: 14px; }
  .presence-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
  .presence-globe { display: grid; place-items: center; min-width: 0; padding: clamp(20px, 3vw, 40px); border-right: 1px solid hsl(var(--border)); }
  .presence-copy { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: clamp(28px, 4vw, 56px); }
  .presence-copy h2 { margin: 0; font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 600; line-height: 1.1; letter-spacing: -.04em; text-wrap: balance; }
  .presence-intro { margin: 14px 0 0; color: hsl(var(--muted-foreground)); font-size: .95rem; line-height: 1.6; }
  .presence-list { margin: 28px 0 0; padding: 0; list-style: none; border-top: 1px solid hsl(var(--border)); }
  .presence-list li { border-bottom: 1px solid hsl(var(--border)); }
  .presence-office { color: hsl(var(--foreground)); display: flex; align-items: center; gap: 14px; width: 100%; padding: 14px 4px; text-align: left; background: none; border: 0; cursor: pointer; transition: color .2s; }
  .presence-office > span:last-child { display: grid; gap: 2px; }
  .presence-office:hover .contact-place, .presence-office:focus-visible .contact-place { color: hsl(var(--primary)); }
  .presence-office:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 2px; border-radius: .5rem; }
  .presence-marker { flex: none; width: 20px; height: 20px; fill: none; stroke: hsl(var(--foreground)); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .presence-marker.is-hq { stroke: hsl(var(--primary)); }
  .presence-meta { color: hsl(var(--muted-foreground)); font-size: .85rem; }
  @media (max-width: 1023px) {
    .presence-grid { grid-template-columns: 1fr; }
    .presence-globe { border-right: 0; border-bottom: 1px solid hsl(var(--border)); }
    .presence-copy { padding: 24px 28px; }
    .contact-grid { grid-template-columns: 1fr; }
    .contact-form-wrap { grid-row: 1; border-left: 0; border-bottom: 1px solid hsl(var(--border)); }
    .contact-details { padding: 28px 24px; gap: 28px; }
    .contact-form-wrap { padding: 28px 24px; }
    .contact-form-footer { flex-direction: column; align-items: stretch; gap: 14px; }
    .contact-form-footer p { justify-content: center; }
  }
</style>

<script>
  const globe = document.querySelector<HTMLElement>("[data-branch-globe]");
  document.querySelectorAll<HTMLButtonElement>(".presence-office").forEach((button) => {
    const highlight = (id: string | null) => globe?.dispatchEvent(new CustomEvent("globe:highlight", { detail: id }));
    const id = button.dataset.office!;
    // Mouse hovers; touch taps (no hover) toggle via click.
    button.addEventListener("pointerenter", (event) => event.pointerType === "mouse" && highlight(id));
    button.addEventListener("pointerleave", (event) => event.pointerType === "mouse" && highlight(null));
    button.addEventListener("focus", () => highlight(id));
    button.addEventListener("blur", () => highlight(null));
    button.addEventListener("click", () => highlight(id));
  });
</script>

<script>
  import { sendForm, setButtonLoading } from "../scripts/formSubmission";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (form) {
    const fields = form.querySelector<HTMLElement>("#contact-fields")!;
    const success = form.querySelector<HTMLElement>("#contact-success")!;
    const status = form.querySelector<HTMLElement>("#contact-status")!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const key = import.meta.env.PUBLIC_WEB3FORMS_CONTACT_KEY;

    function setError(name: string, message: string) {
      const error = form!.querySelector<HTMLElement>(`[data-error="${name}"]`)!;
      error.textContent = message;
      error.classList.toggle("hidden", !message);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? "");
      const name = value("name");
      const email = value("email");
      const company = value("company");
      const service = value("service");
      const message = value("message");
      setError("name", name.trim().length < 2 ? "Please enter your name" : "");
      setError("email", !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) ? "Please enter a valid email" : "");
      setError("message", message.trim().length < 10 ? "Please share a few more details" : "");
      setError("service", !service ? "Please select a service" : "");
      if (form.querySelector('[data-error]:not(.hidden)')) return;
      status.classList.add("hidden");

      const subject = `New enquiry from ${name}${company ? ` (${company})` : ""}${service ? ` — ${service}` : ""}`;
      const body = [
        `Name: ${name}`, `Email: ${email}`, company ? `Company: ${company}` : null,
        service ? `Service: ${service}` : null, "", "Message:", message,
      ].filter(Boolean).join("\n");
      setButtonLoading(button, true);
      try {
        await sendForm(form, key, subject, "contactus@algorims.com", body);
        fields.classList.add("hidden");
        success.classList.remove("hidden");
      } catch {
        status.textContent = "Sorry — we couldn't send that just now. Please email contactus@algorims.com directly.";
        status.classList.remove("hidden");
      } finally {
        setButtonLoading(button, false);
      }
    });

    form.querySelector("#contact-reset")?.addEventListener("click", () => {
      form.reset();
      form.querySelectorAll<HTMLElement>("[data-error]").forEach((error) => {
        error.textContent = "";
        error.classList.add("hidden");
      });
      status.classList.add("hidden");
      success.classList.add("hidden");
      fields.classList.remove("hidden");
    });
  }
</script>
