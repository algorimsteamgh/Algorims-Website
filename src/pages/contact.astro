---
import BaseLayout from "../layouts/BaseLayout.astro";
import BranchGlobe from "../components/illustrations/BranchGlobe.astro";
import { offices } from "../data/offices";
import { WHATSAPP_NUMBER, WHATSAPP_URL } from "../data/whatsapp";

const customers = [
  ["11.svg", "Mitsubishi Heavy Industries"],
  ["12.webp", "BreadTalk"],
  ["13.webp", "KeePer LABO"],
  ["03.webp", "CHP Eng Seng Corporation"],
  ["16.webp", "SMAC Tech Labs"],
  ["15.webp", "Syslatech"],
  ["14.webp", "CBM Parking"],
  ["02.webp", "MIDAS"],
  ["07.webp", "apiwiz"],
  ["01.webp", "qWorks"],
  ["04.webp", "InfoBace"],
  ["05.webp", "babyboo"],
  ["06.webp", "Unisto"],
  ["08.webp", "COMM-IT"],
  ["09.webp", "Kakatiya Cultural Association Singapore"],
  ["10.webp", "PPIC Technologies"],
];
// Three marquee rows, alternating direction
const logoRows = [0, 1, 2].map((r) => customers.filter((_, i) => i % 3 === r));
const services = [
  "Never Miss a Sales Lead Again – Set Up Your WhatsApp AI Agent",
  "Get a Complimentary AI Assessment for Your Business",
  "Meet IRAS GST Compliant with InvoiceNOW",
  "Transform Your SME with AI – Get Up to 50% IMDA Grant",
];
const badges = [
  { src: "/assets/aws-partner-badge.webp", alt: "AWS Partner — Advanced Tier Services" },
  { src: "/assets/partners/aws-ai-services-competency-badge.png", alt: "AWS AI Services Competency" },
  { src: "/assets/partners/claude-certified-services-partner.svg", alt: "Claude Certified Services Partner" },
  { src: "/assets/partners/xero-blue-partner-badge.svg", alt: "Xero Certified Solutions Partner" },
];
---

<BaseLayout title="Contact — Algorims" description="Get in touch with Algorims to scope your AI, cloud, or DevOps initiative. Most engagements start with a 30-minute conversation.">
<section class="container-x contact-shell" aria-labelledby="contact-title">
  <div class="contact-grid">
    <aside class="contact-details">
      <p class="contact-kicker">Contact us</p>
      <h1 id="contact-title">Let's build <span>what's next.</span></h1>
      <p class="contact-sub">Tell us about your goals. A principal engineer will get back to you promptly with next steps and a free 30-minute consultation.</p>

      <p class="trust-line">Trusted by <span>teams across Singapore, India &amp; the US</span></p>
      <ul class="sr-only" role="list" aria-label="Clients">
        {customers.map(([, name]) => <li>{name}</li>)}
      </ul>
      <div class="logo-marquee" aria-hidden="true">
        {logoRows.map((row, r) => (
          <div class="marquee-row">
            <div class:list={["marquee-track", r % 2 === 1 && "reverse"]} style={`--dur: ${row.length * 5}s`}>
              {[...row, ...row].map(([file]) => (
                <span class="marquee-logo"><img src={`/assets/trusted/logo-${file}`} alt="" decoding="async" /></span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <ul class="badge-row" role="list" aria-label="Partner credentials">
        {badges.map((b) => (
          <li><img src={b.src} alt={b.alt} loading="lazy" decoding="async" /></li>
        ))}
      </ul>

      <div class="contact-direct">
        <a href="mailto:contactus@algorims.com" class="contact-link">
          <span class="contact-icon"><i data-lucide="mail" aria-hidden="true"></i></span>
          <span class="contact-link-value">Email us</span>
        </a>
        <a href={`tel:+${WHATSAPP_NUMBER}`} class="contact-link">
          <span class="contact-icon"><i data-lucide="phone" aria-hidden="true"></i></span>
          <span class="contact-link-value">Call us</span>
        </a>
        <a href={WHATSAPP_URL} class="contact-link" target="_blank" rel="noopener noreferrer">
          <span class="contact-icon"><i data-lucide="message-circle" aria-hidden="true"></i></span>
          <span class="contact-link-value">WhatsApp us</span>
        </a>
      </div>
    </aside>

    <div class="contact-form-wrap">
          <form id="contact-form" method="post" novalidate>
            <input type="hidden" name="page_url" value={Astro.url.pathname} />
            <input type="hidden" name="event_id" value="" />
            <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div id="contact-success" class="hidden py-10 text-center" role="status">
              <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-primary/10 text-primary"><i data-lucide="check" class="!w-7 !h-7"></i></div>
              <h3 class="mt-5 text-2xl font-semibold">Thanks — message received</h3>
              <p class="mt-2 text-muted-foreground">We'll be in touch shortly.</p>
              <button type="button" id="contact-reset" class="btn btn-outline btn-default mt-6 rounded-full">Send another message</button>
            </div>
            <div id="contact-fields" class="space-y-5">
              <div class="contact-form-heading">
                <h2>Start a conversation</h2>
                <p>A few details are all we need. Fields marked <span class="req" aria-hidden="true">*</span> are required.</p>
              </div>
              <div class="space-y-5">
                <div class="space-y-2">
                  <label for="name" class="text-sm font-medium">Name<span class="req" aria-hidden="true">*</span></label>
                  <input id="name" name="name" class="field" placeholder="Your full name" autocomplete="name" required aria-describedby="name-error" maxlength="100" />
                  <p id="name-error" aria-live="polite" data-error="name" class="text-xs text-destructive hidden"></p>
                </div>
                <div class="space-y-2">
                  <label for="email" class="text-sm font-medium">Work email<span class="req" aria-hidden="true">*</span></label>
                  <input id="email" name="email" type="email" class="field" placeholder="you@company.com" autocomplete="email" required aria-describedby="email-error" maxlength="255" />
                  <p id="email-error" aria-live="polite" data-error="email" class="text-xs text-destructive hidden"></p>
                </div>
              </div>
              <div class="space-y-2">
                <label for="company" class="text-sm font-medium">Company</label>
                <input id="company" name="company" class="field" placeholder="Company name (optional)" autocomplete="organization" maxlength="120" />
              </div>
              <fieldset class="service-set" aria-describedby="service-error">
                <legend class="text-sm font-medium">What can we help with?<span class="req" aria-hidden="true">*</span> <span class="service-hint">Select all that apply</span></legend>
                <input type="hidden" name="service" value="" />
                <div class="service-grid">
                  {services.map((svc) => (
                    <label class="service-option">
                      <input type="checkbox" name="services" value={svc} />
                      <span class="service-check" aria-hidden="true"><i data-lucide="check"></i></span>
                      <span class="service-title">{svc}</span>
                    </label>
                  ))}
                </div>
                <p id="service-error" aria-live="polite" data-error="service" class="text-xs text-destructive hidden"></p>
              </fieldset>
              <div class="space-y-2">
                <label for="message" class="text-sm font-medium">How can we help?</label>
                <textarea id="message" name="message" rows="4" maxlength="1000" class="field" placeholder="Tell us about your goals, timelines, and stack."></textarea>
              </div>
              <p id="contact-status" class="hidden text-sm text-destructive" role="alert"></p>
              <p id="contact-email-draft" class="hidden text-sm text-muted-foreground" role="status">Send the draft from your email app to complete your enquiry.</p>
              <div class="contact-form-footer">
                <button type="submit" class="btn btn-hero btn-lg">Send message <i data-lucide="arrow-right" class="!w-4 !h-4" aria-hidden="true"></i></button>
                <p><i data-lucide="clock-3" aria-hidden="true"></i> Expect a quick, personal reply.</p>
              </div>
            </div>
          </form>
    </div>
  </div>
</section>

<section class="container-x pb-16 lg:pb-24" aria-labelledby="presence-title">
  <div class="presence-grid">
    <div class="presence-globe">
      <BranchGlobe />
    </div>
    <div class="presence-copy">
      <p class="contact-label">Where we work</p>
      <h2 id="presence-title">One team across three countries.</h2>
      <p class="presence-intro">Engineering runs from Singapore, India, and the United States, so your project has cover across time zones.</p>
      <ul class="presence-list">
        {offices.map((office) => (
          <li id={office.id} class="scroll-mt-28">
            <button type="button" class="presence-office" data-office={office.id}>
              <svg class="presence-marker" class:list={[office.role === "hq" && "is-hq"]} viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span>
                <span class="contact-place">{office.city}</span>
                <span class="presence-meta">{office.country} · {office.role === "hq" ? "Headquarters" : "Office"}</span>
                <span class="contact-address">{office.lines.join(", ")}</span>
                <span class="sr-only">Show on globe</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
</BaseLayout>

<style>
  .contact-shell { padding-top: clamp(20px, 3vw, 36px); padding-bottom: clamp(56px, 7vw, 96px); }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(12px, 1.4vw, 20px); padding: clamp(10px, 1.2vw, 16px); border: 1px solid hsl(var(--border)); border-radius: 2rem; background: hsl(var(--background)); }
  .contact-details { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: clamp(32px, 4.5vw, 64px) clamp(24px, 4vw, 56px); text-align: center; border-radius: 1.5rem;
    background: radial-gradient(120% 70% at 0% 0%, hsl(var(--primary) / .09), transparent 60%), radial-gradient(90% 60% at 100% 100%, hsl(var(--primary) / .05), transparent 65%), linear-gradient(180deg, hsl(var(--primary) / .03), hsl(var(--background))); }
  .contact-kicker { margin: 0; color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .contact-details h1 { margin: 14px 0 0; font-size: clamp(2.6rem, 5vw, 4.4rem); font-weight: 600; line-height: 1.04; letter-spacing: -.06em; text-wrap: balance; }
  .contact-details h1 span { color: hsl(var(--primary)); }
  .contact-sub { max-width: 460px; margin: 18px 0 0; color: hsl(var(--muted-foreground)); font-size: 1.0625rem; line-height: 1.65; text-wrap: balance; }
  .trust-line { margin: clamp(32px, 4vw, 48px) 0 0; font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .trust-line span { color: hsl(var(--primary)); }
  .logo-marquee { display: grid; gap: 6px; width: 100%; margin: 20px 0 0; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .marquee-row { overflow: hidden; }
  .marquee-track { display: flex; width: max-content; animation: marquee-left var(--dur, 30s) linear infinite; }
  .marquee-track.reverse { animation-name: marquee-right; }
  .logo-marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee-logo { display: grid; flex: none; place-items: center; width: clamp(120px, 11vw, 150px); height: 60px; padding: 0 14px; }
  .marquee-logo img { max-width: 100%; max-height: 36px; object-fit: contain; mix-blend-mode: multiply; }
  @keyframes marquee-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes marquee-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .marquee-row { overflow-x: auto; }
  }
  .badge-row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px 22px; margin: clamp(24px, 3vw, 36px) 0 0; padding: 0; list-style: none; }
  .badge-row img { height: 52px; width: auto; object-fit: contain; }
  .contact-direct { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; width: 100%; margin-top: auto; padding-top: clamp(28px, 3.5vw, 44px); }
  .contact-link { display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 0; padding: 14px 8px; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--background) / .7); color: hsl(var(--foreground)); transition: border-color .2s, color .2s; }
  .contact-icon { display: grid; flex: none; place-items: center; width: 36px; height: 36px; border-radius: 9999px; background: hsl(var(--primary) / .08); color: hsl(var(--primary)); }
  .contact-icon :global(svg) { width: 17px; height: 17px; }
  .contact-link-value { font-size: .875rem; font-weight: 500; }
  .contact-link:hover { border-color: hsl(var(--primary) / .4); color: hsl(var(--primary)); }
  .contact-label { margin: 0 0 16px; color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .contact-place { margin: 0; font-weight: 600; }
  .contact-address { margin: 6px 0 0; color: hsl(var(--muted-foreground)); font-size: .875rem; line-height: 1.6; }
  .contact-form-wrap { min-width: 0; padding: clamp(28px, 4vw, 56px); border-radius: 1.5rem; background: hsl(var(--muted) / .7); }
  .contact-form-heading { padding-bottom: 4px; }
  .contact-form-heading h2 { font-size: clamp(1.4rem, 2vw, 1.75rem); font-weight: 600; line-height: 1.2; letter-spacing: -.04em; }
  .contact-form-heading > p:last-child { margin-top: 8px; color: hsl(var(--muted-foreground)); font-size: .9rem; line-height: 1.6; }
  .service-set { margin: 0; padding: 0; border: 0; min-width: 0; }
  .service-set legend { display: block; width: 100%; margin-bottom: 10px; padding: 0; }
  .service-hint { margin-left: 6px; color: hsl(var(--muted-foreground)); font-size: .75rem; font-weight: 400; }
  .service-grid { display: grid; grid-template-columns: 1fr; gap: 8px; }
  .contact-form-wrap .service-option { position: relative; display: flex; align-items: center; gap: 10px; min-height: 46px; padding: 10px 14px; border: 1px solid hsl(var(--border)); border-radius: .875rem; background: hsl(var(--background)); cursor: pointer; transition: border-color .2s, background-color .2s; }
  .service-option input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; margin: 0; }
  .service-title { min-width: 0; font-size: .875rem; font-weight: 500; line-height: 1.3; }
  .service-check { display: grid; flex: none; place-items: center; width: 18px; height: 18px; border: 1.5px solid hsl(var(--muted-foreground) / .45); border-radius: 5px; color: transparent; transition: background-color .2s, border-color .2s, color .2s; }
  .service-check :global(svg) { width: 12px; height: 12px; stroke-width: 3; }
  .service-option:hover { border-color: hsl(var(--primary) / .35); }
  .service-option:has(input:focus-visible) { outline: 2px solid hsl(var(--ring)); outline-offset: 2px; }
  .service-option:has(input:checked) { border-color: hsl(var(--primary) / .55); background: hsl(var(--primary) / .04); }
  .service-option:has(input:checked) .service-title { color: hsl(var(--primary)); }
  .service-option:has(input:checked) .service-check { border-color: hsl(var(--primary)); background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); }
  .req { margin-left: 2px; color: hsl(var(--destructive)); }
  .contact-form-wrap label { display: inline-block; }
  .contact-form-wrap .field { min-height: 52px; padding: .8rem 1.1rem; border-color: hsl(var(--border)); border-radius: 9999px; background: hsl(var(--background)); font-size: 1rem; }
  .contact-form-wrap textarea.field { border-radius: 1.25rem; }
  .contact-form-wrap .field:focus { border-color: hsl(var(--primary)); }
  .contact-form-wrap .field::placeholder { color: hsl(var(--muted-foreground) / .85); }
  .contact-form-wrap textarea { display: block; resize: vertical; }
  .contact-form-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; padding-top: 4px; }
  .contact-form-footer .btn { min-height: 52px; border-radius: 9999px; padding-inline: 28px; }
  .contact-form-footer p { display: flex; align-items: center; gap: 6px; color: hsl(var(--muted-foreground)); font-size: .75rem; }
  .contact-form-footer p :global(svg) { flex: none; width: 14px; height: 14px; }
  :global(.dark) .marquee-logo img { mix-blend-mode: normal; }
  .presence-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
  .presence-globe { display: grid; place-items: center; min-width: 0; padding: clamp(20px, 3vw, 40px); border-right: 1px solid hsl(var(--border)); }
  .presence-copy { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: clamp(28px, 4vw, 56px); }
  .presence-copy h2 { margin: 0; font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 600; line-height: 1.1; letter-spacing: -.04em; text-wrap: balance; }
  .presence-intro { margin: 14px 0 0; color: hsl(var(--muted-foreground)); font-size: .95rem; line-height: 1.6; }
  .presence-list { margin: 28px 0 0; padding: 0; list-style: none; border-top: 1px solid hsl(var(--border)); }
  .presence-list li { border-bottom: 1px solid hsl(var(--border)); }
  .presence-office { color: hsl(var(--foreground)); display: flex; align-items: center; gap: 14px; width: 100%; padding: 14px 4px; text-align: left; background: none; border: 0; cursor: pointer; transition: color .2s; }
  .presence-office > span:last-child { display: grid; gap: 2px; }
  .presence-office:hover .contact-place, .presence-office:focus-visible .contact-place { color: hsl(var(--primary)); }
  .presence-office:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 2px; border-radius: .5rem; }
  .presence-marker { flex: none; width: 20px; height: 20px; fill: none; stroke: hsl(var(--foreground)); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .presence-marker.is-hq { stroke: hsl(var(--primary)); }
  .presence-meta { color: hsl(var(--muted-foreground)); font-size: .85rem; }
  @media (max-width: 1023px) {
    .presence-grid { grid-template-columns: 1fr; }
    .presence-globe { border-right: 0; border-bottom: 1px solid hsl(var(--border)); }
    .presence-copy { padding: 24px 28px; }
    .contact-grid { grid-template-columns: 1fr; border-radius: 1.5rem; }
    .contact-details { padding: 36px 20px; }
    .contact-form-wrap { padding: 28px 20px; }
    .contact-form-footer { flex-direction: column; align-items: stretch; gap: 14px; }
    .contact-form-footer p { justify-content: center; }
  }
  @media (max-width: 520px) {
    .contact-direct { grid-template-columns: 1fr; }
    .contact-link { flex-direction: row; text-align: left; padding: 12px 14px; }
    .marquee-logo { width: 110px; height: 52px; }
    .badge-row img { height: 44px; }
  }
</style>

<script>
  const globe = document.querySelector<HTMLElement>("[data-branch-globe]");
  document.querySelectorAll<HTMLButtonElement>(".presence-office").forEach((button) => {
    const highlight = (id: string | null) => globe?.dispatchEvent(new CustomEvent("globe:highlight", { detail: id }));
    const id = button.dataset.office!;
    // Mouse hovers; touch taps (no hover) toggle via click.
    button.addEventListener("pointerenter", (event) => event.pointerType === "mouse" && highlight(id));
    button.addEventListener("pointerleave", (event) => event.pointerType === "mouse" && highlight(null));
    button.addEventListener("focus", () => highlight(id));
    button.addEventListener("blur", () => highlight(null));
    button.addEventListener("click", () => highlight(id));
  });
</script>

<script>
  import { sendForm, setButtonLoading } from "../scripts/formSubmission";
  import { newEventId } from "../scripts/tracking";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (form) {
    const fields = form.querySelector<HTMLElement>("#contact-fields")!;
    const success = form.querySelector<HTMLElement>("#contact-success")!;
    const status = form.querySelector<HTMLElement>("#contact-status")!;
    const emailDraft = form.querySelector<HTMLElement>("#contact-email-draft")!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const configuredKey = import.meta.env.PUBLIC_WEB3FORMS_CONTACT_KEY;
    const key = configuredKey?.startsWith("YOUR-") ? undefined : configuredKey;
    const alertUrl = import.meta.env.PUBLIC_LEAD_ALERT_URL;

    function setError(name: string, message: string) {
      const error = form!.querySelector<HTMLElement>(`[data-error="${name}"]`)!;
      error.textContent = message;
      error.classList.toggle("hidden", !message);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (data.get("botcheck")) return;
      const value = (name: string) => String(data.get(name) ?? "");
      const name = value("name");
      const email = value("email");
      const company = value("company");
      const service = data.getAll("services").map(String).join("; ");
      form.querySelector<HTMLInputElement>('input[name="service"]')!.value = service;
      const message = value("message");
      setError("name", name.trim().length < 2 ? "Please enter your name" : "");
      setError("email", !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) ? "Please enter a valid email" : "");
      setError("service", !service ? "Please select at least one option" : "");
      if (form.querySelector('[data-error]:not(.hidden)')) return;
      status.classList.add("hidden");
      emailDraft.classList.add("hidden");
      if (key && alertUrl) form.querySelector<HTMLInputElement>('[name="event_id"]')!.value = newEventId();

      const subject = `New enquiry from ${name}${company ? ` (${company})` : ""}${service ? ` — ${service}` : ""}`;
      const body = [
        `Name: ${name}`, `Email: ${email}`, company ? `Company: ${company}` : null,
        service ? `Service: ${service}` : null, "", "Message:", message,
      ].filter(Boolean).join("\n");
      setButtonLoading(button, true);
      try {
        await sendForm(form, key, subject, "contactus@algorims.com", body, alertUrl);
        if (!key) {
          emailDraft.classList.remove("hidden");
          return;
        }
        fields.classList.add("hidden");
        success.classList.remove("hidden");
      } catch {
        status.textContent = "Sorry — we couldn't send that just now. Please email contactus@algorims.com directly.";
        status.classList.remove("hidden");
      } finally {
        setButtonLoading(button, false);
      }
    });

    form.querySelector("#contact-reset")?.addEventListener("click", () => {
      form.reset();
      form.querySelectorAll<HTMLElement>("[data-error]").forEach((error) => {
        error.textContent = "";
        error.classList.add("hidden");
      });
      status.classList.add("hidden");
      success.classList.add("hidden");
      fields.classList.remove("hidden");
    });
  }
</script>
