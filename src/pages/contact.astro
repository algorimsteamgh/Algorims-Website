---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — Algorims" description="Get in touch with Algorims to scope your AI, cloud, or DevOps initiative. Most engagements start with a 30-minute conversation.">
<section class="contact-hero container-x" aria-labelledby="contact-title">
  <p class="contact-kicker">Contact us</p>
  <h1 id="contact-title">Let's build <span>what's next.</span></h1>
  <p>Tell us about your goals. We'll get back within one business day with next steps and a recommended consultation.</p>
</section>

<section class="container-x pb-16 lg:pb-24" aria-label="Contact details and enquiry form">
  <div class="contact-grid">
    <aside class="contact-details">
      <div>
        <p class="contact-label">Direct contact</p>
        <a href="mailto:contactus@algorims.com" class="contact-link">contactus@algorims.com</a>
        <a href="tel:+6583459599" class="contact-link">+65 8345 9599</a>
      </div>
      <div>
        <p class="contact-label">Headquarters</p>
        <p class="contact-place">Singapore</p>
        <p class="contact-address">2 Central Boulevard, #32-01<br/>IOI Central Boulevard Towers<br/>Singapore 018916</p>
      </div>
      <div>
        <p class="contact-label">Branches</p>
        <p class="contact-place">Tirupati, India</p>
        <p class="contact-address">STPI, Survey No. 234, Padmavathipuram, Beside Mahilapranganam, Tiruchanur Road, Tirupati, AP 517503</p>
        <p class="contact-place mt-5">Bengaluru, India</p>
        <p class="contact-address">2nd Floor, No 29/1, SK Mapple Hoskote Rd, Whitefield, Kadugodi, Bengaluru, Karnataka 560067</p>
      </div>
      <div>
        <p class="contact-label">Free consultation</p>
        <p class="contact-address">A 30-minute working session with one of our principal engineers to scope your initiative.</p>
      </div>
    </aside>

    <div class="contact-form-wrap">
          <form id="contact-form" novalidate>
            <div id="contact-success" class="hidden py-10 text-center">
              <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-primary/10 text-primary"><i data-lucide="check" class="!w-7 !h-7"></i></div>
              <h3 class="mt-5 text-2xl font-semibold">Thanks — message received</h3>
              <p class="mt-2 text-muted-foreground">We'll reply within one business day.</p>
              <button type="button" id="contact-reset" class="btn btn-outline btn-default mt-6 rounded-full">Send another message</button>
            </div>
            <div id="contact-fields" class="space-y-5">
              <p class="contact-label">Start a conversation</p>
              <h2 class="text-2xl font-semibold tracking-tight">Tell us about your project.</h2>
              <div class="grid gap-5 md:grid-cols-2">
                <div class="space-y-2">
                  <label for="name" class="text-sm font-medium">Name</label>
                  <input id="name" name="name" class="field" placeholder="Your full name" maxlength="100" />
                  <p data-error="name" class="text-xs text-destructive hidden"></p>
                </div>
                <div class="space-y-2">
                  <label for="email" class="text-sm font-medium">Work email</label>
                  <input id="email" name="email" type="email" class="field" placeholder="you@company.com" maxlength="255" />
                  <p data-error="email" class="text-xs text-destructive hidden"></p>
                </div>
              </div>
              <div class="grid gap-5 md:grid-cols-2">
                <div class="space-y-2">
                  <label for="company" class="text-sm font-medium">Company (optional)</label>
                  <input id="company" name="company" class="field" placeholder="Company name" maxlength="120" />
                </div>
                <div class="space-y-2">
                  <label for="service" class="text-sm font-medium">Service you're interested in</label>
                  <select id="service" name="service" class="field">
                    <option value="">Select a service…</option>
                    <option value="Cloud">Cloud</option>
                    <option value="DevOps">DevOps</option>
                    <option value="Development">Development</option>
                    <option value="AI">AI</option>
                    <option value="Data and ML">Data and ML</option>
                  </select>
                  <p data-error="service" class="text-xs text-destructive hidden"></p>
                </div>
              </div>
              <div class="space-y-2">
                <label for="message" class="text-sm font-medium">How can we help?</label>
                <textarea id="message" name="message" rows="9" maxlength="1000" class="field" placeholder="Tell us about your goals, timelines, and stack."></textarea>
                <p data-error="message" class="text-xs text-destructive hidden"></p>
              </div>
              <p id="contact-status" class="hidden text-sm text-destructive" role="alert"></p>
              <button type="submit" class="btn btn-hero btn-lg w-full md:w-auto">Send message <i data-lucide="arrow-right" class="!w-4 !h-4"></i></button>
            </div>
          </form>
    </div>
  </div>
</section>
</BaseLayout>

<style>
  .contact-hero { padding-top: 46px; padding-bottom: 50px; text-align: center; }
  .contact-kicker, .contact-label { color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .contact-hero h1 { max-width: 1050px; margin: 14px auto 0; font-size: clamp(2.7rem, 5.2vw, 4.8rem); font-weight: 600; line-height: 1; letter-spacing: -.06em; }
  .contact-hero h1 span { color: hsl(var(--primary)); }
  .contact-hero > p:last-child { max-width: 720px; margin: 24px auto 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.65; text-wrap: balance; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
  .contact-details { display: grid; align-content: start; gap: 0; min-width: 0; }
  .contact-details > div { padding: 28px 32px; }
  .contact-details > div + div { border-top: 1px solid hsl(var(--border)); }
  .contact-label { margin: 0 0 16px; }
  .contact-link { display: block; width: fit-content; max-width: 100%; margin-top: 8px; overflow-wrap: anywhere; font-weight: 600; }
  .contact-link:hover { color: hsl(var(--primary)); }
  .contact-place { margin: 0; font-weight: 600; }
  .contact-address { margin: 6px 0 0; color: hsl(var(--muted-foreground)); font-size: .9rem; line-height: 1.6; }
  .contact-form-wrap { min-width: 0; padding: clamp(28px, 4vw, 56px); border-left: 1px solid hsl(var(--border)); }
  @media (max-width: 767px) {
    .contact-hero { padding-top: 44px; padding-bottom: 36px; }
    .contact-hero h1 { font-size: 2.4rem; }
    .contact-grid { grid-template-columns: 1fr; }
    .contact-form-wrap { grid-row: 1; border-left: 0; border-bottom: 1px solid hsl(var(--border)); }
    .contact-details > div { padding: 24px 28px; }
  }
</style>

<script>
  import { sendForm, setButtonLoading } from "../scripts/formSubmission";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (form) {
    const fields = form.querySelector<HTMLElement>("#contact-fields")!;
    const success = form.querySelector<HTMLElement>("#contact-success")!;
    const status = form.querySelector<HTMLElement>("#contact-status")!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const key = import.meta.env.PUBLIC_WEB3FORMS_CONTACT_KEY;

    function setError(name: string, message: string) {
      const error = form!.querySelector<HTMLElement>(`[data-error="${name}"]`)!;
      error.textContent = message;
      error.classList.toggle("hidden", !message);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? "");
      const name = value("name");
      const email = value("email");
      const company = value("company");
      const service = value("service");
      const message = value("message");
      setError("name", name.trim().length < 2 ? "Please enter your name" : "");
      setError("email", !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) ? "Please enter a valid email" : "");
      setError("message", message.trim().length < 10 ? "Please share a few more details" : "");
      setError("service", !service ? "Please select a service" : "");
      if (form.querySelector('[data-error]:not(.hidden)')) return;
      status.classList.add("hidden");

      const subject = `New enquiry from ${name}${company ? ` (${company})` : ""}${service ? ` — ${service}` : ""}`;
      const body = [
        `Name: ${name}`, `Email: ${email}`, company ? `Company: ${company}` : null,
        service ? `Service: ${service}` : null, "", "Message:", message,
      ].filter(Boolean).join("\n");
      setButtonLoading(button, true);
      try {
        await sendForm(form, key, subject, "contactus@algorims.com", body);
        fields.classList.add("hidden");
        success.classList.remove("hidden");
      } catch {
        status.textContent = "Sorry — we couldn't send that just now. Please email contactus@algorims.com directly.";
        status.classList.remove("hidden");
      } finally {
        setButtonLoading(button, false);
      }
    });

    form.querySelector("#contact-reset")?.addEventListener("click", () => {
      form.reset();
      form.querySelectorAll<HTMLElement>("[data-error]").forEach((error) => {
        error.textContent = "";
        error.classList.add("hidden");
      });
      status.classList.add("hidden");
      success.classList.add("hidden");
      fields.classList.remove("hidden");
    });
  }
</script>
