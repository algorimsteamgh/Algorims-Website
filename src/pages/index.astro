<script>
  const hero = document.querySelector<HTMLElement>('[data-ai-hero]');
  if (hero) {
    const svg = hero.querySelector<SVGSVGElement>('svg');
    const cards = hero.querySelectorAll<HTMLElement>('[data-node-card]');
    const detail = hero.querySelector<HTMLElement>('[data-node-detail]');
    const label = hero.querySelector<HTMLElement>('[data-detail-label]');
    const description = hero.querySelector<HTMLElement>('[data-detail-desc]');
    const icon = hero.querySelector<HTMLElement>('[data-detail-icon]');
    const data = hero.querySelector<HTMLScriptElement>('[data-node-data]');

    if (detail && label && description && icon && data) {
      const nodes = JSON.parse(data.textContent || '[]') as Array<{ n: number; icon: string; label: string; desc: string }>;
      const resume = () => {
        hero.removeAttribute('data-paused');
        cards.forEach(card => card.removeAttribute('data-active'));
        detail.classList.remove('is-visible');
        svg?.unpauseAnimations?.();
      };
      const activate = (card: HTMLElement) => {
        const node = nodes.find(node => String(node.n) === card.dataset.nodeCard);
        if (!node) return;
        cards.forEach(item => item.toggleAttribute('data-active', item === card));
        label.textContent = node.label;
        description.textContent = node.desc;
        const glyph = document.createElement('i');
        glyph.dataset.lucide = node.icon;
        glyph.className = '!w-5 !h-5';
        icon.replaceChildren(glyph);
        (window as typeof window & { lucide?: { createIcons: (options: { nameAttr: string }) => void } }).lucide?.createIcons({ nameAttr: 'data-lucide' });
        detail.classList.add('is-visible');
        hero.setAttribute('data-paused', 'true');
        svg?.pauseAnimations?.();
      };

      cards.forEach(card => {
        card.addEventListener('mouseenter', () => activate(card));
        card.addEventListener('focus', () => activate(card));
        card.addEventListener('click', () => activate(card));
        card.addEventListener('keydown', event => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            activate(card);
          }
        });
      });
      hero.querySelector('[data-detail-close]')?.addEventListener('click', resume);
      hero.addEventListener('mouseleave', resume);
      hero.addEventListener('focusout', event => {
        if (!hero.contains(event.relatedTarget as Node | null)) resume();
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && hero.hasAttribute('data-paused')) resume();
      });
    }
  }
</script>
