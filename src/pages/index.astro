---
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemDiagram from "../components/illustrations/SystemDiagram.astro";
import ApproachShowcase from "../components/illustrations/ApproachShowcase.astro";

const logos = [
  ...Array.from({length:7},(_,i)=>`/assets/trusted/logo-${String(i+1).padStart(2,"0")}.png`),
  "/assets/trusted/logo-08.webp","/assets/trusted/logo-09.webp","/assets/trusted/logo-10.png","/assets/trusted/logo-11.svg",
  ...Array.from({length:5},(_,i)=>`/assets/trusted/logo-${String(i+12).padStart(2,"0")}.${i===3?"webp":"png"}`),
];
const stats=[["20+","Enterprises transformed"],["10+","Certified AI & Cloud engineers"],["7+","Industries and growing"],["99.99%","Enterprise-grade reliability"]];
const serviceLabels=[
  ["Requirements & APIs","Application engineering","Production software"],
  ["Data & workloads","Cloud engineering","Resilient infrastructure"],
  ["Code changes","Automated delivery","Reliable operations"],
];
const services=[
  ["Development","AI-ready applications engineered by senior developers—built to perform, scale, and integrate intelligently from day one. From enterprise platforms and APIs to system integrations, we deliver production-grade software designed to work alongside your AI infrastructure.","/services#dev","/assets/illustrations/service-development.png","/assets/illustrations/service-development-3d-dark.webp","Requirements and APIs connect through application engineering to production software."],
  ["Cloud Engineering","AWS-native foundations that eliminate waste, maximise performance, and turn infrastructure into a strategic asset—from landing zones and migrations to modernisation and cost optimisation.","/services#cloud","/assets/illustrations/service-cloud-engineering.png","/assets/illustrations/service-cloud-engineering-3d-dark.webp","Data and workloads connect through cloud engineering to resilient infrastructure."],
  ["DevOps & Platform","CI/CD pipelines, developer platforms, and SRE practices where speed, reliability, and security move together—from automated testing and observability to incident response.","/services#devops","/assets/illustrations/service-devops-platform.png","/assets/illustrations/service-devops-platform-3d-dark.webp","Code changes flow through automated delivery to reliable operations."],
];
const alliances = [
  {
    partner: "AWS Partner Network",
    tier: "Advanced Tier Services",
    title: "AWS Advanced Consulting Partner",
    logo: "/assets/aws-partner-badge.png",
    alt: "AWS Partner — Advanced Tier Services",
    body: "Certified, enterprise-grade expertise across AI, data, and cloud infrastructure—bringing architectural rigour, GenAI innovation, and proven AWS specialisations to every engagement.",
    tags: ["Amazon Bedrock", "SageMaker", "Amazon EKS", "Well-Architected", "GenAI Competency"],
    outcomes: [
      { title: "Well-Architected Reviews", desc: "Security, resilience & performance benchmarks" },
      { title: "GenAI Accelerators", desc: "Production foundation models on Amazon Bedrock" },
      { title: "Migration & Modernisation", desc: "Zero-downtime containerised workload transitions" },
      { title: "FinOps & Cost Governance", desc: "Cloud spend efficiency & architectural controls" },
    ],
  },
  {
    partner: "Xero Ecosystem",
    tier: "Certified Solutions Partner",
    title: "Xero Partner",
    logo: "/assets/partners/xero-blue-partner-badge.svg",
    alt: "Xero Solutions Partner",
    body: "We simplify accounting, automate financial processes, and improve financial visibility—configuring Xero around your workflow instead of the other way around.",
    tags: ["Invoicing & Payables", "Bank Reconciliation", "GST & IRAS Filing", "InvoiceNow Ready", "Custom Financial APIs"],
    outcomes: [
      { title: "Setup & Implementation", desc: "Tailored chart of accounts & workflow design" },
      { title: "Data Migration", desc: "Clean ledger transfers with complete audit integrity" },
      { title: "Automation & Integrations", desc: "Connected banking, ERP & real-time webhook sync" },
      { title: "Training & SLA Support", desc: "Team enablement, compliance & ongoing operational care" },
    ],
  },
];
---
<BaseLayout title="Algorims — The Future of Enterprise Is Autonomous. We Build It." description="Algorims builds autonomous, agentic AI systems for the enterprise — AI, data, AWS cloud, DevOps, and managed services.">
<div class="home"><div class="frame">
  <section class="hero" aria-labelledby="home-title">
    <p class="kicker">AWS Advanced Consulting Partner</p>
    <h1 id="home-title">The Future of Enterprise<br/>Is <span>Autonomous.</span></h1>
    <p class="hero-copy">We design and build AI systems that turn complex operations into measurable outcomes.</p>
    <div class="actions"><a class="action btn-hero" href="/contact">Get started →</a><a class="action" href="/agentic-ai">Explore Agentic AI</a></div>
    <SystemDiagram />
  </section>
  <section class="trusted" aria-labelledby="trusted-title"><h2 id="trusted-title" style="margin-inline:auto;text-align:center">Trusted by teams shipping at enterprise scale</h2><div class="trusted-window"><div class="trusted-track">{logos.map(src=><img src={src} alt="Algorims client logo" loading="lazy"/>)}{logos.map(src=><img src={src} alt="" aria-hidden="true" loading="lazy"/>)}</div></div></section>

  <section class="approach section" aria-labelledby="approach-title"><header><p class="kicker">How we work</p><h2 id="approach-title">Complexity in. <span>Clarity out.</span></h2><p>We are built for enterprises navigating complex transformations. Every engagement begins with deep discovery—not assumptions or templates.</p></header>
    <ApproachShowcase />
    <p class="approach-note">The harder the problem, the more we lean in—bringing clarity, speed, and precision to challenges that others find too difficult to solve.</p>
  </section>

  <section class="services section" aria-labelledby="services-title"><header><p class="kicker">What we do</p><h2 id="services-title">From cloud to agentic. <span>End to end.</span></h2><p>Three practices. One relentless focus: enterprise-grade systems that drive measurable business value.</p></header><div class="service-showcase"><div class="service-grid">{services.map(([title,body,href,,,_flow],i)=><article class="service-choice" data-active={i===0}><button type="button" aria-controls="service-visual" aria-pressed={i===0} data-service={i} data-flow={services[i][5]} data-input={serviceLabels[i][0]} data-core={serviceLabels[i][1]} data-outcome={serviceLabels[i][2]}><span class="service-index">0{i+1}</span><span class="service-title">{title}</span></button><div class="service-detail"><div><p>{body}</p><a href={href}>Learn more →</a></div></div></article>)}</div><figure class="service-visual" id="service-visual">{services.map(([,,,lightImg,darkImg,flow],i)=><Fragment><img class="service-art-light" src={lightImg} alt={flow} data-slide={i} class:list={[{active:i===0}]} width="724" height="724" loading={i===0?"eager":"lazy"}/><img class="service-art-dark" src={darkImg} alt="" aria-hidden="true" data-slide={i} class:list={[{active:i===0}]} width="1254" height="1254" loading={i===0?"eager":"lazy"}/></Fragment>)}<figcaption class="service-labels" aria-live="polite"><span><b>Inputs</b><span data-service-label="input">{serviceLabels[0][0]}</span></span><span><b>Core</b><span data-service-label="core">{serviceLabels[0][1]}</span></span><span><b>Outcome</b><span data-service-label="outcome">{serviceLabels[0][2]}</span></span></figcaption></figure></div></section>

  <section class="work section" aria-labelledby="work-title"><header><p class="kicker">Selected work</p><h2 id="work-title">Intelligence delivered. <span>Impact measured.</span></h2><p>Built for the complexity of real operations. Measured by what changes after launch.</p><a href="/case-studies">View all case studies →</a></header>
    <article class="case"><div class="case-art"><figure class="case-art-figure"><img class="case-art-light" src="/assets/illustrations/case-qsr-analytics.webp" alt="Transaction, staffing, and store operations data flow into Algorims conversational analytics and produce workforce intelligence." width="1774" height="887" loading="lazy"/><img class="case-art-dark" src="/assets/illustrations/case-qsr-analytics-dark.webp" alt="Transaction, staffing, and store operations data flow into Algorims conversational analytics and produce workforce intelligence." width="1774" height="887" loading="lazy"/><figcaption><span class="case-label"><b>Inputs</b> Transactions &amp; POS · Staffing rosters · Store operations</span><span class="case-label"><b>Core</b> Conversational analytics</span><span class="case-label"><b>Outcome</b> Workforce intelligence</span></figcaption></figure></div><div class="case-copy"><p class="kicker">01 / Agentic AI · Quick service restaurants</p><h3>Workforce decisions, backed by live intelligence.</h3><p>A Singapore QSR operator had critical workforce data buried in manual reports. We built conversational analytics on AWS so teams can ask questions in plain English and act on current insights.</p><dl><div><dt>490K+</dt><dd>transactions analysed</dd></div><div><dt>46%</dt><dd>productivity gap uncovered</dd></div><div><dt>4 weeks</dt><dd>to deployment</dd></div></dl><a href="/case-studies/qsr-conversational-analytics">Explore the case study <span aria-hidden="true">↗</span></a></div></article>
    <article class="case reverse"><div class="case-art"><figure class="case-art-figure"><img class="case-art-light" src="/assets/illustrations/case-recruitment.webp" alt="Applications, candidate profiles, and hiring criteria flow through Algorims recruitment platform to a qualified shortlist." width="1774" height="887" loading="lazy"/><img class="case-art-dark" src="/assets/illustrations/case-recruitment-dark.webp" alt="Applications, candidate profiles, and hiring criteria flow through Algorims recruitment platform to a qualified shortlist." width="1774" height="887" loading="lazy"/><figcaption><span class="case-label"><b>Inputs</b> Applications · Talent profiles · Hiring workflow</span><span class="case-label"><b>Core</b> Recruitment engine</span><span class="case-label"><b>Outcome</b> Qualified shortlist</span></figcaption></figure></div><div class="case-copy"><p class="kicker">02 / Cloud · SaaS</p><h3>From application to offer, without the bottlenecks.</h3><p>Manual screening and disconnected hiring steps slowed access to talent. We built a recruitment platform on AWS to connect applications, screening, and shortlisting in one workflow.</p><dl><div><dt>60%</dt><dd>faster time to hire</dd></div><div><dt>0</dt><dd>manual screening steps</dd></div><div><dt>Faster</dt><dd>access to top talent</dd></div></dl><a href="/case-studies">Explore more work <span aria-hidden="true">↗</span></a></div></article>
  </section>

  <section class="alliances section" aria-labelledby="alliances-title">
    <header>
      <p class="kicker">Strategic alliances</p>
      <h2 id="alliances-title">Specialist platforms. <span>Enterprise outcomes.</span></h2>
      <p>Direct tier partnerships and certified specialisations that give our enterprise clients architectural assurance, accelerated delivery, and SLA-backed execution.</p>
    </header>
    <div class="alliances-list">
      {alliances.map((a) => (
        <article class="alliance-card">
          <div class="alliance-bar">
            <div class="alliance-meta">
              <span class="status-indicator" aria-hidden="true"></span>
              <span class="partner-tag">{a.partner}</span>
              <span class="meta-separator" aria-hidden="true">/</span>
              <span class="tier-tag">{a.tier}</span>
            </div>
          </div>

          <div class="alliance-body">
            <div class="alliance-profile">
              <div class="alliance-brand">
                <div class="badge-plinth">
                  <img src={a.logo} alt={a.alt} width="110" height="110" loading="lazy" />
                </div>
                <div class="brand-copy">
                  <h3>{a.title}</h3>
                  <p>{a.body}</p>
                </div>
              </div>

              <div class="alliance-specialisations">
                <span class="spec-label">Verified Competencies</span>
                <ul class="tag-list" aria-label={`Competencies for ${a.title}`}>
                  {a.tags.map((tag) => (
                    <li>
                      <span class="tag-dot" aria-hidden="true"></span>
                      <span>{tag}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="alliance-outcomes">
              <div class="outcomes-header">
                <span class="outcomes-kicker">Delivered Capabilities</span>
                <span class="outcomes-caption">Production Deliverables</span>
              </div>
              <div class="outcomes-grid">
                {a.outcomes.map((o) => (
                  <div class="outcome-cell">
                    <div class="outcome-icon" aria-hidden="true">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </div>
                    <div class="outcome-text">
                      <h4>{o.title}</h4>
                      <p>{o.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="proof" aria-labelledby="proof-title"><h2 id="proof-title">Trusted by enterprises across Singapore, SEA and beyond</h2><div class="stats" aria-label="Algorims in numbers">{stats.map(([value,label])=><div><strong data-counter>{value}</strong><span>{label}</span></div>)}</div></section>

  <section class="closing" aria-labelledby="closing-title"><p class="kicker">Ready when you are</p><h2 id="closing-title">Let's architect your <span>Agentic Enterprise.</span></h2><p>Talk to our team about your AI, cloud, or platform engineering goals. We'll design a plan that scales with your business.</p><div class="actions"><a class="action btn-hero" href="/contact">Book a consultation →</a><a class="action" href="/services">Explore services</a></div></section>
</div></div>
</BaseLayout>
<style>
.service-index,
.case-copy .kicker { display: none; }
h1,h2,h3{font-weight:600}
.home{background:hsl(var(--background))}.frame{background:hsl(var(--background))}.hero{text-align:center;padding:46px 24px 0}.kicker{margin:0 0 14px;color:hsl(var(--primary));font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}h1{max-width:1050px;margin:auto;font-size:clamp(2.7rem,5.2vw,4.8rem);line-height:1;letter-spacing:-.06em}h1 span,h2 span{color:hsl(var(--primary))}.hero-copy{max-width:720px;margin:24px auto 0;color:hsl(var(--muted-foreground));font-size:clamp(1rem,1.4vw,1.15rem);line-height:1.65;text-wrap:balance}.section header>p:last-child,.closing>p{margin:0;color:hsl(var(--muted-foreground));line-height:1.6}.actions{display:flex;justify-content:center;gap:14px;margin:26px 0}.action{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 25px;border-radius:9999px;font-weight:600}.action:not(.btn-hero){border:1px solid hsl(var(--foreground))}.action:not(.btn-hero):hover{border-color:hsl(var(--primary))}.trusted{overflow:hidden;padding:36px 0;border-top:1px solid hsl(var(--border));text-align:center}.trusted h2{margin:0 20px 24px;color:hsl(var(--muted-foreground));font-size:.75rem;letter-spacing:.16em;text-transform:uppercase}.trusted-window{overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}.trusted-track{display:flex;width:max-content;align-items:center;gap:50px;animation:trusted-marquee 50s linear infinite}.trusted-track img{width:auto;height:40px;max-width:125px;object-fit:contain;filter:grayscale(1);opacity:.62}.stats{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid hsl(var(--border))}.stats div{display:grid;gap:7px;padding:34px 18px;text-align:center}.stats div+div{border-left:1px solid hsl(var(--border))}.stats strong{color:hsl(var(--primary));font-size:clamp(2rem,3.5vw,3rem)}.stats span{color:hsl(var(--muted-foreground));font-size:.82rem}.section,.closing{padding:90px clamp(24px,5vw,74px);border-top:1px solid hsl(var(--border))}.section>header{max-width:760px;margin:0 auto 48px;text-align:center}.section h2,.closing h2{margin:0;font-size:clamp(2.2rem,3.7vw,3.7rem);line-height:1.06;letter-spacing:-.05em}.section header>p:last-child{margin-top:16px}.approach-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid hsl(var(--border))}.approach-grid figure{margin:0;min-width:0}.approach-grid figure+figure{border-left:1px solid hsl(var(--border))}.approach-grid img{display:block;width:100%;height:auto;aspect-ratio:1200/760;object-fit:cover;border-bottom:1px solid hsl(var(--border))}.approach-grid figcaption{padding:28px}.approach-grid figcaption span{display:block;margin-bottom:12px;color:hsl(var(--primary));font-size:.72rem;font-weight:700;letter-spacing:.18em}.approach-grid h3{margin:0;font-size:1.35rem}.approach-grid p,.approach-note{color:hsl(var(--muted-foreground));line-height:1.6}.approach-grid p{margin:10px 0 0}.approach-note{max-width:760px;margin:30px auto 0;text-align:center}.wide-art{display:block;width:100%;height:auto;border:1px solid hsl(var(--border));padding:30px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid hsl(var(--border));border-top:0}.service-grid article{padding:30px}.service-grid article+article{border-left:1px solid hsl(var(--border))}.service-grid h3,.case h3{margin:0;font-size:1.45rem}.service-grid p,.case>div>p:not(.kicker){color:hsl(var(--muted-foreground));line-height:1.6}.service-grid a,.case a{color:hsl(var(--primary));font-weight:600}.work>header{display:flex;max-width:none;align-items:end;justify-content:space-between;text-align:left}.work>header a{white-space:nowrap}.case{display:grid;grid-template-columns:1fr 1fr;align-items:center;border:1px solid hsl(var(--border))}.case+.case{margin-top:28px}.case-art{display:grid;place-items:center;min-height:480px;padding:42px;border-right:1px solid hsl(var(--border));overflow:hidden}.case.reverse .case-art{order:2;border-right:0;border-left:1px solid hsl(var(--border))}.case-art>img{width:100%;height:auto}.case>div:last-child{padding:clamp(28px,4vw,52px)}.case h3{font-size:clamp(1.6rem,2.5vw,2.35rem);line-height:1.12;letter-spacing:-.035em}.case dl{display:grid;grid-template-columns:auto 1fr;gap:7px 14px;padding:18px;border:1px solid hsl(var(--border))}.case dt{color:hsl(var(--primary));font-weight:700}.case dd{margin:0;color:hsl(var(--muted-foreground));font-size:.82rem}.hiring>div{display:flex;align-items:center;gap:18px}.hiring span{padding:18px;border:1px solid hsl(var(--border));text-align:center}.hiring img{width:110px;padding:24px;background:#202125}.hiring strong{margin-top:25px;color:hsl(var(--primary))}.closing{text-align:center}.closing h2,.closing>p{max-width:740px;margin:auto}.closing>p{margin-top:18px}:global(.dark) .trusted-track img{box-sizing:border-box;padding:7px;border-radius:5px;background:#fff;filter:none;opacity:1}
.alliances-list{display:flex;flex-direction:column;gap:32px}.alliance-card{position:relative;border:1px solid hsl(var(--border));background:hsl(var(--background));transition:border-color .25s ease,box-shadow .25s ease}.alliance-card:hover{border-color:hsl(var(--primary)/.5);box-shadow:0 14px 36px -12px hsl(var(--primary)/.08)}.alliance-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 28px;border-bottom:1px solid hsl(var(--border));background:hsl(var(--muted)/.35)}.alliance-meta{display:flex;align-items:center;gap:10px;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.status-indicator{width:7px;height:7px;border-radius:50%;background:hsl(var(--primary));box-shadow:0 0 8px hsl(var(--primary)/.6)}.partner-tag{color:hsl(var(--foreground))}.meta-separator{color:hsl(var(--border))}.tier-tag{color:hsl(var(--primary))}.alliance-body{display:grid;grid-template-columns:1.15fr .85fr;min-height:0}.alliance-profile{display:flex;flex-direction:column;justify-content:space-between;gap:28px;padding:clamp(28px,3.5vw,42px);border-right:1px solid hsl(var(--border))}.alliance-brand{display:flex;gap:26px;align-items:flex-start}.badge-plinth{flex-shrink:0;display:grid;place-items:center;width:108px;height:108px;padding:12px;background:#fff;border:1px solid hsl(var(--border));border-radius:12px;box-shadow:0 4px 16px -4px rgba(0,0,0,.06)}.badge-plinth img{width:100%;height:100%;object-fit:contain}:global(.dark) .badge-plinth{background:#fff;border:1px solid hsl(var(--border)/.8);box-shadow:0 6px 24px -4px rgba(0,0,0,.5)}.brand-copy h3{margin:0 0 10px;font-size:clamp(1.35rem,1.8vw,1.65rem);font-weight:600;letter-spacing:-.03em;line-height:1.2;color:hsl(var(--foreground))}.brand-copy p{margin:0;color:hsl(var(--muted-foreground));font-size:.94rem;line-height:1.6}.alliance-specialisations{padding-top:20px;border-top:1px solid hsl(var(--border)/.6)}.spec-label{display:block;margin-bottom:12px;color:hsl(var(--primary));font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.tag-list{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}.tag-list li{display:inline-flex;align-items:center;gap:6px;padding:5px 11px;border:1px solid hsl(var(--border));border-radius:6px;background:hsl(var(--muted)/.45);font-size:.78rem;font-weight:500;color:hsl(var(--foreground));transition:border-color .2s ease,background .2s ease}.tag-list li:hover{border-color:hsl(var(--primary));background:hsl(var(--primary)/.08)}.tag-dot{width:4px;height:4px;border-radius:1px;background:hsl(var(--primary))}.alliance-outcomes{display:flex;flex-direction:column}.outcomes-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid hsl(var(--border));background:hsl(var(--muted)/.25)}.outcomes-kicker{color:hsl(var(--primary));font-size:.7rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.outcomes-caption{color:hsl(var(--muted-foreground));font-size:.75rem}.outcomes-grid{display:grid;grid-template-columns:1fr 1fr;height:100%}.outcome-cell{display:flex;flex-direction:column;gap:6px;padding:24px 22px;transition:background .2s ease}.outcome-cell:hover{background:hsl(var(--muted)/.35)}.outcome-cell:nth-child(odd){border-right:1px solid hsl(var(--border))}.outcome-cell:nth-child(-n+2){border-bottom:1px solid hsl(var(--border))}.outcome-icon{display:grid;place-items:center;width:24px;height:24px;margin-bottom:4px;border-radius:5px;background:hsl(var(--primary)/.12);color:hsl(var(--primary))}.outcome-text h4{margin:0;font-size:.95rem;font-weight:600;line-height:1.25;color:hsl(var(--foreground))}.outcome-text p{margin:4px 0 0;font-size:.8rem;line-height:1.45;color:hsl(var(--muted-foreground))}
@media(max-width:850px){.stats{grid-template-columns:1fr 1fr}.approach-grid,.service-grid,.case{grid-template-columns:1fr}.approach-grid figure+figure,.service-grid article+article{border-top:1px solid hsl(var(--border));border-left:0}.approach-grid img{aspect-ratio:16/8;object-fit:cover}.case-art,.case.reverse .case-art{order:0;min-height:320px;border-right:0;border-bottom:1px solid hsl(var(--border));border-left:0}.alliance-body{grid-template-columns:1fr}.alliance-profile{border-right:0;border-bottom:1px solid hsl(var(--border))}}
@media(max-width:600px){.hero{padding:44px 18px 0}h1{font-size:2.4rem}.actions{flex-direction:column}.stats{grid-template-columns:1fr}.stats div+div{border-top:1px solid hsl(var(--border));border-left:0}.section{padding:62px 20px}.work>header{display:block}.work>header a{display:inline-block;margin-top:18px}.flow,.wide-art{padding:20px}.hiring>div{flex-direction:column}.alliance-bar{flex-direction:column;align-items:flex-start;gap:10px;padding:14px 18px}.alliance-brand{flex-direction:column;gap:18px}.badge-plinth{width:92px;height:92px;padding:10px}.alliance-profile{padding:24px 18px;gap:22px}.outcomes-header{padding:14px 18px;flex-direction:column;align-items:flex-start;gap:4px}.outcomes-grid{grid-template-columns:1fr}.outcome-cell{padding:18px}.outcome-cell:nth-child(odd){border-right:0}.outcome-cell:not(:last-child){border-bottom:1px solid hsl(var(--border))}}@media(prefers-reduced-motion:reduce){.trusted-track{animation:none}.alliance-card,.tag-list li,.outcome-cell{transition:none}}
.approach-art{width:100%;aspect-ratio:3/2;background-size:contain;background-position:center;background-repeat:no-repeat;border-bottom:1px solid hsl(var(--border))}
.approach-art.discover{background-image:url('/assets/illustrations/approach-discover.webp')}
.approach-art.design{background-image:url('/assets/illustrations/approach-design.webp')}
.approach-art.deploy{background-image:url('/assets/illustrations/approach-deploy.webp')}
:global(.dark) .approach-art.discover{background-image:url('/assets/illustrations/approach-discover-dark.webp')}
:global(.dark) .approach-art.design{background-image:url('/assets/illustrations/approach-design-dark.webp')}
:global(.dark) .approach-art.deploy{background-image:url('/assets/illustrations/approach-deploy-dark.webp')}
:global(.dark) .wide-art{filter:drop-shadow(0 0 1px hsl(220 13% 80%))}
.work>header{display:block;max-width:760px;margin:0 auto 42px;text-align:center}.work>header>p:not(.kicker){max-width:560px;margin:17px auto 0;color:hsl(var(--muted-foreground));line-height:1.6}.work>header>a{display:inline-block;margin-top:20px;color:hsl(var(--primary));font-weight:600}.case{grid-template-columns:1.15fr .85fr;align-items:stretch}.case+.case{margin-top:18px}.case-art{display:flex;align-items:center;justify-content:center;min-height:0;padding:clamp(12px,2vw,28px);background:hsl(var(--background));border-right:1px solid hsl(var(--border));overflow:hidden}.case.reverse .case-art{order:2;border-right:0;border-left:1px solid hsl(var(--border))}.case>.case-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:clamp(30px,4vw,58px)}.case-copy .kicker{margin-bottom:18px}.case-copy h3{max-width:530px;font-size:clamp(1.8rem,2.7vw,2.65rem)}.case-copy>p:not(.kicker){max-width:550px;margin:18px 0 0}.case-copy dl{display:grid;grid-template-columns:repeat(3,1fr);width:100%;gap:0;margin:30px 0 26px;padding:0;border:0;border-top:1px solid hsl(var(--border));border-bottom:1px solid hsl(var(--border))}.case-copy dl>div{padding:18px 12px 18px 0}.case-copy dl>div+div{padding-left:16px;border-left:1px solid hsl(var(--border))}.case-copy dt{font-size:clamp(1.4rem,2vw,2rem);line-height:1.1}.case-copy dd{margin-top:7px;line-height:1.35}.case-copy>a{display:inline-flex;align-items:center;gap:12px;min-height:44px;text-decoration:underline;text-underline-offset:5px}.case-copy>a span{font-size:1.2em}.case-copy>a:hover{color:hsl(var(--foreground))}
@media(max-width:850px){.case{grid-template-columns:1fr}.case.reverse .case-art{order:0;border-left:0}.case-art{border-right:0;border-bottom:1px solid hsl(var(--border))}.case>.case-copy{padding:34px}}
@media(max-width:600px){.work>header{margin-bottom:34px}.case-art{padding:10px}.case>.case-copy{padding:26px}.case-copy dl{margin:24px 0 18px}.case-copy dl>div{padding:14px 7px 14px 0}.case-copy dl>div+div{padding-left:9px}.case-copy dt{font-size:1.25rem}.case-copy dd{font-size:.72rem}}
.service-showcase{display:grid;grid-template-columns:minmax(280px,.78fr) minmax(0,1.22fr);border:1px solid hsl(var(--border))}
.service-grid{display:block;border:0;border-right:1px solid hsl(var(--border))}
.service-grid .service-choice{position:relative;padding:0}
.service-grid .service-choice+.service-choice{border-top:1px solid hsl(var(--border));border-left:0}
.service-choice button{display:block;width:100%;padding:26px 30px;border:0;background:transparent;color:hsl(var(--muted-foreground));font:inherit;text-align:left;cursor:pointer}
.service-choice button:hover,.service-choice[data-active="true"] button{color:hsl(var(--foreground))}
.service-index{display:block;margin-bottom:10px;color:hsl(var(--primary));font-size:.7rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
.service-title{display:block;font-size:clamp(1.25rem,1.8vw,1.65rem);font-weight:600;letter-spacing:-.025em}
.service-detail{display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows .5s ease,opacity .35s ease}
.service-detail>*{overflow:hidden}
.service-detail p{margin:0;padding:0 30px;color:hsl(var(--muted-foreground));line-height:1.55}
.service-detail a{display:block;width:max-content;margin:0 30px;color:hsl(var(--primary));font-weight:600}
.service-choice[data-active="true"] .service-detail{grid-template-rows:1fr;opacity:1}
.service-choice[data-active="true"] .service-detail a{margin-top:16px;margin-bottom:30px}
.service-choice[data-active="true"]::after{content:"";position:absolute;bottom:-1px;left:0;height:2px;background:hsl(var(--primary));animation:service-progress 5s linear forwards}
.service-showcase:hover .service-choice[data-active="true"]::after,.service-showcase:focus-within .service-choice[data-active="true"]::after{animation-play-state:paused}
.service-visual{position:relative;display:grid;place-items:center;min-width:0;min-height:520px;margin:0;overflow:hidden;background:linear-gradient(135deg,hsl(var(--background)),hsl(var(--muted) / .45))}
.service-visual img{position:absolute;inset:0;margin:auto;width:78%;max-width:560px;height:auto;opacity:0;transform:scale(.96);transition:opacity .6s ease,transform .75s cubic-bezier(.22,1,.36,1)}.service-visual .service-art-dark{display:none}:global(.dark) .service-visual .service-art-light{display:none}:global(.dark) .service-visual .service-art-dark{display:block;width:70%;max-width:500px}
.service-visual img.active{opacity:1;transform:scale(1)}
.service-labels{position:absolute;right:24px;bottom:20px;left:24px;display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:10px;margin:0}.service-labels>span{padding:10px 12px;border:1px solid hsl(var(--border));background:hsl(var(--background) / .78);color:hsl(var(--muted-foreground));font-size:.68rem;line-height:1.35;backdrop-filter:blur(8px)}.service-labels b{display:block;margin-bottom:3px;color:hsl(var(--primary));font-size:.62rem;letter-spacing:.14em;text-transform:uppercase}.service-labels [data-service-label]{display:block}
@keyframes service-progress{from{width:0}to{width:100%}}
@media(max-width:850px){.service-showcase{grid-template-columns:1fr}.service-grid{border-right:0;border-bottom:1px solid hsl(var(--border))}.service-visual{min-height:0;aspect-ratio:1.6}.service-choice button{padding:20px 24px}.service-detail p{padding:0 24px}.service-detail a{margin-left:24px}}
@media(max-width:600px){.service-visual{aspect-ratio:1.25}.service-choice[data-active="true"] .service-detail a{margin-bottom:24px}}
@media(prefers-reduced-motion:reduce){.service-detail,.service-visual img{transition:none}.service-choice[data-active="true"]::after{animation:none;width:100%}}
</style>
<style>
.case-art>img{display:block;width:100%;height:auto;object-fit:contain}.case-art-figure{width:100%;margin:0}.case-art-figure figcaption{display:grid;grid-template-columns:1.35fr .9fr 1fr;gap:10px;margin-top:16px}.case-label{display:block;padding:10px 12px;border:1px solid hsl(var(--border));color:hsl(var(--muted-foreground));font-size:.68rem;line-height:1.35}.case-label b{display:block;margin-bottom:3px;color:hsl(var(--primary));font-size:.62rem;letter-spacing:.14em;text-transform:uppercase}.case-art-dark{display:none!important}:global(.dark) .case-art-light{display:none!important}:global(.dark) .case-art-dark{display:block!important}
@media(max-width:600px){.case-art-figure figcaption{grid-template-columns:1fr}.case-label{font-size:.72rem}}
</style>
<style>
.trusted h2,.proof h2{max-width:760px;margin:0 auto 24px;padding:0 20px;text-align:center}.proof{padding:72px clamp(24px,5vw,74px) 0}.stats strong{font-variant-numeric:tabular-nums}
.stats,.approach-grid,.case,.alliance-card,.service-showcase{overflow:hidden;border-radius:1.5rem}.stats{border:1px solid hsl(var(--border))}.proof+.closing{border-top:0!important}.wide-art{border-radius:1.5rem}.service-labels>span,.case-label{border-radius:.75rem}
@media(max-width:600px){.proof{padding-inline:20px}}
.proof{padding:90px clamp(24px,5vw,74px)}
@media(max-width:600px){.proof,.closing{padding:62px 20px}}
</style>
<style>
.case.reverse{grid-template-columns:.85fr 1.15fr}
@media(max-width:850px){.case.reverse{grid-template-columns:1fr}}
</style>
<script>
  const showcase = document.querySelector<HTMLElement>('.service-showcase');
  if (showcase) {
    const choices = [...showcase.querySelectorAll<HTMLButtonElement>('[data-service]')];
    const visual = showcase.querySelector<HTMLElement>('.service-visual');
    const images = [...(visual?.querySelectorAll<HTMLImageElement>('img[data-slide]') ?? [])];
    const caption = visual?.querySelector('figcaption');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let visible = false;
    let timer: number | undefined;
    const stop = () => { clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (visible && !reducedMotion.matches && !showcase.matches(':hover') && !showcase.contains(document.activeElement)) timer = window.setInterval(() => select((active + 1) % choices.length), 5000);
    };
    const select = (index: number) => {
      active = index;
      choices.forEach((choice, i) => {
        choice.setAttribute('aria-pressed', String(i === index));
        choice.closest<HTMLElement>('.service-choice')!.dataset.active = String(i === index);
      });
      images.forEach((img) => img.classList.toggle('active', Number(img.dataset.slide) === index));
      if (caption) {
        caption.querySelector<HTMLElement>('[data-service-label="input"]')!.textContent = choices[index].dataset.input || '';
        caption.querySelector<HTMLElement>('[data-service-label="core"]')!.textContent = choices[index].dataset.core || '';
        caption.querySelector<HTMLElement>('[data-service-label="outcome"]')!.textContent = choices[index].dataset.outcome || '';
      }
      start();
    };
    choices.forEach((choice, i) => choice.addEventListener('click', () => select(i)));
    showcase.addEventListener('mouseenter', stop);
    showcase.addEventListener('mouseleave', start);
    showcase.addEventListener('focusin', stop);
    showcase.addEventListener('focusout', () => requestAnimationFrame(start));
    reducedMotion.addEventListener('change', start);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; visible ? start() : stop(); }, { threshold: .2 }).observe(showcase);
  }
</script>
