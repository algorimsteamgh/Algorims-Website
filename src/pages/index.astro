---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrustedTeams from "../components/TrustedTeams.astro";
import ServiceShowcase from "../components/ServiceShowcase.astro";
import PartnerGrid from "../components/PartnerGrid.astro";
import SolutionsShowcase from "../components/SolutionsShowcase.astro";
import WhyAlgorims from "../components/WhyAlgorims.astro";
import ConsultationCta from "../components/ConsultationCta.astro";
import SystemDiagram from "../components/illustrations/SystemDiagram.astro";
import ApproachShowcase from "../components/illustrations/ApproachShowcase.astro";
import { getEntry } from "astro:content";
import CaseStudyCard from "../components/case-studies/CaseStudyCard.astro";

const stats=[["20+","Projects delivered"],["10+","Certified AI & Cloud engineers"],["7+","Industries and growing"],["99.9%","System uptime"]];
const featuredStudies = await Promise.all([
  getEntry("case-studies", "qsr-conversational-analytics"),
  getEntry("case-studies", "ai-school-scheduler"),
]);
---
<BaseLayout title="Algorims — The Future of Enterprise Is Autonomous. We Build It." description="Algorims builds autonomous, agentic AI systems for the enterprise — AI, data, AWS cloud, DevOps, and managed services.">
<div class="home"><div class="frame">
  <section class="hero" aria-labelledby="home-title">
    <p class="kicker">AWS Advanced Tier Services Partner</p>
    <h1 id="home-title">The Future of Enterprise<br/>Is <span>Autonomous.</span></h1>
    <p class="hero-copy">We design and build AI systems that turn complex operations into measurable outcomes.</p>
    <div class="actions"><a class="action btn-hero" href="/contact">Get started →</a><a class="action" href="/agentic-ai">Explore Agentic AI</a></div>
    <SystemDiagram />
  </section>
  <TrustedTeams />

  <section class="services section" aria-labelledby="services-title">
    <header>
      <p class="kicker">What we do</p>
      <h2 id="services-title">From code to cloud. <span>End to end.</span></h2>
    </header>
    <ServiceShowcase />
  </section>

  <section class="solutions-home section" aria-labelledby="solutions-home-title">
    <header>
      <p class="kicker">Solutions</p>
      <h2 id="solutions-home-title">Put the busywork <span>on autopilot.</span></h2>
      <p>Ready-to-deploy AI systems for the operations that eat the most hours, built around your workflows and running in your AWS account.</p>
    </header>
    <SolutionsShowcase heading="h3" />
  </section>

  <section class="work section" aria-labelledby="work-title"><header><p class="kicker">Selected work</p><h2 id="work-title">Intelligence delivered. <span>Impact measured.</span></h2><p>Built for the complexity of real operations. Measured by what changes after launch.</p><a href="/case-studies">View all case studies →</a></header>
    <div class="work-grid">
      {featuredStudies.map(study => <CaseStudyCard study={study!} heading="h3" />)}
    </div>
  </section>

  <section class="approach section" aria-labelledby="approach-title">
    <header>
      <p class="kicker">How we work</p>
      <h2 id="approach-title">Complexity in. <span>Clarity out.</span></h2>
    </header>
    <ApproachShowcase />
  </section>

  <PartnerGrid />

  <WhyAlgorims />



  <section class="proof" aria-labelledby="proof-title"><h2 id="proof-title">Algorims in numbers</h2><div class="stats">{stats.map(([value,label])=><div><strong data-counter>{value}</strong><span>{label}</span></div>)}</div></section>

  <ConsultationCta />

</div></div>
</BaseLayout>
<style>
h1,h2,h3{font-weight:600}
.home{background:hsl(var(--background))}.frame{background:hsl(var(--background))}.hero{text-align:center;padding:46px 24px 0}.kicker{margin:0 0 14px;color:hsl(var(--primary));font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}h1{max-width:1050px;margin:auto;font-size:clamp(2.7rem,5.2vw,4.8rem);line-height:1;letter-spacing:-.06em}h1 span,h2 span{color:hsl(var(--primary))}.hero-copy{max-width:720px;margin:24px auto 0;color:hsl(var(--muted-foreground));font-size:clamp(1rem,1.4vw,1.15rem);line-height:1.65;text-wrap:balance}.section header>p:last-child,.closing>p{margin:0;color:hsl(var(--muted-foreground));line-height:1.6}.actions{display:flex;justify-content:center;gap:14px;margin:26px 0}.action{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 25px;border-radius:9999px;font-weight:600}.action:not(.btn-hero){border:1px solid hsl(var(--foreground))}.action:not(.btn-hero):hover{border-color:hsl(var(--primary))}.stats{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid hsl(var(--border))}.stats div{display:grid;gap:7px;padding:34px 18px;text-align:center}.stats div+div{border-left:1px solid hsl(var(--border))}.stats strong{color:hsl(var(--primary));font-size:clamp(2rem,3.5vw,3rem)}.stats span{color:hsl(var(--muted-foreground));font-size:.82rem}.section,.closing{padding:90px clamp(24px,5vw,74px);border-top:1px solid hsl(var(--border))}.section>header{max-width:760px;margin:0 auto 48px;text-align:center}.section h2,.closing h2{margin:0;font-size:clamp(2.2rem,3.7vw,3.7rem);line-height:1.06;letter-spacing:-.05em}.section header>p:last-child{margin-top:16px}.wide-art{display:block;width:100%;height:auto;border:1px solid hsl(var(--border));padding:30px}.work>header{display:flex;max-width:none;align-items:end;justify-content:space-between;text-align:left}.work>header a{white-space:nowrap}.hiring>div{display:flex;align-items:center;gap:18px}.hiring span{padding:18px;border:1px solid hsl(var(--border));text-align:center}.hiring img{width:110px;padding:24px;background:#202125}.hiring strong{margin-top:25px;color:hsl(var(--primary))}.closing{text-align:center}.closing h2,.closing>p{max-width:740px;margin:auto}.closing>p{margin-top:18px}
@media(max-width:850px){.stats{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.hero{padding:44px 18px 0}h1{font-size:2.4rem}.actions{flex-direction:column}.stats{grid-template-columns:1fr}.stats div+div{border-top:1px solid hsl(var(--border));border-left:0}.section{padding:62px 20px}.work>header{display:block}.work>header a{display:inline-block;margin-top:18px}.flow,.wide-art{padding:20px}.hiring>div{flex-direction:column}}
.approach > header,.services > header { margin-bottom: 32px; }
.approach h2 span,.services h2 span { display: inline-block; }
:global(.dark) .wide-art{filter:drop-shadow(0 0 1px hsl(220 13% 80%))}
.work>header{display:block;max-width:760px;margin:0 auto 42px;text-align:center}.work>header>p:not(.kicker){max-width:560px;margin:17px auto 0;color:hsl(var(--muted-foreground));line-height:1.6}.work>header>a{display:inline-block;margin-top:20px;color:hsl(var(--primary));font-weight:600}
@media(max-width:600px){.work>header{margin-bottom:34px}}
.work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px 24px;max-width:1112px;margin-inline:auto}
@media(max-width:760px){.work-grid{grid-template-columns:1fr;gap:40px}}
</style>
<style>
.proof h2{max-width:760px;margin:0 auto 24px;padding:0 20px;text-align:center}.proof{padding:72px clamp(24px,5vw,74px) 0}.stats strong{font-variant-numeric:tabular-nums}
.stats{overflow:hidden;border-radius:1.5rem}.stats{border:1px solid hsl(var(--border))}.proof+.closing{border-top:0!important}.wide-art{border-radius:1.5rem}
@media(max-width:600px){.proof{padding-inline:20px}}
.proof{padding:90px clamp(24px,5vw,74px)}
@media(max-width:600px){.proof,.closing{padding:62px 20px}}
.solutions-home :global(.container-x){padding-inline:0}
</style>
