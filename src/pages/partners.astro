---
import ScrollShowcase from "../components/ScrollShowcase.astro";
import PartnerOutcomes from "../components/PartnerOutcomes.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ConsultationCta from "../components/ConsultationCta.astro";

const claudeTiers = ["Certified", "Select", "Preferred", "Global Premier"];

const aiOutcomes = [
  { title: "Generative AI consulting", desc: "Assistants and document understanding built on Amazon Bedrock, grounded in your own data" },
  { title: "Agentic AI consulting", desc: "Agents that take the next step, call your tools and hand off to people when it matters" },
  { title: "Production-ready on AWS", desc: "Infrastructure as code, security controls and monitoring from day one" },
  { title: "Human in the loop", desc: "Confidence-based review, so routine work is automated and exceptions go to your team" },
];

const metaOutcomes = [
  { title: "Client onboarding", desc: "Connect businesses to the WhatsApp Business Platform through Embedded Signup" },
  { title: "Business messaging", desc: "Send and receive WhatsApp messages for onboarded clients" },
  { title: "Message templates", desc: "Create and manage templates for customer conversations" },
  { title: "Connected workflows", desc: "Use webhooks to bring messaging events into your applications" },
];

const index = [
  { id: "claude", name: "Anthropic", tier: "Claude Partner Network · Certified Services Partner", logo: "/assets/partners/claude-certified-services-partner.svg" },
  { id: "aws-ai", name: "AWS AI Services Competency", shortName: "AWS AI", tier: "Generative and agentic AI consulting", logo: "/assets/partners/aws-ai-services-competency-badge.png" },
  {
    id: "aws",
    name: "AWS Partner Network",
    shortName: "AWS Partner",
    tier: "Advanced Tier Services",
    title: "AWS Advanced Tier Services Partner",
    logo: "/assets/aws-partner-badge.webp",
    alt: "AWS Partner — Advanced Tier Services",
    body: "We build and modernise enterprise workloads on AWS, with certified expertise in cloud architecture, data and generative AI.",
    tags: ["Amazon Bedrock", "SageMaker", "Amazon EKS", "Well-Architected", "GenAI Competency"],
    outcomes: [
      { title: "Well-Architected Reviews", desc: "Security, resilience & performance benchmarks" },
      { title: "GenAI Accelerators", desc: "Production foundation models on Amazon Bedrock" },
      { title: "Migration & Modernisation", desc: "Planned, low-disruption containerised workload transitions" },
      { title: "FinOps & Cost Governance", desc: "Cloud spend efficiency & architectural controls" },
    ],
  },
  { id: "meta", name: "WhatsApp Business", shortName: "WhatsApp", tier: "Meta Tech Provider", logo: "/assets/partners/whatsapp-glyph-green-2026.svg" },
  {
    id: "invoicenow",
    name: "InvoiceNow",
    tier: "InvoiceNow-Ready Solution Provider (IRSP) Reseller",
    title: "Get InvoiceNow-ready",
    logo: "/assets/partners/invoicenow-logo.png",
    alt: "InvoiceNow",
    body: "We set up InvoiceNow in Xero or connect compatible accounting software so Singapore businesses can exchange e-invoices over Peppol.",
    tags: ["Xero", "Peppol network", "IRAS"],
    outcomes: [
      { title: "Peppol registration", desc: "Get a Peppol ID linked to your business UEN." },
      { title: "Electronic invoicing", desc: "Exchange structured invoices with customers and suppliers." },
      { title: "GST InvoiceNow setup", desc: "Enable invoice data submission to IRAS if the GST InvoiceNow Requirement applies." },
    ],
  },
  {
    id: "xero",
    name: "Xero Ecosystem",
    shortName: "Xero",
    tier: "Certified Solutions Partner",
    title: "Xero Partner",
    logo: "/assets/partners/xero-blue-partner-badge.svg",
    alt: "Xero Solutions Partner",
    body: "We configure Xero around your accounting workflows, from reconciliation and reporting to integrations with your other systems.",
    tags: ["Invoicing & Payables", "Bank Reconciliation", "GST & IRAS Filing", "InvoiceNow Ready", "Custom Financial APIs"],
    outcomes: [
      { title: "Setup & Implementation", desc: "Tailored chart of accounts & workflow design" },
      { title: "Data Migration", desc: "Clean ledger transfers with complete audit integrity" },
      { title: "Automation & Integrations", desc: "Connected banking, ERP & real-time webhook sync" },
      { title: "Training & SLA Support", desc: "Team enablement, compliance & ongoing operational care" },
    ],
  },
];

const partnerCredentials = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Algorims technology partners and credentials",
  itemListElement: index.map(({ id, name, tier }, position) => ({
    "@type": "ListItem",
    position: position + 1,
    name,
    description: tier,
    url: new URL(`${Astro.url.pathname}#${id}`, Astro.site).toString(),
  })),
};
---
<BaseLayout
  title="AWS, Anthropic, Meta, Xero and InvoiceNow | Algorims Partners"
  description="AWS AI Services Competency and Advanced Tier, Anthropic Claude certification, Meta WhatsApp Business, Xero partnership and InvoiceNow reseller status."
  schema={partnerCredentials}
>
  <div class="partners-page">
    <section class="partners-hero" aria-labelledby="partners-title">
      <div class="container-x">
        <p class="kicker">Partners</p>
        <h1 id="partners-title">Specialist platforms. <span>Enterprise outcomes.</span></h1>
        <p class="lede">See what we deliver with our technology partners, from production AI to customer messaging and finance automation.</p>
      </div>
    </section>

    <ScrollShowcase items={index} label="Technology partners" noun="partner">
      {index.map((p) => (
        <section id={p.id} class="showcase-panel" aria-labelledby={`${p.id}-title`}>
          <div class="partner-grid">
            {p.id === "claude" && (<>
              <div class="partner-copy" data-showcase-copy>
                <p class="eyebrow">Claude Partner Network <span aria-hidden="true">·</span> Services Track</p>
                <h2 id="claude-title" tabindex="-1">Certified in Anthropic’s Claude Partner Network</h2>
                <p class="partner-lead">Our team holds Claude certifications through Anthropic’s Services Track.</p>
                <p>The track recognizes partners who build certified delivery teams, put Claude into production for clients, and demonstrate that work through public customer references.</p>
                <a class="text-link" href="https://claude.com/partners">Learn more about the Claude Partner Network <span aria-hidden="true">↗</span></a>
              </div>

              <div class="partner-stage">
                <img class="claude-badge" data-showcase-art src={p.logo} alt="Certified Services Partner — Claude Partner Network" width="168" height="168" />
                <div class="tier-ladder">
                  <p class="stage-label">Services Track tiers</p>
                  <ol>
                    {claudeTiers.map((t, i) => (
                      <li class:list={{ current: i === 0 }} aria-current={i === 0 ? "step" : undefined}>
                        <span class="tier-node" aria-hidden="true"></span>
                        <span class="tier-name">{t}</span>
                        {i === 0 && <span class="tier-note">Current tier</span>}
                      </li>
                    ))}
                  </ol>
                </div>
              </div>
            </>)}
            {p.id === "aws-ai" && (<>
              <div class="partner-copy" data-showcase-copy>
                <p class="eyebrow">AWS Partner <span aria-hidden="true">·</span> AI Services Competency</p>
                <h2 id="aws-ai-title" tabindex="-1">AWS AI Services Competency</h2>
                <p class="partner-lead">We design, build and run generative and agentic AI on AWS, with the guardrails, human review and monitoring needed in production.</p>
                <PartnerOutcomes outcomes={aiOutcomes} />
                <a class="text-link" href="/contact">Talk to us about AI on AWS <span aria-hidden="true">→</span></a>
              </div>

              <div class="partner-stage">
                <div class="badge-tile" data-showcase-art>
                  <img src={p.logo} alt="AWS Partner — AI Services Competency" width="362" height="360" loading="lazy" />
                </div>
                <div class="stage-tags">
                  <p class="stage-label" id="ai-focus-areas">Consulting focus areas</p>
                  <ul aria-labelledby="ai-focus-areas">
                    <li>Agentic AI Consulting</li>
                    <li>Generative AI Consulting</li>
                  </ul>
                </div>
              </div>
            </>)}
            {p.id === "meta" && (<>
              <div class="partner-copy" data-showcase-copy>
                <p class="eyebrow">WhatsApp Business Platform <span aria-hidden="true">·</span> Tech Provider</p>
                <h2 id="meta-title" tabindex="-1">WhatsApp Business Platform</h2>
                <p class="partner-lead">As a Meta Tech Provider, we onboard businesses and set up WhatsApp messaging for their accounts. We deliver directly or with a Solution Partner.</p>
                <PartnerOutcomes outcomes={metaOutcomes} />
                <a class="text-link" href="/whatsapp-business-api">Explore WhatsApp Business <span aria-hidden="true">→</span></a>
              </div>

              <div class="partner-stage">
                <div class="badge-tile" data-showcase-art>
                  <img src="/assets/partners/whatsapp-glyph-green-2026.svg" alt="WhatsApp" width="110" height="110" loading="lazy" />
                </div>
                <div class="stage-tags">
                  <p class="stage-label">Platform &amp; focus areas</p>
                  <ul aria-label="Platform and focus areas for Meta Tech Provider">
                    <li>WhatsApp Business Platform</li>
                    <li>Embedded Signup</li>
                    <li>Messaging &amp; templates</li>
                  </ul>
                </div>
              </div>
            </>)}
            {p.outcomes && (<>
              <div class="partner-copy" data-showcase-copy>
                <p class="eyebrow">{p.name} <span aria-hidden="true">·</span> {p.tier}</p>
                <h2 id={`${p.id}-title`} tabindex="-1">{p.title}</h2>
                <p class="partner-lead">{p.body}</p>
                {p.id === "invoicenow" && (
                  <p>Algorims Pte. Ltd. is an <a class="inline-link" href="https://file.go.gov.sg/invoicenowirsp.pdf#page=33">IMDA-listed IRSP reseller for Xero (PDF)</a>.</p>
                )}
                <PartnerOutcomes outcomes={p.outcomes} />
                {p.id === "invoicenow" && (
                  <a class="text-link" href="/invoicenow">Explore InvoiceNow setup <span aria-hidden="true">→</span></a>
                )}
              </div>

              <div class="partner-stage">
                <div class="badge-tile" data-showcase-art>
                  <img src={p.logo} alt={p.alt} width="110" height="110" loading="lazy" />
                </div>
                <div class="stage-tags">
                  <p class="stage-label">Platforms &amp; focus areas</p>
                  <ul aria-label={`Platforms and focus areas for ${p.title}`}>
                    {p.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </div>
            </>)}
          </div>
        </section>
      ))}
    </ScrollShowcase>
    <ConsultationCta />
  </div>
</BaseLayout>

<style>
  .partners-page { position: relative; isolation: isolate; padding-bottom: 32px; }
  .partners-page::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 48% 23rem at 50% 9rem, hsl(var(--background)) 24%, transparent 100%),
      radial-gradient(ellipse 60% 30rem at 8% 25rem, hsl(var(--primary) / .075), transparent 100%),
      radial-gradient(ellipse 58% 32rem at 100% 45rem, hsl(var(--primary) / .06), transparent 100%),
      radial-gradient(circle, hsl(var(--grid-line)) 1px, transparent 1.5px) center top / 24px 24px;
    mask-image: linear-gradient(transparent, #000 5rem, #000 75%, transparent 92%);
  }
  .partners-hero { padding: clamp(42px, 5vw, 68px) 0 clamp(24px, 2.5vw, 36px); text-align: center; }
  .kicker { margin: 0 0 14px; color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 0 auto; font-size: clamp(2.25rem, 5vw, 4.4rem); font-weight: 600; line-height: 1.02; letter-spacing: -.055em; text-wrap: balance; }
  h1 span { display: block; color: hsl(var(--primary)); }
  .lede { max-width: 620px; margin: 18px auto 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.25vw, 1.1rem); line-height: 1.55; text-wrap: balance; }

  .partner-grid { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: clamp(24px, 3.25vw, 44px); align-items: start; }
  .text-link:focus-visible, .inline-link:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 2px; }
  .partner-copy { max-width: 62ch; }
  .partner-copy h2 { margin: 0; font-size: clamp(1.7rem, 3vw, 2.6rem); font-weight: 600; line-height: 1.06; letter-spacing: -.045em; text-wrap: balance; }
  .partner-copy p { margin: 14px 0 0; color: hsl(var(--muted-foreground)); font-size: .94rem; line-height: 1.55; }
  .partner-copy .eyebrow { margin: 0 0 12px; color: hsl(var(--primary)); font-size: .7rem; font-weight: 700; letter-spacing: .075em; }
  .partner-copy .eyebrow span { margin: 0 3px; color: hsl(var(--muted-foreground)); }
  .partner-copy .partner-lead { color: hsl(var(--foreground)); font-size: 1rem; }
  .text-link { display: inline-block; margin-top: 18px; color: hsl(var(--primary)); font-size: .9rem; font-weight: 600; text-underline-offset: 4px; }
  .text-link:hover { text-decoration: underline; }
  .inline-link { color: hsl(var(--primary)); text-decoration: underline; text-underline-offset: 3px; }

  .partner-stage { position: relative; isolation: isolate; display: grid; justify-items: center; gap: 20px; padding: 24px 18px; border: 1px solid hsl(var(--border)); border-radius: .65rem; background: hsl(var(--muted) / .35); }
  .partner-stage::before {
    position: absolute; inset: 0; z-index: -1; content: "";
    background: repeating-linear-gradient(30deg, hsl(var(--grid-line)) 0 1px, transparent 1px 24px),
                repeating-linear-gradient(-30deg, hsl(var(--grid-line)) 0 1px, transparent 1px 24px);
    mask-image: radial-gradient(ellipse at center, #000, transparent 76%);
  }
  .claude-badge, .badge-tile { width: clamp(108px, 10vw, 132px); aspect-ratio: 1; border-radius: 10px; box-shadow: 0 3px 8px hsl(var(--foreground) / .1); }
  .claude-badge { display: block; height: auto; }
  .badge-tile { display: grid; place-items: center; padding: 15px; border: 1px solid hsl(var(--border)); background: #fff; }
  .badge-tile img { width: 100%; height: 100%; object-fit: contain; }
  .stage-label { margin: 0 0 8px; color: hsl(var(--muted-foreground)); font-size: .7rem; font-weight: 700; text-align: center; }

  .tier-ladder { width: 100%; }
  .tier-ladder ol { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0; list-style: none; }
  .tier-ladder ol::before { content: ""; position: absolute; top: 5px; left: 12.5%; right: 12.5%; height: 1px; background: hsl(var(--border)); }
  .tier-ladder li { position: relative; display: grid; justify-items: center; align-content: start; gap: 6px; text-align: center; }
  .tier-node { width: 11px; height: 11px; border-radius: 50%; border: 1px solid hsl(var(--border)); background: hsl(var(--background)); }
  .tier-name { color: hsl(var(--muted-foreground)); font-size: .7rem; line-height: 1.2; }
  .current .tier-node { border-color: hsl(var(--primary)); background: hsl(var(--primary)); }
  .current .tier-name, .tier-note { color: hsl(var(--primary)); font-weight: 700; }
  .tier-note { font-size: .62rem; line-height: 1.15; }

  .stage-tags ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px 12px; margin: 0; padding: 0; list-style: none; color: hsl(var(--muted-foreground)); font-size: .78rem; text-align: center; }
  .stage-tags li::before { content: ""; display: inline-block; width: 4px; height: 4px; margin: 0 6px .16em 0; background: hsl(var(--primary)); }

  @media (max-width: 700px) {
    .partner-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .partner-stage { grid-template-columns: 64px minmax(0, 1fr); align-items: center; gap: 12px; padding: 14px; }
    .badge-tile, .claude-badge { width: 64px; }
    .badge-tile { padding: 7px; }
  }
  @media (max-width: 360px) {
    .partner-stage:has(.tier-ladder) { grid-template-columns: minmax(0, 1fr); }
  }
</style>
