---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConsultationCta from "../components/ConsultationCta.astro";

const index = [
  { id: "claude", name: "Claude Partner Network", tier: "Certified Services Partner", logo: "/assets/partners/claude-certified-services-partner.webp", wide: true },
  { id: "aws", name: "AWS Partner Network", tier: "Advanced Tier Services", logo: "/assets/aws-partner-badge.webp" },
  { id: "xero", name: "Xero Ecosystem", tier: "Certified Solutions Partner", logo: "/assets/partners/xero-blue-partner-badge.svg" },
];

const claudeTiers = ["Certified", "Select", "Preferred", "Global Premier"];

const alliances = [
  {
    id: "aws",
    tint: "36 100% 50%",
    partner: "AWS Partner Network",
    tier: "Advanced Tier Services",
    title: "AWS Advanced Tier Services Partner",
    logo: "/assets/aws-partner-badge.webp",
    alt: "AWS Partner — Advanced Tier Services",
    body: "Certified, enterprise-grade expertise across AI, data, and cloud infrastructure—bringing architectural rigour, GenAI innovation, and proven AWS specialisations to every engagement.",
    tags: ["Amazon Bedrock", "SageMaker", "Amazon EKS", "Well-Architected", "GenAI Competency"],
    outcomes: [
      { title: "Well-Architected Reviews", desc: "Security, resilience & performance benchmarks" },
      { title: "GenAI Accelerators", desc: "Production foundation models on Amazon Bedrock" },
      { title: "Migration & Modernisation", desc: "Planned, low-disruption containerised workload transitions" },
      { title: "FinOps & Cost Governance", desc: "Cloud spend efficiency & architectural controls" },
    ],
  },
  {
    id: "xero",
    tint: "195 84% 50%",
    partner: "Xero Ecosystem",
    tier: "Certified Solutions Partner",
    title: "Xero Partner",
    logo: "/assets/partners/xero-blue-partner-badge.svg",
    alt: "Xero Solutions Partner",
    body: "We simplify accounting, automate financial processes, and improve financial visibility—configuring Xero around your workflow instead of the other way around.",
    tags: ["Invoicing & Payables", "Bank Reconciliation", "GST & IRAS Filing", "InvoiceNow Ready", "Custom Financial APIs"],
    outcomes: [
      { title: "Setup & Implementation", desc: "Tailored chart of accounts & workflow design" },
      { title: "Data Migration", desc: "Clean ledger transfers with complete audit integrity" },
      { title: "Automation & Integrations", desc: "Connected banking, ERP & real-time webhook sync" },
      { title: "Training & SLA Support", desc: "Team enablement, compliance & ongoing operational care" },
    ],
  },
];
---
<BaseLayout title="Partners — Algorims" description="Explore Algorims’ Certified status in the Claude Partner Network, AWS and Xero partnerships, and enterprise delivery capabilities.">
  <div class="partners-page">
    <section class="partners-hero" aria-labelledby="partners-title">
      <div class="container-x">
        <p class="kicker">Partners</p>
        <h1 id="partners-title">Specialist platforms. <span>Enterprise outcomes.</span></h1>
        <p class="lede">Direct tier partnerships and certified specialisations that give our enterprise clients architectural assurance, accelerated delivery, and SLA-backed execution.</p>

        <nav class="credential-index" aria-label="Partnerships on this page">
          <ul>
            {index.map((p) => (
              <li>
                <a href={`#${p.id}`}>
                  <span class:list={["index-logo", { wide: p.wide }]}>
                    <img src={p.logo} alt="" width={p.wide ? 600 : 110} height={p.wide ? 190 : 110} />
                  </span>
                  <span class="index-text">
                    <span class="index-name">{p.name}</span>
                    <span class="index-tier">{p.tier}</span>
                  </span>
                  <svg class="index-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>

    <section id="claude" class="partner" style="--tint: 15 63% 60%" aria-labelledby="claude-title">
      <div class="container-x partner-grid">
        <div class="partner-stage">
          <img class="claude-badge" src="/assets/partners/claude-certified-services-partner.webp" alt="Certified Services Partner — Claude Partner Network" width="600" height="190" />
          <div class="tier-ladder">
            <p class="stage-label">Services Track tiers</p>
            <ol>
              {claudeTiers.map((t, i) => (
                <li class:list={{ current: i === 0 }} aria-current={i === 0 ? "step" : undefined}>
                  <span class="tier-node" aria-hidden="true"></span>
                  <span class="tier-name">{t}</span>
                  {i === 0 && <span class="tier-note">Current tier</span>}
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="partner-copy">
          <p class="eyebrow">Claude Partner Network <span aria-hidden="true">·</span> Services Track</p>
          <h2 id="claude-title">Certified in the Claude Partner Network</h2>
          <p class="partner-lead">Our people hold Claude certifications, and we are building from here.</p>
          <p>The Claude Partner Network is how Anthropic works with the firms that put Claude into production for customers. The Services Track recognizes partners for building a certified delivery team, delivering Claude use cases for clients, and proving the work through public customer references. Partners advance through Certified, Select, Preferred, and Global Premier tiers.</p>
          <a class="text-link" href="https://claude.com/partners">Learn more about the Claude Partner Network <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    {alliances.map((a, i) => (
      <section id={a.id} class:list={["partner", { flip: i % 2 === 0 }]} style={`--tint: ${a.tint}`} aria-labelledby={`${a.id}-title`}>
        <div class="container-x partner-grid">
          <div class="partner-stage">
            <div class="badge-tile">
              <img src={a.logo} alt={a.alt} width="110" height="110" loading="lazy" />
            </div>
            <div class="stage-tags">
              <p class="stage-label">Platforms &amp; focus areas</p>
              <ul aria-label={`Platforms and focus areas for ${a.title}`}>
                {a.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
          </div>

          <div class="partner-copy">
            <p class="eyebrow">{a.partner} <span aria-hidden="true">·</span> {a.tier}</p>
            <h2 id={`${a.id}-title`}>{a.title}</h2>
            <p class="partner-lead">{a.body}</p>
            <h3 class="sr-only">What we deliver</h3>
            <ul class="outcomes">
              {a.outcomes.map((o) => (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                  <div>
                    <strong>{o.title}</strong>
                    <span>{o.desc}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))}

    <ConsultationCta />
  </div>
</BaseLayout>

<style>
  .partners-page { padding-bottom: 32px; }

  /* Hero */
  .partners-hero { padding: 56px 0 24px; text-align: center; }
  .kicker { margin: 0 0 18px; color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.5rem, 5.2vw, 4.6rem); font-weight: 600; line-height: 1.02; letter-spacing: -.05em; text-wrap: balance; }
  h1 span { display: block; color: hsl(var(--primary)); }
  .lede { max-width: 700px; margin: 24px auto 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.65; text-wrap: balance; }

  .credential-index { max-width: 1040px; margin: 48px auto 0; }
  .credential-index ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .credential-index a { display: flex; align-items: center; gap: 14px; height: 100%; padding: 12px 16px 12px 12px; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--card)); text-align: left; transition: border-color .2s ease, transform .2s ease; }
  .credential-index a:hover { border-color: hsl(var(--primary) / .55); transform: translateY(-2px); }
  .credential-index a:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 3px; }
  .index-logo { flex-shrink: 0; display: grid; place-items: center; width: 48px; height: 48px; padding: 6px; border-radius: 10px; background: #fff; border: 1px solid hsl(var(--border) / .7); overflow: hidden; }
  .index-logo img { width: 100%; height: 100%; object-fit: contain; }
  .index-logo.wide { padding: 0; }
  .index-logo.wide img { object-fit: cover; object-position: left center; }
  .index-text { display: flex; flex-direction: column; min-width: 0; gap: 2px; }
  .index-name { color: hsl(var(--foreground)); font-size: .92rem; font-weight: 600; line-height: 1.3; }
  .index-tier { color: hsl(var(--muted-foreground)); font-size: .8rem; line-height: 1.3; }
  .index-arrow { flex-shrink: 0; margin-left: auto; color: hsl(var(--muted-foreground)); transition: color .2s ease, transform .2s ease; }
  .credential-index a:hover .index-arrow { color: hsl(var(--primary)); transform: translateY(2px); }

  /* Partner sections */
  .partner { padding: clamp(48px, 7vw, 88px) 0; scroll-margin-top: 96px; }
  .partner + .partner { border-top: 1px solid hsl(var(--border) / .7); }
  .partner-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .partner.flip .partner-stage { order: 2; }

  .partner-stage { position: relative; isolation: isolate; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px; min-height: 400px; padding: clamp(28px, 4vw, 48px); overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; background: radial-gradient(110% 80% at 50% 0%, hsl(var(--tint) / .16), transparent 65%), hsl(var(--muted) / .6); }
  .partner-stage::before { content: ""; position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(hsl(var(--grid-line)) 1px, transparent 1px), linear-gradient(90deg, hsl(var(--grid-line)) 1px, transparent 1px); background-size: 32px 32px; background-position: center; mask-image: radial-gradient(ellipse at center, #000 20%, transparent 72%); -webkit-mask-image: radial-gradient(ellipse at center, #000 20%, transparent 72%); }
  .stage-label { margin: 0 0 12px; color: hsl(var(--muted-foreground)); font-size: .7rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; text-align: center; }

  .claude-badge { display: block; width: 100%; max-width: 420px; height: auto; border-radius: 12px; box-shadow: var(--shadow-lg); }
  .badge-tile { display: grid; place-items: center; width: 168px; height: 168px; padding: 20px; border-radius: 1.25rem; background: #fff; border: 1px solid hsl(var(--border) / .7); box-shadow: var(--shadow-lg); }
  .badge-tile img { width: 100%; height: 100%; object-fit: contain; }

  .tier-ladder { width: 100%; max-width: 420px; }
  .tier-ladder ol { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0; list-style: none; }
  .tier-ladder ol::before { content: ""; position: absolute; top: 6px; left: 12.5%; right: 12.5%; height: 2px; background: hsl(var(--border)); }
  .tier-ladder li { position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  .tier-node { width: 14px; height: 14px; border-radius: 50%; border: 2px solid hsl(var(--border)); background: hsl(var(--background)); }
  .tier-name { color: hsl(var(--muted-foreground)); font-size: .78rem; font-weight: 500; line-height: 1.25; }
  .tier-ladder li.current .tier-node { border-color: hsl(var(--tint)); background: hsl(var(--tint)); box-shadow: 0 0 0 4px hsl(var(--tint) / .2); }
  .tier-ladder li.current .tier-name { color: hsl(var(--foreground)); font-weight: 600; }
  .tier-note { margin-top: -4px; white-space: nowrap; color: hsl(var(--tint)); font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

  .stage-tags { width: 100%; max-width: 440px; }
  .stage-tags ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .stage-tags li { padding: 6px 12px; border: 1px solid hsl(var(--border)); border-radius: 999px; background: hsl(var(--background) / .85); color: hsl(var(--foreground)); font-size: .8rem; font-weight: 500; }

  .partner-copy { max-width: 560px; }
  .partner-copy .eyebrow { margin: 0 0 14px; color: hsl(var(--primary)); font-size: .74rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .partner-copy .eyebrow span { margin: 0 4px; color: hsl(var(--muted-foreground)); }
  .partner-copy h2 { margin: 0; font-size: clamp(1.9rem, 3.2vw, 2.75rem); font-weight: 600; line-height: 1.08; letter-spacing: -.035em; text-wrap: balance; }
  .partner-copy p { margin: 16px 0 0; color: hsl(var(--muted-foreground)); font-size: 1rem; line-height: 1.7; }
  .partner-copy .partner-lead { margin-top: 18px; color: hsl(var(--foreground)); font-size: 1.1rem; line-height: 1.6; }
  .text-link { display: inline-block; margin-top: 24px; color: hsl(var(--primary)); font-size: .95rem; font-weight: 600; text-decoration: underline; text-decoration-color: hsl(var(--primary) / .35); text-underline-offset: 5px; transition: text-decoration-color .2s ease; }
  .text-link:hover { text-decoration-color: hsl(var(--primary)); }
  .text-link:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 3px; border-radius: 4px; }

  .outcomes { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 28px; margin: 32px 0 0; padding: 28px 0 0; border-top: 1px solid hsl(var(--border) / .8); list-style: none; }
  .outcomes li { display: flex; gap: 12px; }
  .outcomes svg { flex-shrink: 0; margin-top: 2px; color: hsl(var(--primary)); }
  .outcomes strong { display: block; color: hsl(var(--foreground)); font-size: .98rem; font-weight: 600; line-height: 1.3; }
  .outcomes span { display: block; margin-top: 4px; color: hsl(var(--muted-foreground)); font-size: .87rem; line-height: 1.5; }

  :global(.dark) .partner-stage { background: radial-gradient(110% 80% at 50% 0%, hsl(var(--tint) / .14), transparent 65%), hsl(var(--card) / .7); }
  :global(.dark) .badge-tile, :global(.dark) .claude-badge { box-shadow: 0 24px 60px -20px rgba(0, 0, 0, .7); }

  @media (max-width: 960px) {
    .credential-index ul { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
    .partner-grid { grid-template-columns: 1fr; }
    .partner.flip .partner-stage { order: 0; }
    .partner-stage { min-height: 0; }
    .partner-copy { max-width: none; }
  }
  @media (max-width: 600px) {
    .partners-hero { padding-top: 40px; }
    h1 { font-size: 2.4rem; }
    .credential-index { margin-top: 36px; }
    .partner-stage { gap: 24px; padding: 28px 18px; border-radius: 1.25rem; }
    .badge-tile { width: 132px; height: 132px; padding: 16px; }
    .tier-name { font-size: .72rem; }
    .outcomes { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .credential-index a, .index-arrow, .text-link { transition: none; }
    .credential-index a:hover, .credential-index a:hover .index-arrow { transform: none; }
  }
</style>
