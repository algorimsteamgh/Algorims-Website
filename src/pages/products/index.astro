---
import ConsultationCta from "../../components/ConsultationCta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import listing from "../../data/productsListing.json";

type Listing = {
  id: string; name: string; status: string; live: boolean; tagline: string; body: string;
  glyph?: string; logo?: string;
  safety?: { icon: string; label: string }[]; cta?: { href: string; label: string };
  readMore?: string; comingSoon?: boolean;
  art?: [string, string]; flow?: { stages: { title: string }[] };
};
const artwork: Record<string, [string, string]> = {
  cxiq: ["solution-autonomous-customer-operations.webp", "solution-autonomous-customer-operations-dark.webp"],
  dociq: ["solution-intelligent-document-processing.webp", "solution-intelligent-document-processing-dark.webp"],
  opsiq: ["agent-devops-sre.png", "agent-devops-sre.png"],
  payiq: ["payiq-system.png", "payiq-system.png"],
  "operations-automation": ["solution-operations-automation.webp", "solution-operations-automation-dark.webp"],
};
const entries = await getCollection("products");
const primary = (listing.products as Listing[]).map((p) => {
  const entry = entries.find((item) => item.id === p.id);
  if (entry) return { ...p, body: entry.data.subtitle, glyph: entry.data.glyph, readMore: `/products/${entry.id}`, art: artwork[entry.id], flow: entry.data.flow };
  return p.id === "operations-automation" ? { ...p, art: artwork[p.id], flow: { stages: [{ title: "Finance, HR & operations" }, { title: "Algorims platform" }, { title: "Validated records" }] } } : p;
});
const apps = listing.moreProducts as Listing[];
---

<BaseLayout title="Products — Algorims" description="Explore Algorims products — AI-powered platforms that turn enterprise data into autonomous, measurable outcomes.">
  <section class="products-hero" aria-labelledby="products-title">
    <div class="container-x">
      <p class="products-kicker">Our Products</p>
      <h1 id="products-title">Built by Algorims.<span class="products-title-line">Built for the <span class="products-title-accent">real world</span>.</span></h1>
      <p class="products-intro">Explore production-ready AI platforms for business operations and practical apps for everyday needs.</p>
      <div class="products-actions"><a class="btn btn-hero btn-lg" href="#enterprise-products">Explore platforms</a><a class="btn btn-outline btn-lg" href="/contact">Talk to our team</a></div>
    </div>
  </section>

  <section class="products-list" aria-label="Products">
    <div class="container-x products-inner">
      <header id="enterprise-products" class="products-section-heading"><p class="products-kicker">Enterprise platforms</p><h2>Purpose-built systems. <span>Ready for operations.</span></h2><p>Each product solves a specific workflow and fits the tools your team already uses.</p></header>
    {primary.map((p, idx) => <article id={p.id} class="product-row">
      <div class="container-x product-grid">
        <div class="product-copy">
          <p class="product-kicker"><span>{`${String(idx + 1).padStart(2, "0")} / Algorims product`}</span><span class="product-status"><span class:list={["status-dot", { "is-pending": !p.live }]}></span>{p.status}</span></p>
          <h3>{p.name}</h3>
          <p class="product-tagline">{p.tagline}</p>
          <p class="product-body">{p.body}</p>
          {p.safety && <p class="product-safety">{p.safety.map((s) => s.label).join(" · ")}</p>}
          <div class="product-actions">
            {p.cta && p.cta.href !== "#" && <a href={p.cta.href} class="product-link">{p.cta.label}<i data-lucide="arrow-up-right" aria-hidden="true"></i></a>}
            {p.readMore && <a href={p.readMore} class="product-link">Explore {p.name}<i data-lucide="arrow-right" aria-hidden="true"></i></a>}
            {p.comingSoon && <form id="algomart-notify" class="product-notify"><input type="email" required aria-label="Email for Algomart updates" placeholder="you@company.com" class="field" maxlength="120" /><button class="btn btn-hero btn-default">Notify me <i data-lucide="arrow-right" aria-hidden="true"></i></button><span data-msg class="hidden text-sm text-primary">Thanks — we'll be in touch.</span></form>}
          </div>
        </div>
        <figure class:list={["product-figure", { "has-art": !!p.art }]}>
          {p.art ? <>
            <div class="product-art">
              <img class="art-light" src={`/assets/illustrations/${p.art[0]}`} alt={p.id === "payiq" ? "Invoices enter PayIQ for capture and payment-detail checks, then post to the ledger or pause for human review." : `${p.flow?.stages.map((stage: { title: string }) => stage.title).join(" → ")}.`} width={p.id === "opsiq" ? 1536 : 1254} height={p.id === "opsiq" ? 1024 : 1254} loading="lazy" />
              <img class="art-dark" src={`/assets/illustrations/${p.art[1]}`} alt="" aria-hidden="true" width={p.id === "opsiq" ? 1536 : 1254} height={p.id === "opsiq" ? 1024 : 1254} loading="lazy" />
            </div>
          </> : <>
            {p.logo ? <img class="product-logo" src={p.logo} alt={`${p.name} logo`} loading="lazy" /> : <i data-lucide={p.glyph} role="img" aria-label={`${p.name} icon`}></i>}
          </>}
        </figure>
      </div>
    </article>)}
      <header id="everyday-apps" class="products-section-heading apps-heading"><p class="products-kicker">Everyday apps</p><h2>Useful ideas. <span>Made tangible.</span></h2><p>Products for people and small businesses, built with the same care as our enterprise platforms.</p></header>
      <div class="apps-carousel" data-apps-carousel aria-label="Everyday apps carousel">
        <div class="apps-viewport">
          <div class="apps-track" data-apps-track>
            {apps.map((app) => <article id={app.id} class="app-slide" data-app-slide>
              <div class="app-copy">
                <p class="product-kicker">Algorims app <span class="product-status"><span class:list={["status-dot", { "is-pending": !app.live }]}></span>{app.status}</span></p>
                <h3>{app.name}</h3>
                <p class="product-tagline">{app.tagline}</p>
                <p class="product-body">{app.body}</p>
                {app.safety && <p class="product-safety">{app.safety.map((item) => item.label).join(" · ")}</p>}
                {app.comingSoon && <form id="algomart-notify" class="product-notify"><input type="email" required aria-label="Email for Algomart updates" placeholder="you@company.com" class="field" maxlength="120" /><button class="btn btn-hero btn-default">Notify me <i data-lucide="arrow-right" aria-hidden="true"></i></button><span data-msg class="hidden text-sm text-primary">Thanks — we'll be in touch.</span></form>}
              </div>
              <figure class="app-figure"><img src={app.logo} alt={`${app.name} logo`} loading="lazy" /></figure>
            </article>)}
          </div>
        </div>
        <div class="apps-controls" aria-label="Select an app">
          {apps.map((app, index) => <button type="button" class="app-dot" data-app-tab={index} aria-label={`Show ${app.name}`} aria-controls={app.id}></button>)}
        </div>
      </div>
    </div>
  </section>
  <ConsultationCta />
</BaseLayout>

<style>
  .products-hero { padding: 46px 0 50px; border-bottom: 1px solid hsl(var(--border)); text-align: center; }
  .products-kicker, .product-kicker { margin: 0; color: hsl(var(--primary)); font-size: .72rem; font-weight: 700; letter-spacing: .18em; line-height: 1.4; text-transform: uppercase; }
  .products-hero h1 { max-width: 1050px; margin: 14px auto 0; font-size: clamp(2.7rem, 5.2vw, 4.8rem); font-weight: 600; line-height: 1; letter-spacing: -.06em; text-wrap: balance; }
  .products-title-line { display: block; }
  .products-title-accent, .products-section-heading h2 span { color: hsl(var(--primary)); }
  .products-intro { max-width: 720px; margin: 24px auto 0; color: hsl(var(--muted-foreground)); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.65; text-wrap: balance; }
  .products-actions { display: flex; justify-content: center; gap: 14px; margin-top: 26px; }
  .products-list { padding: clamp(64px, 7vw, 90px) 0; }
  .products-inner { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .products-section-heading { grid-column: 1 / -1; max-width: 790px; margin: 0 auto 18px; scroll-margin-top: 80px; text-align: center; }
  .products-section-heading h2 { margin: 14px 0 0; font-size: clamp(2.2rem, 3.7vw, 3.7rem); font-weight: 600; line-height: 1.06; letter-spacing: -.05em; text-wrap: balance; }
  .products-section-heading > p:last-child { margin: 16px auto 0; color: hsl(var(--muted-foreground)); font-size: 1.05rem; line-height: 1.65; }
  .apps-heading { margin-top: 50px; }
  .product-row { min-width: 0; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; scroll-margin-top: 80px; transition: background .2s ease; }
  .product-row:hover { background: hsl(var(--muted) / .35); }
  .product-row { grid-column: 1 / -1; }
  .product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: clamp(24px, 4vw, 56px); max-width: none; padding: clamp(28px, 3vw, 40px); }
  .product-copy { min-width: 0; }
  .product-kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .product-status { display: inline-flex; align-items: center; gap: 7px; color: hsl(var(--muted-foreground)); font-size: .68rem; letter-spacing: .07em; }
  .status-dot { width: 6px; height: 6px; flex: none; border-radius: 50%; background: hsl(var(--primary)); }
  .status-dot.is-pending { background: hsl(38 85% 46%); }
  .product-copy h3 { margin: 20px 0 0; color: hsl(var(--foreground)); font-size: clamp(1.8rem, 3vw, 2.7rem); font-weight: 600; line-height: 1.1; letter-spacing: -.045em; text-wrap: balance; }
  .product-tagline { margin: 12px 0 0; color: hsl(var(--primary)); font-size: 1.1rem; font-weight: 600; line-height: 1.35; }
  .product-body { margin: 18px 0 0; color: hsl(var(--muted-foreground)); line-height: 1.65; text-wrap: pretty; }
  .product-safety { margin: 15px 0 0; color: hsl(var(--muted-foreground)); font-size: .75rem; }
  .product-actions { margin-top: 26px; }
  .product-link { display: inline-flex; align-items: center; gap: 8px; color: hsl(var(--primary)); font-weight: 600; text-decoration: none; }
  .product-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .product-link :global(svg) { width: 16px; height: 16px; transition: transform .2s ease; }
  .product-link:is(:hover, :focus-visible) :global(svg) { transform: translateX(4px); }
  .product-notify { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .product-notify .field { width: auto; min-width: 140px; flex: 1; }
  .product-figure { justify-self: center; width: 100%; max-width: 400px; min-width: 0; margin: 0; }
  .product-art { display: grid; aspect-ratio: 1; }
  .product-art img { grid-area: 1 / 1; display: block; width: 100%; height: 100%; object-fit: contain; }
  .product-figure .art-dark { display: none; }
  :global(.dark) .product-figure .art-light { display: none; }
  :global(.dark) .product-figure .art-dark { display: block; }
  .product-row:nth-of-type(even) .product-copy { grid-column: 2; grid-row: 1; }
  .product-row:nth-of-type(even) .product-figure { grid-column: 1; grid-row: 1; }
  .apps-carousel { grid-column: 1 / -1; width: 100%; max-width: 880px; margin: 0 auto; padding: clamp(16px, 3vw, 32px); border-radius: 2rem; background: hsl(var(--secondary) / .4); }
  .apps-viewport { overflow: hidden; border-radius: 1.5rem; }
  .apps-track { display: flex; transition: transform .5s cubic-bezier(.22, 1, .36, 1); }
  .app-slide { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); align-items: center; gap: clamp(24px, 5vw, 60px); flex: 0 0 100%; min-width: 0; min-height: 370px; padding: clamp(28px, 4vw, 48px); border: 1px solid hsl(var(--border)); border-radius: 1.5rem; background: hsl(var(--card)); }
  .app-copy { min-width: 0; }
  .app-copy h3 { margin: 20px 0 0; font-size: clamp(2rem, 3vw, 2.7rem); font-weight: 600; line-height: 1.1; letter-spacing: -.045em; }
  .app-copy .product-notify { margin-top: 26px; }
  .app-figure { display: grid; place-items: center; min-width: 0; aspect-ratio: 1; margin: 0; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; background: hsl(var(--background)); }
  .app-figure img { display: block; width: 78%; height: 78%; object-fit: contain; }
  #algomart .app-figure img { width: 95%; height: 95%; }
  .apps-controls { display: flex; justify-content: center; gap: 2px; width: max-content; margin: 20px auto 0; padding: 4px 8px; border: 1px solid hsl(var(--border)); border-radius: 999px; background: hsl(var(--background)); }
  .app-dot { display: grid; place-items: center; width: 40px; height: 32px; border: 0; background: transparent; cursor: pointer; }
  .app-dot::before { width: 18px; height: 4px; border-radius: 999px; background: hsl(var(--muted-foreground) / .35); content: ""; transition: width .25s ease, background .25s ease; }
  .app-dot:is(:hover, [aria-pressed="true"])::before { width: 30px; background: hsl(var(--primary)); }
  @media (max-width: 900px) { .product-grid { grid-template-columns: 1fr; } .product-row:nth-of-type(even) .product-copy, .product-row:nth-of-type(even) .product-figure { grid-column: auto; grid-row: auto; } }
  @media (max-width: 600px) { .products-hero { padding-top: 44px; } .products-hero h1 { font-size: 2.4rem; } .products-actions { flex-direction: column; margin-inline: 20px; } .products-list { padding: 62px 0; } .products-inner { grid-template-columns: 1fr; } .products-section-heading { margin-bottom: 8px; } .apps-heading { margin-top: 38px; } .product-grid { gap: 24px; padding: 24px; } .app-slide { grid-template-columns: 1fr; gap: 24px; } .app-figure { width: min(100%, 250px); margin: 0 auto; } }
  @media (prefers-reduced-motion: reduce) { .product-row, .product-link :global(svg), .apps-track, .app-dot::before { transition: none; } }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-apps-carousel]");
  if (carousel) {
    const track = carousel.querySelector<HTMLElement>("[data-apps-track]")!;
    const slides = [...carousel.querySelectorAll<HTMLElement>("[data-app-slide]")];
    const tabs = [...carousel.querySelectorAll<HTMLButtonElement>("[data-app-tab]")];
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let active = 0;
    let timer: ReturnType<typeof setTimeout>;

    const show = (index: number) => {
      active = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${active * 100}%)`;
      slides.forEach((slide, i) => { slide.inert = i !== active; slide.setAttribute("aria-hidden", String(i !== active)); });
      tabs.forEach((tab, i) => tab.setAttribute("aria-pressed", String(i === active)));
    };
    const start = () => {
      clearTimeout(timer);
      if (!reducedMotion && !document.hidden) timer = setTimeout(() => { show(active + 1); start(); }, 5200);
    };
    tabs.forEach((tab, i) => tab.addEventListener("click", () => { show(i); start(); }));
    carousel.addEventListener("mouseenter", () => clearTimeout(timer));
    carousel.addEventListener("mouseleave", start);
    carousel.addEventListener("focusin", () => clearTimeout(timer));
    carousel.addEventListener("focusout", (event) => { if (!carousel.contains(event.relatedTarget as Node)) start(); });
    document.addEventListener("visibilitychange", start);
    const linkedSlide = slides.findIndex((slide) => `#${slide.id}` === location.hash);
    show(linkedSlide < 0 ? 0 : linkedSlide);
    addEventListener("hashchange", () => { const index = slides.findIndex((slide) => `#${slide.id}` === location.hash); if (index >= 0) { show(index); start(); } });
    start();
  }

  document.getElementById("algomart-notify")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    form.querySelector("[data-msg]")?.classList.remove("hidden");
    form.reset();
  });
</script>
