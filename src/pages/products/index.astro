---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/content/Eyebrow.astro";
import { getCollection } from "astro:content";
import listing from "../../data/productsListing.json";

type Feature = { icon: string; label: string; desc: string };
type Listing = {
  id: string; name: string; status: string; live: boolean; tagline: string; body: string;
  glyph?: string; logo?: string; bgFrom: string; bgTo: string; accent: string; logoBg: string;
  features?: Feature[]; modes?: { icon: string; title: string; desc: string }[];
  safety?: { icon: string; label: string }[]; cta?: { href: string; label: string };
  readMore?: string; comingSoon?: boolean;
};
const entries = await getCollection("products");
const primary = (listing.products as Listing[]).map((p) => {
  const entry = entries.find((item) => item.id === p.id);
  return entry ? { ...p, body: entry.data.subtitle, glyph: entry.data.glyph, accent: entry.data.accent, readMore: `/products/${entry.id}` } : p;
});
const products = [...primary, ...listing.moreProducts] as Listing[];
const nodes = [
  { id: "planning", title: "Planning", date: "Jan 2024", status: "live", statusLabel: "Complete", body: "Project planning and requirements gathering phase.", icon: "calendar", energy: 100, relatedIds: ["design"] },
  { id: "design", title: "Design", date: "Feb 2024", status: "live", statusLabel: "Complete", body: "UI/UX design and system architecture.", icon: "file-text", energy: 90, relatedIds: ["planning", "development"] },
  { id: "development", title: "Development", date: "Mar 2024", status: "practice", statusLabel: "In Progress", body: "Core features implementation and testing.", icon: "code", energy: 60, relatedIds: ["design", "testing"] },
  { id: "testing", title: "Testing", date: "Apr 2024", status: "soon", statusLabel: "Pending", body: "User testing and bug fixes.", icon: "user", energy: 30, relatedIds: ["development", "release"] },
  { id: "release", title: "Release", date: "May 2024", status: "soon", statusLabel: "Pending", body: "Final deployment and release.", icon: "clock", energy: 10, relatedIds: ["testing"] },
];
---

<BaseLayout title="Products — Algorims" description="Explore Algorims products — AI-powered platforms that turn enterprise data into autonomous, measurable outcomes.">
  <nav class="pp-rail" aria-label="Product navigation" id="pp-rail">
    {primary.map((p) => <a href={`#${p.id}`} data-pp-rail-target={p.id} aria-label={p.name}>
      <span class="grid place-items-center" style={`color:${p.accent}`}><i data-lucide={p.glyph} class="!w-[22px] !h-[22px]"></i></span>
      <span class="pp-rail-label">{p.name}</span>
    </a>)}
  </nav>

  <section class="py-10 pb-6">
    <div class="container-x">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="space-y-6 lg:col-span-6">
          <Eyebrow text="Our Products" />
          <h1 class="text-5xl font-semibold leading-[1.05] tracking-tight md:text-6xl">Built by Algorims, <span class="text-gradient">used in the wild</span>.</h1>
          <p class="text-lg leading-relaxed text-muted-foreground">Beyond consulting, we ship our own products — from an AWS-native operations automation platform for businesses to practical apps for farmers, travellers, and small businesses. Some are live today; one's almost ready.</p>
          <div class="flex flex-wrap gap-3 pt-2">
            {primary.map((p) => <a href={`#${p.id}`} class="group inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-sm">
              <span class="grid h-5 w-5 place-items-center" style={`color:${p.accent}`}><i data-lucide={p.glyph} class="!w-4 !h-4"></i></span>
              {p.name}<span class="inline-flex h-1.5 w-1.5 rounded-full bg-green-500"></span>
            </a>)}
          </div>
        </div>
        <div class="lg:col-span-6">
          <div class="rot-stage" data-rot-stage aria-label="Algorims orbital timeline">
            <img class="rot-center-icon" src="/assets/algorims-icon-transparent.png" alt="Algorims" />
            {nodes.map((n) => <div class="rot-node" data-rot-node={n.id} data-related-ids={n.relatedIds.join(",")} role="button" tabindex="0" aria-label={n.title} aria-expanded="false">
              <div class="rot-node-halo"></div>
              <div class="rot-node-chip"><i data-lucide={n.icon}></i></div>
              <div class="rot-node-label">{n.title}</div>
              <div class="rot-card" role="dialog" aria-label={`${n.title} details`} aria-hidden="true" inert>
                <div class="rot-card-head"><span class="rot-card-badge" data-status={n.status}>{n.statusLabel}</span><span class="rot-card-date">{n.date}</span></div>
                <h4>{n.title}</h4><p>{n.body}</p>
                <div class="rot-card-meter-row"><span class="rot-meter-label"><i data-lucide="zap"></i>Energy</span><span style="font-family:ui-monospace,monospace;">{n.energy}%</span></div>
                <div class="rot-card-meter"><span style={`width:${n.energy}%`}></span></div>
                <div class="rot-card-related"><h5><i data-lucide="link"></i>Connected</h5><div class="rot-card-related-list">
                  {n.relatedIds.map((id) => <button data-rot-jump={id} type="button">{nodes.find((node) => node.id === id)?.title}<i data-lucide="arrow-right"></i></button>)}
                </div></div>
              </div>
            </div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-8 lg:py-12">
    <div class="container-x space-y-8 lg:space-y-10">
      {products.map((p, idx) => <article id={p.id} data-reverse={idx % 2 === 1 ? "true" : "false"} data-more={idx >= primary.length ? "true" : undefined} class:list={["pp-card group relative overflow-hidden rounded-[2rem] border border-border bg-card shadow-sm transition-all hover:border-primary/30 hover:shadow-lg", { hidden: idx >= primary.length }]}>
        <div class="pp-halo pointer-events-none absolute inset-0 -z-0 opacity-90" style={`background:radial-gradient(circle at ${idx % 2 ? "85%" : "15%"} 30%,${p.bgFrom},transparent 55%),radial-gradient(circle at ${idx % 2 ? "15%" : "85%"} 80%,${p.bgTo},transparent 60%)`}></div>
        <div class="relative grid gap-10 p-8 md:p-12 lg:grid-cols-12 lg:items-center lg:gap-14">
          <div class:list={["pp-media product-media relative lg:col-span-5", { "lg:order-2": idx % 2 === 1 }]}>
            <div class="relative mx-auto aspect-square w-full max-w-[360px]">
              <div class="absolute inset-0 rounded-[2rem]" style={`background:${p.logoBg};border:1px solid hsl(0 0% 100% / 0.6);box-shadow:0 30px 80px -30px ${p.accent}40,inset 0 1px 0 hsl(0 0% 100% / 0.8)`}></div>
              <div class="absolute inset-2 rounded-[2rem] opacity-60" style={`border:1px dashed ${p.accent}33`}></div>
              <div class="absolute inset-0 grid place-items-center p-10">
                {p.logo ? <img src={p.logo} alt={`${p.name} logo`} class="pp-logo h-full w-full object-contain transition-transform duration-500 group-hover:scale-105" /> : <div class="pp-logo grid h-full w-full place-items-center transition-transform duration-500 group-hover:scale-105" style={`color:${p.accent}`}><i data-lucide={p.glyph} class="!w-28 !h-28"></i></div>}
              </div>
              {p.comingSoon && <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full border border-amber-500/30 bg-white px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-amber-700 shadow-sm">In development</span>}
            </div>
          </div>
          <div class="lg:col-span-7 space-y-6">
            <div class="pp-fade flex flex-wrap items-center gap-3" style="--pp-delay:.05s">
              <span class:list={["inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold", p.live ? "border-green-500/30 bg-green-500/10 text-green-700" : "border-amber-500/30 bg-amber-500/10 text-amber-700"]}><span class:list={["h-1.5 w-1.5 rounded-full", p.live ? "bg-green-500" : "bg-amber-500"]}></span>{p.status}</span>
              <span class="pp-eyebrow text-muted-foreground">Algorims product</span>
            </div>
            <div class="pp-fade space-y-3" style="--pp-delay:.15s"><h2 class="text-4xl font-semibold tracking-tight md:text-5xl">{p.name}</h2><p class="text-xl font-medium" style={`color:${p.accent}`}>{p.tagline}</p></div>
            <p class="pp-fade max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg" style="--pp-delay:.25s">{p.body}</p>
            {p.features && <div class="grid gap-3 sm:grid-cols-3 pt-2">{p.features.map((f, i) => <div class="pp-fade rounded-2xl border border-border bg-background/80 p-4 backdrop-blur transition-all hover:-translate-y-1 hover:border-primary/30 hover:shadow-md" style={`--pp-delay:${0.35 + i * 0.1}s`}><div class="grid h-9 w-9 place-items-center rounded-xl" style={`background:${p.accent}1a;color:${p.accent}`}><i data-lucide={f.icon} class="!w-4 !h-4"></i></div><p class="mt-3 text-sm font-semibold">{f.label}</p><p class="mt-1 text-xs leading-relaxed text-muted-foreground">{f.desc}</p></div>)}</div>}
            {p.modes && <><div class="grid gap-4 sm:grid-cols-2 pt-2">{p.modes.map((m, i) => <div class="pp-fade rounded-2xl border border-border bg-background/80 p-5 backdrop-blur transition-all hover:-translate-y-1 hover:border-primary/30 hover:shadow-md" style={`--pp-delay:${0.35 + i * 0.12}s`}><div class="flex items-center gap-3"><div class="grid h-10 w-10 place-items-center rounded-xl" style={`background:${p.accent}1a;color:${p.accent}`}><i data-lucide={m.icon} class="!w-5 !h-5"></i></div><p class="text-base font-semibold">{m.title}</p></div><p class="mt-3 text-sm leading-relaxed text-muted-foreground">{m.desc}</p></div>)}</div><div class="pp-fade pt-2" style="--pp-delay:.65s"><p class="pp-eyebrow text-muted-foreground">Built-in safety</p><div class="mt-3 flex flex-wrap gap-2">{p.safety?.map((s) => <span class="inline-flex items-center gap-2 rounded-full border border-border bg-background/80 px-3 py-1.5 text-xs font-medium"><i data-lucide={s.icon} class="!w-3.5 !h-3.5" style={`color:${p.accent}`}></i>{s.label}</span>)}</div></div></>}
            <div class="pp-fade flex flex-wrap items-center gap-3 pt-3" style="--pp-delay:.55s">
              {p.cta && <a href={p.cta.href} class="btn btn-hero btn-lg">{p.cta.label}<i data-lucide="arrow-up-right"></i></a>}
              {p.readMore && <a href={p.readMore} class="btn btn-hero btn-lg">Read more <i data-lucide="arrow-right"></i></a>}
              {p.comingSoon && <form id="algomart-notify" class="flex w-full max-w-md flex-wrap items-center gap-2 sm:w-auto sm:flex-nowrap"><input type="email" required aria-label="Email for Algomart updates" placeholder="you@company.com" class="field flex-1" maxlength="120" /><button class="btn btn-hero btn-default whitespace-nowrap">Notify me <i data-lucide="arrow-right"></i></button><span data-msg class="hidden text-xs font-medium text-green-700">Thanks — we'll be in touch.</span></form>}
            </div>
          </div>
        </div>
      </article>)}
      <div id="pp-more-trigger" class="flex justify-center pt-4"><button type="button" class="btn btn-outline btn-lg">Load more products <i data-lucide="chevron-down"></i></button></div>
    </div>
  </section>
  <section class="py-10 lg:py-14">
    <div class="container-x">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-dark p-10 text-white shadow-lg md:p-16">
        <div class="absolute inset-0 surface-mesh opacity-60"></div>
        <div class="absolute -right-20 -top-20 h-80 w-80 rounded-full blur-3xl" style="background:hsl(var(--primary-glow) / .3)"></div>
        <div class="absolute -bottom-20 -left-20 h-80 w-80 rounded-full blur-3xl" style="background:hsl(var(--primary) / .4)"></div>
        <div class="relative grid gap-10 md:grid-cols-5 md:items-center">
          <div class="md:col-span-3 space-y-5"><div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs"><span class="h-1.5 w-1.5 rounded-full" style="background:hsl(var(--primary-glow))"></span>Ready when you are</div><h2 class="text-balance text-4xl font-semibold leading-tight md:text-5xl">Let's architect your <span class="bg-clip-text text-transparent" style="background-image:linear-gradient(to right, hsl(var(--primary-glow)), white)">Agentic Enterprise</span>.</h2><p class="max-w-xl text-base leading-relaxed text-white/75">Talk to our team about your AI, cloud, or platform engineering goals. We'll design a plan that scales with your business.</p></div>
          <div class="md:col-span-2 flex flex-col gap-3 md:items-end"><a href="/contact" class="btn btn-xl" style="background:white;color:hsl(var(--primary-deep))">Book a consultation <i data-lucide="arrow-right"></i></a><a href="/services" class="btn btn-ghost btn-lg rounded-full" style="color:white">Explore services</a></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>(".pp-card")];
  const rail = [...document.querySelectorAll<HTMLAnchorElement>("[data-pp-rail-target]")];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const reveal = new IntersectionObserver((entries) => {
    for (const entry of entries) if (entry.isIntersecting) {
      entry.target.classList.add("is-visible");
      reveal.unobserve(entry.target);
    }
  }, { threshold: 0.18, rootMargin: "0px 0px -60px 0px" });
  cards.forEach((card) => reveal.observe(card));

  const current = new IntersectionObserver((entries) => {
    for (const entry of entries) if (entry.isIntersecting) {
      rail.forEach((link) => link.setAttribute("aria-current", String(link.dataset.ppRailTarget === entry.target.id)));
    }
  }, { rootMargin: "-40% 0px -45% 0px" });
  cards.slice(0, rail.length).forEach((card) => current.observe(card));
  rail.forEach((link) => link.addEventListener("click", (event) => {
    const target = document.getElementById(link.dataset.ppRailTarget || "");
    if (!target) return;
    event.preventDefault();
    scrollTo({ top: target.getBoundingClientRect().top + scrollY - 96, behavior: reduce ? "instant" : "smooth" });
  }));

  document.querySelector("#pp-more-trigger button")?.addEventListener("click", () => {
    document.querySelectorAll<HTMLElement>("[data-more]").forEach((card) => card.classList.remove("hidden"));
    document.getElementById("pp-more-trigger")?.remove();
  });
  document.getElementById("algomart-notify")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    form.querySelector("[data-msg]")?.classList.remove("hidden");
    form.reset();
  });

  const stage = document.querySelector<HTMLElement>("[data-rot-stage]");
  if (stage) {
    const nodes = [...stage.querySelectorAll<HTMLElement>("[data-rot-node]")];
    const radius = () => stage.clientWidth < 480 ? 150 : stage.clientWidth < 768 ? 195 : stage.clientWidth < 1100 ? 220 : 260;
    let rotation = -90;
    let active = "";
    const place = () => nodes.forEach((node, i) => {
      const rad = ((i / nodes.length * 360 + rotation) % 360) * Math.PI / 180;
      node.style.setProperty("--x", `${(Math.cos(rad) * radius()).toFixed(2)}px`);
      node.style.setProperty("--y", `${(Math.sin(rad) * radius()).toFixed(2)}px`);
      node.style.setProperty("--z", String(Math.round(100 + 50 * Math.cos(rad))));
      node.style.setProperty("--op", String(Math.max(.55, Math.min(1, .55 + .45 * (1 + Math.sin(rad)) / 2))));
    });
    const activate = (id: string) => {
      active = active === id ? "" : id;
      const selected = nodes.find((node) => node.dataset.rotNode === active);
      if (selected) stage.dataset.paused = "true";
      else delete stage.dataset.paused;
      const related = selected?.dataset.relatedIds?.split(",") || [];
      nodes.forEach((node) => {
        if (node === selected) node.dataset.active = "true";
        else delete node.dataset.active;
        if (related.includes(node.dataset.rotNode || "")) node.dataset.related = "true";
        else delete node.dataset.related;
        node.setAttribute("aria-expanded", String(node === selected));
        const card = node.querySelector<HTMLElement>(".rot-card");
        card?.toggleAttribute("inert", node !== selected);
        card?.setAttribute("aria-hidden", String(node !== selected));
      });
      if (selected) rotation = -90 - nodes.indexOf(selected) / nodes.length * 360;
      place();
    };
    nodes.forEach((node) => {
      node.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const jump = target.closest<HTMLElement>("[data-rot-jump]");
        if (jump) { event.stopPropagation(); activate(jump.dataset.rotJump || ""); return; }
        if (target.closest(".rot-card")) return;
        event.stopPropagation();
        activate(node.dataset.rotNode || "");
      });
      node.addEventListener("keydown", (event) => {
        if (event.target !== node) return;
        if (event.key === "Enter" || event.key === " ") { event.preventDefault(); activate(node.dataset.rotNode || ""); }
      });
    });
    stage.addEventListener("click", () => { if (active) activate(active); });
    stage.addEventListener("keydown", (event) => { if (event.key === "Escape" && active) activate(active); });
    addEventListener("resize", place);
    const tick = () => {
      if (!active && !reduce) { rotation = (rotation + .16) % 360; place(); }
      requestAnimationFrame(tick);
    };
    place();
    if (!reduce) requestAnimationFrame(tick);
  }
</script>
