---
import ScrollShowcase from "../components/ScrollShowcase.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const practices = [
  {
    id: "cloud",
    name: "Cloud Engineering",
    icon: "cloud",
    description: "Your cloud should work harder. We build AWS-native foundations that eliminate waste, maximise performance, and turn infrastructure into a strategic business asset.",
    services: ["AWS landing zones & foundations", "Cloud migration & modernisation", "Well-Architected reviews", "FinOps & cost optimisation"],
    href: "/case-studies",
    linkText: "View cloud engineering case studies",
    image: "service-cloud-engineering.webp",
    darkImage: "service-cloud-engineering-3d-dark.webp",
    alt: "Cloud engineering illustration",
  },
  {
    id: "devops",
    name: "DevOps & Platform",
    icon: "git-branch",
    description: "Ship faster. Break nothing. We engineer CI/CD pipelines, developer platforms, and SRE practices where speed, reliability, and security move together — always.",
    services: ["Internal developer platforms", "CI/CD pipelines & GitOps", "SRE & incident response", "Observability & SLOs"],
    href: "/case-studies",
    linkText: "View DevOps case studies",
    image: "service-devops-platform.webp",
    darkImage: "service-devops-platform-3d-dark.webp",
    alt: "DevOps and platform engineering illustration",
  },
  {
    id: "dev",
    name: "Development",
    icon: "code-2",
    description: "Not just code. AI-ready applications engineered by senior developers — built to perform, scale, and integrate intelligently from day one.",
    services: ["Web platforms & dashboards", "Cross-platform mobile apps (iOS & Android)", "APIs & system integrations", "AI-native product features"],
    href: "/case-studies",
    linkText: "View development case studies",
    image: "service-development.webp",
    darkImage: "service-development-3d-dark.webp",
    alt: "Application development illustration",
  },
  {
    id: "xero",
    name: "Xero Solutions",
    icon: "calculator",
    description: "Xero is a cloud-based accounting platform that brings your essential financial processes together in one place. From invoicing and expenses to bank reconciliation, GST and reporting, Xero helps businesses reduce manual work and manage their finances more efficiently.",
    services: ["Invoicing", "Bank Reconciliation", "Bills & Expenses", "Reports & Insights"],
    href: "/contact",
    linkText: "Contact Us",
    image: "service-xero-light.webp",
    darkImage: "service-xero-dark.webp",
    alt: "Xero financial workflows illustration",
  },
];
---

<BaseLayout title="Services — Algorims" description="AI & Generative AI, Data & Analytics, AWS cloud engineering, DevOps, application development and managed services from Algorims.">
<section class="services-hero" aria-labelledby="services-title">
  <div class="container-x">
    <p class="services-kicker text-primary">Our Services</p>
    <h1 id="services-title" class="services-title text-balance">From Cloud Foundations to <span class="services-emphasis">Autonomous Intelligence</span></h1>
    <p class="services-intro text-muted-foreground">Four practices. One focus: production-grade systems that drive measurable business value.</p>
    <div class="services-actions">
      <a class="btn btn-hero btn-lg" href="/contact">Let's build together</a>
      <a class="btn btn-outline btn-lg" href="/case-studies">View case studies</a>
    </div>
    <dl class="services-stats">
      <div><dt data-counter>20+</dt><dd>Projects Delivered</dd></div>
      <div><dt data-counter>99.9%</dt><dd>System Uptime</dd></div>
      <div><dt data-counter>7+</dt><dd>Industries Served</dd></div>
      <div><dt data-counter>24/7</dt><dd>Support Coverage</dd></div>
    </dl>
  </div>
</section>

  <ScrollShowcase items={practices} label="Service practices" noun="practice">
    {practices.map((practice, index) => (
      <section id={practice.id} class="showcase-panel" aria-labelledby={`${practice.id}-title`}>
        <div class="practice-grid">
          <div class="space-y-4" data-showcase-copy>
            <p class="services-kicker text-primary">Practice 0{index + 1}</p>
            <div class="flex flex-wrap items-center gap-3">
              <i data-lucide={practice.icon} class="text-primary" aria-hidden="true"></i>
              <h2 id={`${practice.id}-title`} class="services-section-title" tabindex="-1">{practice.name}</h2>
              {practice.id === "xero" && <img src="/assets/partners/xero-blue-partner-badge.svg" alt="Xero Solutions partner badge" class="h-11 w-auto" />}
            </div>
            <p class="services-description text-muted-foreground">{practice.description}</p>
            <ul class="grid gap-3 sm:grid-cols-2">
              {practice.services.map((service) => (
                <li class="services-list-item flex items-start gap-2">
                  <i data-lucide="check" class="mt-1 !w-4 !h-4 shrink-0 text-primary" aria-hidden="true"></i>
                  {service}
                </li>
              ))}
            </ul>
            <a href={practice.href} class="inline-flex items-center gap-2 font-semibold text-primary">
              {practice.linkText} <i data-lucide="arrow-right" class="!w-4 !h-4" aria-hidden="true"></i>
            </a>
          </div>
          <figure class="services-figure" data-showcase-art>
            <img src={`/assets/illustrations/${practice.image}`} alt={practice.alt} width="724" height="724" loading="lazy" />
            <img class="services-figure-dark" src={`/assets/illustrations/${practice.darkImage}`} alt={practice.alt} width="1254" height="1254" loading="lazy" />
          </figure>
        </div>
      </section>
    ))}
  </ScrollShowcase>
</BaseLayout>
<style>
  .services-hero { padding: 46px 0 24px; text-align: center; }
  .services-hero .services-title { max-width: 1050px; margin: 0 auto; }
  .services-hero .services-intro { max-width: 720px; margin: 24px auto 0; text-wrap: balance; }
  .services-actions { display: flex; justify-content: center; gap: 14px; margin: 26px 0 0; }
  .services-stats { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 960px; margin: 42px auto 0; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; }
  .services-stats div { padding: 20px 12px; }
  .services-stats div + div { border-left: 1px solid hsl(var(--border)); }
  .services-stats dt { color: hsl(var(--foreground)); font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .services-stats dd { margin-top: 6px; color: hsl(var(--muted-foreground)); font-size: .85rem; }
  .practice-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: start; gap: clamp(20px, 3vw, 40px); }
  .services-figure { margin: 0; padding: clamp(8px, 1.5vw, 20px); overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1.5rem; background: hsl(var(--background)); }
  .services-figure img { display: block; width: 100%; height: auto; }
  .services-figure-dark { display: none !important; }
  :global(:root.dark) .services-figure > img:not(.services-figure-dark) { display: none; }
  :global(:root.dark) .services-figure > .services-figure-dark { display: block !important; }
  .services-kicker { font-size: .72rem; font-weight: 700; letter-spacing: .18em; line-height: 1.4; text-transform: uppercase; }
  .services-title { font-size: clamp(2.7rem, 5.2vw, 4.8rem); font-weight: 600; line-height: 1; letter-spacing: -.06em; }
  .services-emphasis { color: hsl(var(--primary)); }
  .services-intro, .services-description { font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.65; }
  .services-section-title { font-size: clamp(1.7rem, 3vw, 2.6rem); font-weight: 600; line-height: 1.06; letter-spacing: -.05em; }
  .services-list-item { font-size: 1rem; line-height: 1.6; }
  @media (max-width: 700px) {
    .practice-grid { grid-template-columns: minmax(0, 1fr); }
    .services-figure { width: min(100%, 280px); justify-self: center; }
  }
  @media (max-width: 600px) {
    .services-hero { padding-top: 44px; }
    .services-title { font-size: 2.4rem; }
    .services-actions { flex-direction: column; }
    .services-stats { grid-template-columns: repeat(2, 1fr); margin-top: 32px; }
    .services-stats div:nth-child(3) { border-left: 0; }
    .services-stats div:nth-child(n + 3) { border-top: 1px solid hsl(var(--border)); }
  }
</style>
