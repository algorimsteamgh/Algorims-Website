---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Services — Algorims" description="AI & Generative AI, Data & Analytics, AWS cloud engineering, DevOps, application development and managed services from Algorims.">
<section class="services-hero" aria-labelledby="services-title">
  <div class="container-x">
    <p class="services-kicker text-primary">Our Services</p>
    <h1 id="services-title" class="services-title text-balance">From Cloud Foundations to <span class="services-emphasis">Autonomous Intelligence</span></h1>
    <p class="services-intro text-muted-foreground">Four practices. One focus: production-grade systems that drive measurable business value.</p>
    <div class="services-actions">
      <a class="services-action services-action-primary" href="/contact">Let's build together</a>
      <a class="services-action" href="/case-studies">View case studies</a>
    </div>
    <dl class="services-stats">
      <div><dt data-counter>40+</dt><dd>Projects Delivered</dd></div>
      <div><dt data-counter>99.9%</dt><dd>System Uptime</dd></div>
      <div><dt data-counter>7+</dt><dd>Industries Served</dd></div>
      <div><dt data-counter>24/7</dt><dd>Support Coverage</dd></div>
    </dl>
  </div>
</section>

    <section id="cloud" class="py-10 lg:py-14 ">
      <div class="container-x">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="space-y-6 lg:col-span-8">
            <p class="services-kicker text-primary">Practice 01</p>
            <div class="flex flex-wrap items-center gap-4">
              <div class="grid h-12 w-12 place-items-center rounded-2xl bg-primary/10 text-primary"><i data-lucide="cloud" class="!w-6 !h-6"></i></div>
              <h2 class="services-section-title">Cloud Engineering</h2>

            </div>
            <div class="services-description max-w-2xl space-y-4 text-muted-foreground">
              <p>Your cloud should work harder. We build AWS-native foundations that eliminate waste, maximise performance, and turn infrastructure into a strategic business asset.</p>
            </div>

            <ul class="grid gap-x-8 gap-y-3 pt-2 sm:grid-cols-2">

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>AWS landing zones & foundations</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Cloud migration & modernisation</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Well-Architected reviews</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>FinOps & cost optimisation</span>
                </li>

            </ul>


            <div class="pt-1">
              <a href="/case-studies" class="inline-flex items-center gap-2 text-base font-semibold text-primary transition-all hover:gap-3">
                View cloud engineering case studies <i data-lucide="arrow-right" class="!w-4 !h-4"></i>
              </a>
            </div>
          </div>

          <aside class="services-figure-wrap lg:col-span-4">
            <figure class="services-figure">


              <figcaption class="services-flow"><span>Inputs<br /><b>Data & workloads</b></span><span>Core<br /><b>Cloud engineering</b></span><span>Outcome<br /><b>Resilient infrastructure</b></span></figcaption>
            </figure>
          </aside>
        </div>
      </div>
    </section>

    <section id="devops" class="py-10 lg:py-14 bg-secondary/40">
      <div class="container-x">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="space-y-6 lg:col-span-8">
            <p class="services-kicker text-primary">Practice 02</p>
            <div class="flex flex-wrap items-center gap-4">
              <div class="grid h-12 w-12 place-items-center rounded-2xl bg-primary/10 text-primary"><i data-lucide="git-branch" class="!w-6 !h-6"></i></div>
              <h2 class="services-section-title">DevOps & Platform</h2>

            </div>
            <div class="services-description max-w-2xl space-y-4 text-muted-foreground">
              <p>Ship faster. Break nothing. We engineer CI/CD pipelines, developer platforms, and SRE practices where speed, reliability, and security move together — always.</p>
            </div>

            <ul class="grid gap-x-8 gap-y-3 pt-2 sm:grid-cols-2">

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Internal developer platforms</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>CI/CD pipelines & GitOps</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>SRE & incident response</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Observability & SLOs</span>
                </li>

            </ul>


            <div class="pt-1">
              <a href="/case-studies" class="inline-flex items-center gap-2 text-base font-semibold text-primary transition-all hover:gap-3">
                View DevOps case studies <i data-lucide="arrow-right" class="!w-4 !h-4"></i>
              </a>
            </div>
          </div>

          <aside class="services-figure-wrap lg:col-span-4">
            <figure class="services-figure">


              <figcaption class="services-flow"><span>Inputs<br /><b>Code changes</b></span><span>Core<br /><b>Automated delivery</b></span><span>Outcome<br /><b>Reliable operations</b></span></figcaption>
            </figure>
          </aside>
        </div>
      </div>
    </section>

    <section id="dev" class="py-10 lg:py-14 ">
      <div class="container-x">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="space-y-6 lg:col-span-8">
            <p class="services-kicker text-primary">Practice 03</p>
            <div class="flex flex-wrap items-center gap-4">
              <div class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-primary text-white shadow-glow"><i data-lucide="code-2" class="!w-6 !h-6"></i></div>
              <h2 class="services-section-title">Development</h2>

            </div>
            <div class="services-description max-w-2xl space-y-4 text-muted-foreground">
              <p>Not just code. AI-ready applications engineered by senior developers — built to perform, scale, and integrate intelligently from day one.</p>
            </div>

            <ul class="grid gap-x-8 gap-y-3 pt-2 sm:grid-cols-2">

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Web platforms & dashboards</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Cross-platform mobile apps (iOS & Android)</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>APIs & system integrations</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>AI-native product features</span>
                </li>

            </ul>


            <div class="pt-1">
              <a href="/case-studies" class="inline-flex items-center gap-2 text-base font-semibold text-primary transition-all hover:gap-3">
                View development case studies <i data-lucide="arrow-right" class="!w-4 !h-4"></i>
              </a>
            </div>
          </div>

          <aside class="services-figure-wrap lg:col-span-4">
            <figure class="services-figure">


              <figcaption class="services-flow"><span>Inputs<br /><b>Requirements & APIs</b></span><span>Core<br /><b>Application engineering</b></span><span>Outcome<br /><b>Production software</b></span></figcaption>
            </figure>
          </aside>
        </div>
      </div>
    </section>

    <section id="xero" class="py-10 lg:py-14 bg-secondary/40">
      <div class="container-x">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="space-y-6 lg:col-span-8">
            <p class="services-kicker text-primary">Practice 04</p>
            <div class="flex flex-wrap items-center gap-4">
              <div class="grid h-12 w-12 place-items-center rounded-2xl bg-primary/10 text-primary"><i data-lucide="calculator" class="!w-6 !h-6"></i></div>
              <h2 class="services-section-title">Xero Solutions</h2>
              <img src="/assets/partners/xero-blue-partner-badge.svg" alt="Xero Solutions partner badge" class="h-11 w-auto md:h-12" />
            </div>
            <div class="services-description max-w-2xl space-y-4 text-muted-foreground">
              <p>Xero is a cloud-based accounting platform that brings your essential financial processes together in one place. From invoicing and expenses to bank reconciliation, GST and reporting, Xero helps businesses reduce manual work and manage their finances more efficiently.</p>
            </div>

            <ul class="grid gap-x-8 gap-y-3 pt-2 sm:grid-cols-2">

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Invoicing</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Bank Reconciliation</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Bills & Expenses</span>
                </li>

                <li class="services-list-item flex items-start gap-3 text-foreground/90">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-primary"><i data-lucide="check" class="!w-4 !h-4"></i></span>
                  <span>Reports & Insights</span>
                </li>

            </ul>


            <div class="pt-1">
              <a href="/contact" class="inline-flex items-center gap-2 text-base font-semibold text-primary transition-all hover:gap-3">
                Contact Us <i data-lucide="arrow-right" class="!w-4 !h-4"></i>
              </a>
            </div>
          </div>

          <aside class="services-figure-wrap lg:col-span-4">
            <figure class="services-figure">


              <figcaption class="services-flow"><span>Inputs<br /><b>Invoices & banking</b></span><span>Core<br /><b>Xero workflows</b></span><span>Outcome<br /><b>Financial visibility</b></span></figcaption>
            </figure>
          </aside>
        </div>
      </div>
    </section>


</BaseLayout>
<style>
  .services-hero { padding: 46px 0 24px; text-align: center; }
  .services-hero .services-title { max-width: 1050px; margin: 0 auto; }
  .services-hero .services-intro { max-width: 720px; margin: 24px auto 0; text-wrap: balance; }
  .services-actions { display: flex; justify-content: center; gap: 14px; margin: 26px 0 0; }
  .services-stats { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 960px; margin: 42px auto 0; border-block: 1px solid hsl(var(--border)); }
  .services-stats div { padding: 20px 12px; }
  .services-stats div + div { border-left: 1px solid hsl(var(--border)); }
  .services-stats dt { color: hsl(var(--foreground)); font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .services-stats dd { margin-top: 6px; color: hsl(var(--muted-foreground)); font-size: .85rem; }
  .services-action { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 25px; border: 1px solid hsl(var(--foreground)); border-radius: 9999px; color: hsl(var(--foreground)); font-weight: 600; }
  .services-action-primary { border-color: hsl(var(--primary)); background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); }
  .services-figure { margin: 0; padding: 28px; border: 1px solid hsl(var(--border)); background: hsl(var(--background)); }
  .services-flow { display: grid; gap: 0; max-width: 360px; margin-inline: auto; }
  .services-flow span { position: relative; display: block; padding: 14px 14px 14px 36px; color: hsl(var(--muted-foreground)); font-size: .68rem; font-weight: 700; letter-spacing: .14em; line-height: 1.4; text-transform: uppercase; }
  .services-flow span::before { position: absolute; top: 19px; left: 8px; width: 9px; height: 9px; border: 1px solid hsl(var(--foreground)); background: hsl(var(--background)); content: ""; }
  .services-flow span + span::after { position: absolute; top: -19px; left: 12px; width: 1px; height: 32px; background: hsl(var(--border)); content: ""; }
  .services-flow span:nth-child(2)::before { border-color: hsl(var(--primary)); background: hsl(var(--primary)); }
  .services-flow b { display: block; margin-top: 3px; color: hsl(var(--foreground)); font-size: clamp(1rem, 1.5vw, 1.2rem); font-weight: 600; letter-spacing: -.025em; text-transform: none; }
  section[id] { border-top: 1px solid hsl(var(--border)); }
  .services-kicker { font-size: .72rem; font-weight: 700; letter-spacing: .18em; line-height: 1.4; text-transform: uppercase; }
  .services-title { font-size: clamp(2.7rem, 5.2vw, 4.8rem); font-weight: 600; line-height: 1; letter-spacing: -.06em; }
  .services-emphasis { color: hsl(var(--primary)); }
  .services-intro, .services-description { font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.65; }
  .services-section-title { font-size: clamp(2.2rem, 3.7vw, 3.7rem); font-weight: 600; line-height: 1.06; letter-spacing: -.05em; }
  .services-list-item { font-size: 1rem; line-height: 1.6; }
  @media (min-width: 1024px) {
    #devops .services-figure-wrap, #xero .services-figure-wrap { order: -1; }
  }
  @media (max-width: 600px) {
    .services-hero { padding-top: 44px; }
    .services-title { font-size: 2.4rem; }
    .services-actions { flex-direction: column; }
    .services-stats { grid-template-columns: repeat(2, 1fr); margin-top: 32px; }
    .services-stats div:nth-child(3) { border-left: 0; }
    .services-stats div:nth-child(n + 3) { border-top: 1px solid hsl(var(--border)); }
  }
</style>
